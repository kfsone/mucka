# EditorConfig for mucka - .NET 10 MAUI / C# 13 project
# https://editorconfig.org
root = true

[*]
charset                  = utf-8
end_of_line              = crlf
indent_style             = space
insert_final_newline     = true
trim_trailing_whitespace = true

[*.cs]
indent_size = 4

# Organise usings
dotnet_sort_system_directives_first                                    = true
dotnet_separate_import_directive_groups                                = false

# var preferences. The codebase uses var throughout; these said the opposite, which is 3312
# IDE0008 the moment anyone raises the severity. The severity suffix is value:severity with no
# spaces - the spaced form this block used is not the documented syntax.
csharp_style_var_for_built_in_types                                    = true:suggestion
csharp_style_var_when_type_is_apparent                                 = true:suggestion
csharp_style_var_elsewhere                                             = true:suggestion

# Expression-bodied members
csharp_style_expression_bodied_methods                                 = when_on_single_line:suggestion
csharp_style_expression_bodied_properties                              = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors                            = false:silent

# Null checks
dotnet_style_null_propagation                                          = true:suggestion
dotnet_style_coalesce_expression                                       = true:suggestion

# Accessibility modifiers
dotnet_style_require_accessibility_modifiers                           = for_non_interface_members:suggestion

# Unused private members. Nine in the solution when this was raised, and the list found five that a
# 111-finding review missed - a field assigned and never read reads exactly like a live one.
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning

# Naming: private fields use _camelCase (already project convention)
dotnet_naming_rule.private_fields_should_be_camel_case.severity       = suggestion
dotnet_naming_rule.private_fields_should_be_camel_case.symbols        = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case.style          = underscore_camel_case_style

dotnet_naming_symbols.private_fields.applicable_kinds                 = field
dotnet_naming_symbols.private_fields.applicable_accessibilities       = private

dotnet_naming_style.underscore_camel_case_style.capitalization        = camel_case
dotnet_naming_style.underscore_camel_case_style.required_prefix       = _

# Test projects. Two rules that are right for shipping code and wrong for a test:
#   CA1707 - xunit names a test Method_Condition_Expected, so every test in the tree trips it.
#   CA1861 - it wants a constant array argument hoisted to a static readonly field, which in an
#            Assert.Equal moves the expected value away from the assertion that reads it. The rule
#            is about arrays rebuilt on a hot path; a test asserts once.
# The glob is `**.cs` and not `**/*.cs`: the latter needs a directory between the two, so it
# silently skips a project's top-level files.
[mudsharp.Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none

[Mucka.Terminal.Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none

[Mucka.Util/Mucka.Util.Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none

[*.{xml,xaml,csproj,props,targets}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

# Captured MUD2 frames. The payload is the server's own bytes - a third of them above 0x7F - so
# every [*] default here would rewrite evidence. trim_trailing_whitespace is the dangerous one: a
# frame ending in 0x20 would lose it on an IDE save, the decode would still succeed and every test
# would stay green. .gitattributes stops git touching these; this stops the editor.
[*.c1]
charset                  = unset
end_of_line              = unset
trim_trailing_whitespace = false
insert_final_newline     = false

[*.md]
trim_trailing_whitespace = false
