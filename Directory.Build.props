<Project>

  <PropertyGroup>
    <!-- Code-style rules only run in the build when this is on; without it the .editorconfig
         severities are an IDE-only suggestion and nothing fails. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The default analysis mode runs a handful of rules. Recommended is what found the
         culture-sensitive parsing of wire data and of mucka.ini. -->
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- The tree is at zero warnings. A warning that only prints is a warning nobody reads, and
         the next one would be lost in a clean build's output within a week. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The compiler only checks a <see cref="..."/> when it is asked to emit the XML file. Without
         this, a cref naming a deleted or renamed member is inert text. Two XML warnings are not
         rules here and are switched off: CS1591 (public member has no doc comment) and CS1573 (a
         member documents some of its parameters and not all). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <!--
    Version is version.json's version (scripts/Get-Version.ps1), or MUCKA_RELEASE_VERSION, the tag,
    in CI: M.m.P for a release, M.m.P-rcN for a release candidate.
    ApplicationVersion, the build number (Android versionCode, iOS and Mac CFBundleVersion), is
    computed from it as M*1000000 + m*10000 + P*100 + N, with 99 for a release, so the last two
    digits say which build it is: 0.24.0-rc4 is 240004 and 0.24.0 is 240099. It rises with every
    tag, as Android needs across versions and App Store Connect needs within one, and a release
    always outranks its candidates.
  -->
  <!-- _GetAndroidPackageName is where the .NET Android SDK snapshots $(ApplicationDisplayVersion)
       into _AndroidVersionName (-> manifest versionName -> AppInfo.VersionString), so the version
       must be computed before it. NOTE: names in BeforeTargets that don't exist in a given TFM
       are silently ignored - guessing wrong fails without a warning. -->
  <Target Name="ComputeCustomVersion" BeforeTargets="GetAssemblyVersion;GetAssemblyAttributes;GenerateAssemblyInfo;PrepareForBuild;MauiGeneratePackageAppxManifest;_GetAndroidPackageName">
    <PropertyGroup>
      <_VersionScript>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)scripts/Get-Version.ps1'))</_VersionScript>
    </PropertyGroup>
    <!-- In CI release builds, MUCKA_RELEASE_VERSION is set to the tag version (e.g. 0.2.0).
         Skip the script so the build uses the tag version directly. -->
    <Exec Condition="'$(MUCKA_RELEASE_VERSION)' == ''"
          Command="pwsh -NoProfile -File &quot;$(_VersionScript)&quot;"
          ConsoleToMSBuild="true"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ComputedVersion" />
    </Exec>
    <PropertyGroup>
      <_ComputedVersion Condition="'$(MUCKA_RELEASE_VERSION)' != ''">$(MUCKA_RELEASE_VERSION)</_ComputedVersion>
      <Version>$(_ComputedVersion.Trim())</Version>
      <PackageVersion>$(Version)</PackageVersion>
      <!-- MAUI Resizetizer requires ApplicationDisplayVersion to be a plain M.m.P number
           (no pre-release suffix). Strip the pre-release for display; the full semver
           is still in $(Version) / $(PackageVersion). -->
      <ApplicationDisplayVersion>$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^\d+\.\d+\.\d+').Value)</ApplicationDisplayVersion>
      <_VerMajor>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '^(\d+)\.(\d+)\.(\d+).*$', '$1'))</_VerMajor>
      <_VerMinor>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '^(\d+)\.(\d+)\.(\d+).*$', '$2'))</_VerMinor>
      <_VerPatch>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '^(\d+)\.(\d+)\.(\d+).*$', '$3'))</_VerPatch>
      <_VerRc>99</_VerRc>
      <_VerRc Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '^\d+\.\d+\.\d+-rc\d+$'))">$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '^\d+\.\d+\.\d+-rc(\d+)$', '$1'))</_VerRc>
    </PropertyGroup>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '^\d+\.\d+\.\d+(-rc\d+)?$'))"
           Text="[mucka] Version '$(Version)' is neither M.m.P nor M.m.P-rcN, so it has no build number." />
    <Error Condition="$(_VerMinor) &gt; 99 or $(_VerPatch) &gt; 99 or $(_VerRc) &lt; 1 or $(_VerRc) &gt; 99"
           Text="[mucka] Version '$(Version)' does not fit the build number: minor and patch go to 99, a candidate from rc1 to rc98." />
    <PropertyGroup>
      <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($(_VerMajor), 1000000)), $([MSBuild]::Multiply($(_VerMinor), 10000)))), $([MSBuild]::Add($([MSBuild]::Multiply($(_VerPatch), 100)), $(_VerRc)))))</ApplicationVersion>
    </PropertyGroup>
    <Message Text="[mucka] Version: $(Version), build $(ApplicationVersion)" Importance="high" />
    <!-- MauiGeneratePackageAppxManifest is incremental on file timestamps only - it cannot
         see $(Version) change, so its obj output goes stale on version bumps. That manifest
         is what the AppInfo assembly metadata (and thus AppInfo.VersionString - the Windows
         title bar / About version) derives from. Stamp the version into obj and delete the
         stale manifest whenever it changes so the whole chain regenerates. -->
    <PropertyGroup>
      <_MuckaVersionStamp>$(IntermediateOutputPath)mucka.version.stamp</_MuckaVersionStamp>
      <_MuckaGeneratedManifest>$(IntermediateOutputPath)resizetizer\m\Package.appxmanifest</_MuckaGeneratedManifest>
      <!-- Android equivalent: the merged manifest carries versionName and is also
           timestamp-incremental, so it too goes stale on version bumps. -->
      <_MuckaGeneratedAndroidManifest>$(IntermediateOutputPath)android\AndroidManifest.xml</_MuckaGeneratedAndroidManifest>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_MuckaVersionStamp)" Condition="Exists('$(_MuckaVersionStamp)')">
      <Output TaskParameter="Lines" PropertyName="_MuckaPrevVersion" />
    </ReadLinesFromFile>
    <Delete Files="$(_MuckaGeneratedManifest)"
            Condition="'$(_MuckaPrevVersion)' != '$(Version)' and Exists('$(_MuckaGeneratedManifest)')" />
    <Delete Files="$(_MuckaGeneratedAndroidManifest)"
            Condition="'$(_MuckaPrevVersion)' != '$(Version)' and Exists('$(_MuckaGeneratedAndroidManifest)')" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_MuckaVersionStamp)" Lines="$(Version)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
