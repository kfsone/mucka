<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one database: ~/.mucka/mucka.db. Holds the schema for every table the client writes
       (combat, wire log, encounter logs), the single background writer that owns the only write
       connection, and the row seam the producers hand work over on. No MAUI and no game model, so
       a command-line tool can open the store with this alone; the platform directory lookup stays
       in the app (Core/MuckaPaths.cs). See docs/persistence-design.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mucka.Store</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Mucka.Util.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
