<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one database: ~/.mucka/mucka.db. Holds the schema for every table the client writes
       (combat, wire log, encounter logs), the single background writer that owns the only write
       connection, and the row seam the producers hand work over on. No MAUI and no game model, so
       a command-line tool can open the store with this alone; the platform directory lookup stays
       in the app (Core/MuckaPaths.cs). See docs/persistence-design.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mucka.Store</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Schema migrations. Scripts are registered EXPLICITLY as const strings, never through
         ScriptsEmbeddedInAssembly: that calls Assembly.GetManifestResourceNames(), and the app
         publishes Android with PublishTrimmed=true, where a discovery step that silently returns
         zero scripts leaves a stranger's database un-migrated with nothing thrown. -->
    <PackageReference Include="dbup-core" Version="6.0.15" />
    <PackageReference Include="dbup-sqlite" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loaded by exact resource name, never by enumeration - see MigrationScripts.Load. -->
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Mucka.Util.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
