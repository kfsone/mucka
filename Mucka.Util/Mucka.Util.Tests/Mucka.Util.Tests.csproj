    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mucka.Store\Mucka.Store.csproj" />
    <ProjectReference Include="..\Mucka.WireLog\Mucka.WireLog.csproj" />
    <ProjectReference Include="..\Mucka.Combat\Mucka.Combat.csproj" />
    <ProjectReference Include="..\Mucka.Commands\Mucka.Commands.csproj" />
    <ProjectReference Include="..\Mucka.Sounds\Mucka.Sounds.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The poisoned-wyvern death recording, shared with mudsharp.Tests (which replays its protocol
         facts); WireLogTests pushes the same records through framing and the sqlite sink. -->
