<Project Sdk="Microsoft.NET.Sdk">

  <!-- The wire log: framing, the sqlite and jsonl sinks, the wire database, the decoder/exporter
       and session capture. No MAUI and no game model, so a command-line tool can read a recording
       with this alone. The platform directory lookup stays in the app (Core/ClogPaths.cs). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mucka.WireLog</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Mucka.Util.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
