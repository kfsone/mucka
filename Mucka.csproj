<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Each runner builds only its own target:
		     Windows runner  -> net10.0-windows
		     Linux runner    -> net10.0-android
		     macOS runner    -> net10.0-maccatalyst  -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-maccatalyst</TargetFrameworks>
		<!-- Local iOS build from a Mac (opt-in so plain builds and CI don't require the ios workload):
		       dotnet build -f net10.0-ios -p:LocalIos=true                      (simulator .app) -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) and '$(LocalIos)' == 'true'">net10.0-maccatalyst;net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows')) and !$([MSBuild]::IsOSPlatform('osx'))">net10.0-android</TargetFrameworks>
		<!-- Local Android build/deploy from a Windows or Mac dev box (opt-in so plain builds and CI
		     don't require the android workload):
		       dotnet build -f net10.0-android -p:LocalAndroid=true -t:Run   (deploys to adb device) -->
		<TargetFrameworks Condition="'$(LocalAndroid)' == 'true' and ($([MSBuild]::IsOSPlatform('windows')) or $([MSBuild]::IsOSPlatform('osx')))">$(TargetFrameworks);net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Mucka</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Mucka</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>org.kfs.mucka</ApplicationId>

		<!-- Versions - ApplicationDisplayVersion is set from $(Version) via Directory.Build.props
		     (ComputeCustomVersion target, driven by scripts/Get-Version.ps1 and version.json).
		     ApplicationVersion is the Android versionCode integer; override in CI with the run number. -->
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>
		<!-- Targets with a resizable desktop window, as opposed to the phone-shaped Android one. -->
		<DefineConstants Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">$(DefineConstants);DESKTOP</DefineConstants>
		<!-- Targets with a phone-shaped screen and a soft keyboard. -->
		<DefineConstants Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">$(DefineConstants);MOBILE</DefineConstants>
		<!-- Targets built on UIKit. Mac Catalyst does not define IOS, so code both share says UIKIT. -->
		<DefineConstants Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">$(DefineConstants);UIKIT</DefineConstants>
		<!-- Targets that carry the SSH transport. Not Android, and by the operator's rule not iOS, so the
		     iOS app carries no encryption of its own (Platforms/iOS/Info.plist). -->
		<DefineConstants Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'">$(DefineConstants);SSH</DefineConstants>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- Input-latency diagnostics: build with `dotnet build -p:InputDiag=true` (Windows) to
	     compile in the INPUT_DIAG instrumentation (UI-thread stall probe, binding-mode self-check,
	     per-keystroke timeline). Writes to %TEMP%\mucka-input.txt. Off by default -> zero cost. -->
	<PropertyGroup Condition="'$(InputDiag)' == 'true'">
		<DefineConstants>$(DefineConstants);INPUT_DIAG</DefineConstants>
	</PropertyGroup>

	<!-- Focus diagnostics: build with `dotnet build -p:FocusDiag=true` (Windows) to log every
	     focus transition (app-wide FocusManager events plus our own veto/redirect decisions) to
	     %TEMP%\mucka-focus.txt. Use it when something steals keyboard focus from the command box
	     (Invariant #0). Off by default -> compiled out entirely. -->
	<PropertyGroup Condition="'$(FocusDiag)' == 'true'">
		<DefineConstants>$(DefineConstants);FOCUS_DIAG</DefineConstants>
	</PropertyGroup>

	<!-- A local Mac Release build is one architecture - this machine's - which is faster and puts the
	     complete app at bin/Release/net10.0-maccatalyst/<rid>/Mucka.app. With two RIDs the per-RID
	     folders hold incomplete bundles (no sounds, no icon) and only bin/Release/net10.0-maccatalyst/Mucka.app
	     is the universal app. CI (CI=true), or -p:UniversalMac=true, builds both. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' and '$(Configuration)' == 'Release' and '$(CI)' != 'true' and '$(UniversalMac)' != 'true'">
		<RuntimeIdentifier>maccatalyst-$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
	</PropertyGroup>

	<!-- Platforms/iOS/Entitlements.plist (the keychain group SecureStorage needs) makes the iOS SDK
	     look for a signing identity even for the simulator, and there is none until the Apple developer
	     account exists. A simulator app is signed ad hoc instead. With no -r the SDK picks the
	     simulator; a device build names ios-arm64 and keeps the SDK's own identity lookup. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(CodesignKey)' == '' and ('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('iossimulator')))">
		<CodesignKey>-</CodesignKey>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release'">
		<!-- arm64-v8a covers every Android phone since ~2015; omitting 32-bit/x86 slashes APK size significantly -->
		<RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
		<PublishTrimmed>true</PublishTrimmed>
		<!-- AOT defaults to enabled for MonoVM Release builds, adding several MB of native .so files.
		     Disable it: a MUD terminal client has no startup-perf requirement. -->
		<RunAOTCompilation>false</RunAOTCompilation>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\mucka_icon.png" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\AppIcon\mucka_icon.png" Color="#512BD4" BaseSize="256,256" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<!-- Status-effect icons (rasterized from Resources\Raw\status\*.svg) -->
		<MauiImage Include="Resources\Images\Status\*" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Cascadia Mono and its italic are also embedded (independently of MAUI font
		     registration) so the SkiaSharp terminal renderer can load their raw bytes synchronously
		     via GetManifestResourceStream. Both files are the v2407.24 release; the italic shares
		     the regular's advance, so italic runs stay on the column grid. -->
		<EmbeddedResource Include="Resources\Fonts\CascadiaMono.ttf" LogicalName="Mucka.CascadiaMono.ttf" />
		<EmbeddedResource Include="Resources\Fonts\CascadiaMonoItalic.ttf" LogicalName="Mucka.CascadiaMonoItalic.ttf" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- status/*.svg are rasterizer source art, not runtime assets - the generated PNGs ship
		     via the MauiImage group above instead. -->
		<MauiAsset Remove="Resources\Raw\status\**" />
		<!-- sounds/README.md documents the sound set for editors; it has no runtime use. -->
		<MauiAsset Remove="Resources\Raw\sounds\README.md" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<!-- The App Store rejects an upload without a privacy manifest at the bundle's root. -->
		<BundleResource Include="Platforms\iOS\PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<Content Include="Platforms\Windows\muckabase.ico" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.4" />
		<!-- The one client database (Mucka.Util/Mucka.Store).
		     Pulls SQLitePCLRaw.bundle_e_sqlite3 for the native engine; on Android that is one
		     libe_sqlite3.so, since the Release config above restricts RuntimeIdentifiers to
		     android-arm64. Trim-safe, so PublishTrimmed stays. -->
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
	</ItemGroup>

	<!-- The SSH transport (Core/Transports.cs, behind SSH). Not referenced on Android or iOS. -->
	<ItemGroup Condition="$(DefineConstants.Contains(';SSH'))">
		<PackageReference Include="SSH.NET" Version="2026.0.0" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="tools\**" />
		<Compile Remove="scripts\**" />
		<Compile Remove="mudsharp\**" />
		<Compile Remove="mudsharp.Tests\**" />
		<Compile Remove="Mucka.Terminal\**" />
		<Compile Remove="Mucka.Terminal.Tests\**" />
		<Compile Remove="Mucka.Util\**" />
		<!-- Mucka.Input is referenced as an ASSEMBLY, never compiled in: the assembly boundary IS the
		     enforcement (see Mucka.Input/README.md). Globbing its sources into the app would silently
		     put the framework and the app in one compilation unit again and hand every file back the
		     ability to reach the native control. -->
		<Compile Remove="Mucka.Input\**" />
		<EmbeddedResource Remove="mudsharp\**" />
		<EmbeddedResource Remove="mudsharp.Tests\**" />
		<EmbeddedResource Remove="Mucka.Terminal\**" />
		<EmbeddedResource Remove="Mucka.Terminal.Tests\**" />
		<EmbeddedResource Remove="Mucka.Input\**" />
		<EmbeddedResource Remove="Mucka.Util\**" />
		<None Remove="mudsharp\**" />
		<None Remove="mudsharp.Tests\**" />
		<None Remove="Mucka.Terminal\**" />
		<None Remove="Mucka.Terminal.Tests\**" />
		<None Remove="Mucka.Input\**" />
		<None Remove="Mucka.Util\**" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="mudsharp\mudsharp.csproj" />
		<ProjectReference Include="Mucka.Terminal\Mucka.Terminal.csproj" />
		<ProjectReference Include="Mucka.Input\Mucka.Input.csproj" />
		<ProjectReference Include="Mucka.Util\Mucka.WireLog\Mucka.WireLog.csproj" />
		<ProjectReference Include="Mucka.Util\Mucka.Combat\Mucka.Combat.csproj" />
		<ProjectReference Include="Mucka.Util\Mucka.Commands\Mucka.Commands.csproj" />
		<ProjectReference Include="Mucka.Util\Mucka.Sounds\Mucka.Sounds.csproj" />
		<ProjectReference Include="Mucka.Util\Mucka.Ui\Mucka.Ui.csproj" />
		<ProjectReference Include="Mucka.Util\Mucka.Settings\Mucka.Settings.csproj" />
	</ItemGroup>

	<!-- Strip .pdb symbol files from the publish output. SkiaSharp's native assets ship ~220 MB
	     of native .pdb files (libSkiaSharp.pdb, libGLESv2.pdb, ...) that bloat the release artifact
	     and are never needed at runtime. -->
	<Target Name="StripPdbsFromPublish" AfterTargets="Publish">
		<ItemGroup>
			<_PublishedPdbs Include="$(PublishDir)**\*.pdb" />
		</ItemGroup>
		<Delete Files="@(_PublishedPdbs)" />
		<Message Importance="high" Text="[mucka] Stripped %(_PublishedPdbs.Filename).pdb from publish output" />
	</Target>

</Project>
