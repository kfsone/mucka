<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mucka.ViewModels"
             xmlns:core="clr-namespace:Mucka.Core"
             x:Class="Mucka.Pages.ConnectPage"
             x:DataType="vm:ConnectViewModel"
             Title="mucka"
             BackgroundColor="#0C0C0C"
             NavigationPage.HasNavigationBar="False"
             SafeAreaEdges="All">

    <!-- Static placement below is the WIDE layout (list panel left of the form); ApplyLayout in
         the code-behind re-grids by actual width — narrow puts the logo beside a height-capped
         list, then the form below. Width-based (not OnIdiom) so a phone in landscape goes wide. -->
    <Grid x:Name="RootGrid"
          RowDefinitions="Auto,*"
          ColumnDefinitions="256,1,*">

        <!-- Narrow-only title strip: app name + version (replaces the old nav bar usefully).
             Hidden in wide layout, where the version renders under the logo instead. -->
        <Border x:Name="TitleBar"
                Grid.Row="0" Grid.Column="0"
                IsVisible="False"
                BackgroundColor="#161b22"
                StrokeThickness="0"
                Padding="12,6">
            <Label x:Name="TitleLabel"
                   TextColor="#cccccc"
                   FontSize="14"
                   FontAttributes="Bold"
                   VerticalOptions="Center"/>
        </Border>

        <!-- Logo + version — fixed above the profile list so the list scrolls under it -->
        <VerticalStackLayout x:Name="HeaderPanel"
                             Grid.Row="0" Grid.Column="0"
                             Padding="0" BackgroundColor="#111111">
            <Image x:Name="LogoImage"
                   Source="mucka_logo.png"
                   HorizontalOptions="Fill"
                   Aspect="AspectFit"/>
            <Label x:Name="VersionLabel"
                   TextColor="#555555"
                   FontSize="11"
                   HorizontalOptions="Center"
                   Padding="0,0,0,2"/>
        </VerticalStackLayout>

        <!-- Profile list -->
        <CollectionView Grid.Row="1"
                        Grid.Column="0"
                        x:Name="ProfileList"
                        ItemsSource="{Binding SavedProfiles}"
                        SelectionMode="Single"
                        SelectionChanged="OnProfileSelected"
                        BackgroundColor="#111111">
            <CollectionView.Header>
                <Label Text="Saved profiles"
                       TextColor="#555555"
                       FontSize="12"
                       Padding="12,4,12,4" />
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="core:Profile">
                    <VerticalStackLayout Padding="12,6" Spacing="2">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer NumberOfTapsRequired="2"
                                                  Tapped="OnProfileDoubleTapped"
                                                  CommandParameter="{Binding .}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="{Binding Name}"
                               TextColor="#cccccc" />
                        <Label Text="{Binding Host}"
                               TextColor="#555555"
                               FontSize="11" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Separator between the profile panel and the form -->
        <BoxView x:Name="Separator"
                 Grid.Row="0" Grid.RowSpan="2"
                 Grid.Column="1"
                 Color="#333333"
                 WidthRequest="1" />

        <!-- Main form -->
        <ScrollView x:Name="FormScroll"
                    Grid.Row="0" Grid.RowSpan="2"
                    Grid.Column="2"
                    VerticalOptions="Center">
            <VerticalStackLayout HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}"
                                 Spacing="16"
                                 Padding="24">
                <Grid ColumnDefinitions="80,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="10"
                      ColumnSpacing="10">

                    <!-- Profile name: full-width, no label -->
                    <Entry Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Text="{Binding ProfileName}"
                           TextColor="White"
                           BackgroundColor="#161b22"
                           PlaceholderColor="#444444"
                           Placeholder="profile name"
                           SemanticProperties.Description="Profile name"
                           ReturnType="Next" />

                    <!-- Host + Port side by side -->
                    <Label Grid.Row="1"
                           Grid.Column="0"
                           Text="Host"
                           TextColor="#888888"
                           VerticalOptions="Center" />
                    <Grid Grid.Row="1"
                          Grid.Column="1"
                          ColumnDefinitions="*,80"
                          ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               x:Name="HostEntry"
                               Text="{Binding Host}"
                               TextColor="White"
                               BackgroundColor="#161b22"
                               PlaceholderColor="#444444"
                               Placeholder="mud2.co.uk"
                               Keyboard="Url"
                               ReturnType="Next" />
                        <Entry Grid.Column="1"
                               Text="{Binding Port}"
                               TextColor="White"
                               BackgroundColor="#161b22"
                               Keyboard="Numeric"
                               SemanticProperties.Description="Port"
                               ReturnType="Next" />
                    </Grid>

                    <!-- Account + Password side by side -->
                    <Label Grid.Row="2"
                           Grid.Column="0"
                           Text="Account"
                           TextColor="#888888"
                           VerticalOptions="Center" />
                    <Grid Grid.Row="2"
                          Grid.Column="1"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Text="{Binding AccountId}"
                               TextColor="White"
                               BackgroundColor="#161b22"
                               PlaceholderColor="#444444"
                               Placeholder="account id"
                               ReturnType="Next" />
                        <Entry Grid.Column="1"
                               Text="{Binding Password}"
                               IsPassword="True"
                               TextColor="White"
                               BackgroundColor="#161b22"
                               PlaceholderColor="#444444"
                               Placeholder="password (optional)"
                               ToolTipProperties.Text="password (optional)"
                               SemanticProperties.Description="Password (optional)"
                               ReturnType="Done" />
                    </Grid>

                    <!-- Remember Password -->
                    <Grid Grid.Row="3"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          ColumnDefinitions="Auto,Auto"
                          HorizontalOptions="Start"
                          ColumnSpacing="8">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding RememberPassword}"
                                  Color="#1f6feb"
                                  VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="Remember Password"
                               TextColor="#888888"
                               VerticalOptions="Center"/>
                    </Grid>

                    <!-- Persona Login: automate the MUD Shell (login through persona select/create) -->
                    <Grid Grid.Row="4"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="6">
                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="8">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding GuidedLogin}"
                                      Color="#1f6feb"
                                      VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="Persona Login"
                                   TextColor="#888888"
                                   VerticalOptions="Center"/>
                        </Grid>
                        <Entry Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding GuidedLoginPersona}"
                               IsVisible="{Binding GuidedLogin}"
                               TextColor="White"
                               BackgroundColor="#161b22"
                               PlaceholderColor="#444444"
                               Placeholder="persona (blank to choose at connect time)"
                               SemanticProperties.Description="Persona login persona name"
                               ReturnType="Done"/>
                    </Grid>

                    <!-- Line Width: terminal columns advertised via NAWS -->
                    <Label Grid.Row="5"
                           Grid.Column="0"
                           Text="Line Width"
                           TextColor="#888888"
                           VerticalOptions="Center"/>
                    <Grid Grid.Row="5"
                          Grid.Column="1"
                          ColumnDefinitions="80,*"
                          ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               x:Name="MaxColumnsEntry"
                               Text="{Binding MaxColumnsText, Mode=OneWay}"
                               Placeholder="auto"
                               PlaceholderColor="#555555"
                               TextColor="White"
                               BackgroundColor="#161b22"
                               Keyboard="Numeric"
                               Completed="OnMaxColumnsEntryCompleted"
                               Unfocused="OnMaxColumnsEntryCompleted"
                               SemanticProperties.Description="Terminal line width"
                               ToolTipProperties.Text="Terminal width advertised to server via NAWS (blank = auto-size to window)"
                               ReturnType="Done"/>
                        <Label Grid.Column="1"
                               Text="blank = auto; 20&#x2013;160"
                               TextColor="#555555"
                               FontSize="11"
                               VerticalOptions="Center"/>
                    </Grid>

                    <!-- Anti-Idle: keep-alive interval -->
                    <Label Grid.Row="6"
                           Grid.Column="0"
                           Text="Anti-Idle"
                           TextColor="#888888"
                           VerticalOptions="Center"/>
                    <Grid Grid.Row="6"
                          Grid.Column="1"
                          ColumnDefinitions="80,*"
                          ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Text="{Binding AntiIdleSeconds}"
                               TextColor="White"
                               BackgroundColor="#161b22"
                               Keyboard="Numeric"
                               SemanticProperties.Description="Anti-idle interval in seconds"
                               ToolTipProperties.Text="Seconds of inactivity before sending a keep-alive (0 = disabled)"
                               ReturnType="Done"/>
                        <Label Grid.Column="1"
                               Text="seconds (0=off)"
                               TextColor="#555555"
                               FontSize="11"
                               VerticalOptions="Center"/>
                    </Grid>
                </Grid>

                <Grid ColumnDefinitions="*"
                      ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="Connect  &#x25B6;"
                            Command="{Binding ConnectCommand}"
                            IsEnabled="{Binding CanConnect}"
                            BackgroundColor="#1f6feb"
                            TextColor="White"
                            CornerRadius="6"
                            HeightRequest="48" />
                </Grid>

                <!-- Advanced toggle -->
                <Button Text="{Binding AdvancedChevron}"
                        Command="{Binding ToggleAdvancedCommand}"
                        BackgroundColor="#1a1a1a"
                        TextColor="#555555"
                        BorderColor="#333333"
                        BorderWidth="1"
                        CornerRadius="4"
                        HeightRequest="36"
                        HorizontalOptions="Fill"
                        FontSize="13"
                        Padding="12,0"/>

                <!-- Advanced section -->
                <VerticalStackLayout IsVisible="{Binding AdvancedVisible}"
                                     Spacing="10">

                    <!-- MUD Login: checkbox + label + help -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="8">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding TelnetLoginEnabled}"
                                  Color="#1f6feb"
                                  VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="MUD Login"
                               TextColor="#888888"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2"
                               Text="&#x24D8;"
                               TextColor="#1f6feb"
                               FontSize="16"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowTelnetHelpCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- MUD User (TelnetLoginName) -->
                    <Grid ColumnDefinitions="80,*"
                          ColumnSpacing="10">
                        <Label Grid.Column="0"
                               Text="MUD User"
                               TextColor="#888888"
                               VerticalOptions="Center"/>
                        <Entry Grid.Column="1"
                               Text="{Binding TelnetLoginName}"
                               IsEnabled="{Binding TelnetLoginEnabled}"
                               TextColor="White"
                               BackgroundColor="#161b22"
                               PlaceholderColor="#444444"
                               Placeholder="mud"
                               SemanticProperties.Description="MUD login username"
                               ReturnType="Done"/>
                    </Grid>

                    <!-- Keep Screen On (Android only) -->
                    <Grid ColumnDefinitions="Auto,Auto"
                          HorizontalOptions="Start"
                          ColumnSpacing="8"
                          IsVisible="{OnPlatform Default=False, Android=True}">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding KeepScreenOn}"
                                  Color="#1f6feb"
                                  VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="Keep Screen On"
                               TextColor="#888888"
                               VerticalOptions="Center"/>
                    </Grid>

                    <!-- Session recording (advanced feature): arm/disarm whole-session capture before connecting -->
                    <Button Text="{Binding CaptureButtonText}"
                            Command="{Binding ToggleCaptureCommand}"
                            IsVisible="{Binding IsCaptureFacilityAvailable}"
                            BackgroundColor="#2d333b"
                            TextColor="#cccccc"
                            CornerRadius="6"
                            HeightRequest="44"
                            HorizontalOptions="Fill"
                            SemanticProperties.Description="Toggle pre-connect capture"
                            SemanticProperties.Hint="Arms or disarms session capture before connecting">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsCaptureRequested}" Value="True">
                                <Setter Property="BackgroundColor" Value="#c02020"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- Delete Profile -->
                    <Button Text="Delete Profile"
                            Command="{Binding DeleteProfileCommand}"
                            IsEnabled="{Binding CanConnect}"
                            BackgroundColor="#3d1a1a"
                            TextColor="#f85149"
                            BorderColor="#5a2020"
                            BorderWidth="1"
                            CornerRadius="6"
                            HeightRequest="44"
                            HorizontalOptions="Fill"/>

                </VerticalStackLayout>

                <Label Text="{Binding StatusText}"
                       TextColor="#f85149"
                       IsVisible="{Binding HasError}"
                       HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
