<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mucka.ViewModels"
             x:Class="Mucka.Pages.FkeyEditorPage"
             x:DataType="vm:FkeyEditorViewModel"
             Title="Config"
             BackgroundColor="#0C0C0C"
             SafeAreaEdges="All">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Tab bar ──────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                BackgroundColor="#161b22"
                StrokeThickness="0"
                Padding="12,6">
            <HorizontalStackLayout Spacing="4">

                <!-- Settings tab -->
                <Border Stroke="Transparent" StrokeThickness="0" Padding="14,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTabCommand}" CommandParameter="0"/>
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSettingsTabActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1f6feb"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSettingsTabActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="#2d333b"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Settings" FontSize="13" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSettingsTabActive}" Value="True">
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSettingsTabActive}" Value="False">
                                <Setter Property="TextColor" Value="#888888"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <!-- Display tab -->
                <Border Stroke="Transparent" StrokeThickness="0" Padding="14,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTabCommand}" CommandParameter="1"/>
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsDisplayTabActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1f6feb"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsDisplayTabActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="#2d333b"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Display" FontSize="13" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsDisplayTabActive}" Value="True">
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsDisplayTabActive}" Value="False">
                                <Setter Property="TextColor" Value="#888888"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <!-- Hotkeys tab -->
                <Border Stroke="Transparent" StrokeThickness="0" Padding="14,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTabCommand}" CommandParameter="2"/>
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsHotkeysTabActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1f6feb"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsHotkeysTabActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="#2d333b"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Hotkeys" FontSize="13" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsHotkeysTabActive}" Value="True">
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsHotkeysTabActive}" Value="False">
                                <Setter Property="TextColor" Value="#888888"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <!-- Sounds tab -->
                <Border Stroke="Transparent" StrokeThickness="0" Padding="14,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTabCommand}" CommandParameter="3"/>
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSoundsTabActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1f6feb"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSoundsTabActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="#2d333b"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Sounds" FontSize="13" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSoundsTabActive}" Value="True">
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSoundsTabActive}" Value="False">
                                <Setter Property="TextColor" Value="#888888"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <!-- Friends tab -->
                <Border Stroke="Transparent" StrokeThickness="0" Padding="14,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTabCommand}" CommandParameter="4"/>
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsFriendsTabActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1f6feb"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsFriendsTabActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="#2d333b"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Friends" FontSize="13" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsFriendsTabActive}" Value="True">
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsFriendsTabActive}" Value="False">
                                <Setter Property="TextColor" Value="#888888"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

            </HorizontalStackLayout>
        </Border>

        <!-- ── Content ──────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Padding="12,10,12,0">

            <!-- ── SETTINGS TAB ──────────────────────────────────────── -->
            <ScrollView IsVisible="{Binding IsSettingsTabActive}">
                <VerticalStackLayout Spacing="20" Padding="0,0,0,12">

                    <!-- Save scope: unchecked = global [settings]; checked = this profile's section -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding SettingsToProfileOnly, Mode=TwoWay}"
                                  Color="#1f6feb"
                                  VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="Save to profile only (otherwise these settings are shared by all profiles)"
                               TextColor="#888888" FontSize="12"
                               VerticalOptions="Center"/>
                    </Grid>

                    <!-- Font Size -->
                    <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Font Size" TextColor="#888888" FontSize="13" VerticalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Button Text="−" Command="{Binding DecrFontSizeCommand}"
                                    BackgroundColor="#2d333b" TextColor="#cccccc"
                                    FontSize="15" WidthRequest="34" HeightRequest="30"
                                    CornerRadius="4" Padding="0"/>
                            <Label Text="{Binding FontSizeDisplay}" TextColor="White" FontSize="13"
                                   WidthRequest="28" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Button Text="+" Command="{Binding IncrFontSizeCommand}"
                                    BackgroundColor="#2d333b" TextColor="#cccccc"
                                    FontSize="15" WidthRequest="34" HeightRequest="30"
                                    CornerRadius="4" Padding="0"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Columns -->
                    <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Columns" TextColor="#888888" FontSize="13" VerticalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Button Text="−" Command="{Binding DecrColumnsCommand}"
                                    BackgroundColor="#2d333b" TextColor="#cccccc"
                                    FontSize="15" WidthRequest="34" HeightRequest="30"
                                    CornerRadius="4" Padding="0"/>
                            <Label Text="{Binding ColumnsDisplay}" TextColor="White" FontSize="13"
                                   WidthRequest="28" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Button Text="+" Command="{Binding IncrColumnsCommand}"
                                    BackgroundColor="#2d333b" TextColor="#cccccc"
                                    FontSize="15" WidthRequest="34" HeightRequest="30"
                                    CornerRadius="4" Padding="0"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Volume -->
                    <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Volume" TextColor="#888888" FontSize="13" VerticalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                            <Label Text="{Binding VolumeDisplay}" TextColor="White" FontSize="13"
                                   WidthRequest="28" VerticalOptions="Center"/>
                            <Slider Minimum="0" Maximum="100" WidthRequest="160"
                                    Value="{Binding Volume, Mode=TwoWay}"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Stat Update (FES) frequency -->
                    <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Stat Update (FES)" TextColor="#888888" FontSize="13" VerticalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Button Text="−" Command="{Binding DecrStatFreqCommand}"
                                    BackgroundColor="#2d333b" TextColor="#cccccc"
                                    FontSize="15" WidthRequest="34" HeightRequest="30"
                                    CornerRadius="4" Padding="0"/>
                            <Label Text="{Binding StatUpdateFrequencyDisplay}" TextColor="White" FontSize="13"
                                   WidthRequest="44" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Button Text="+" Command="{Binding IncrStatFreqCommand}"
                                    BackgroundColor="#2d333b" TextColor="#cccccc"
                                    FontSize="15" WidthRequest="34" HeightRequest="30"
                                    CornerRadius="4" Padding="0"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Beep mute -->
                    <VerticalStackLayout Spacing="6">

                        <!-- Session mute: not persisted -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding MuteBeepSession, Mode=TwoWay}"
                                      Color="#1f6feb"
                                      VerticalOptions="Start"/>
                            <Label Grid.Column="1"
                                   Text="Hey, that gong-like 'beep' sound was funny at first but it gets annoying, how about you just not?"
                                   TextColor="#888888" FontSize="12"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- Permanent mute: persisted; only shown when session mute is on -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                              Margin="28,0,0,0"
                              IsVisible="{Binding MuteBeepSession}">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding MuteBeepPermanently, Mode=TwoWay}"
                                      Color="#1f6feb"
                                      VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="Like, ever?"
                                   TextColor="#888888" FontSize="12"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- "Hear it" link: always visible -->
                        <Label Margin="28,0,0,0" FontSize="12">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Wait, what beep-gong sound? I want to " TextColor="#888888"/>
                                    <Span Text="hear" TextColor="#1f6feb" TextDecorations="Underline">
                                        <Span.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding PlayBeepCommand}"/>
                                        </Span.GestureRecognizers>
                                    </Span>
                                    <Span Text=" it!" TextColor="#888888"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ── HOTKEYS TAB ───────────────────────────────────────── -->
            <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsHotkeysTabActive}">

                <!-- Save scope: unchecked = global [fkeys]; checked = this profile's section -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,6">
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding FkeysToProfileOnly, Mode=TwoWay}"
                              Color="#1f6feb"
                              VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="Save to profile only (otherwise these hotkeys are shared by all profiles)"
                           TextColor="#888888" FontSize="12"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Modifier selector — pills on the left, Import on the right -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="6" Margin="0,0,0,10">
                    <Button Grid.Column="0"
                            Text="None"
                            Command="{Binding SetModifierCommand}"
                            CommandParameter="0"
                            BackgroundColor="#2d333b" TextColor="#cccccc"
                            FontSize="12" WidthRequest="72" HeightRequest="30"
                            CornerRadius="4" Padding="0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveModifier}" Value="0">
                                <Setter Property="BackgroundColor" Value="#1f6feb"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1"
                            Text="Shift"
                            Command="{Binding SetModifierCommand}"
                            CommandParameter="1"
                            BackgroundColor="#2d333b" TextColor="#cccccc"
                            FontSize="12" WidthRequest="72" HeightRequest="30"
                            CornerRadius="4" Padding="0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveModifier}" Value="1">
                                <Setter Property="BackgroundColor" Value="#1f6feb"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2"
                            Text="Ctrl"
                            Command="{Binding SetModifierCommand}"
                            CommandParameter="2"
                            BackgroundColor="#2d333b" TextColor="#cccccc"
                            FontSize="12" WidthRequest="72" HeightRequest="30"
                            CornerRadius="4" Padding="0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveModifier}" Value="2">
                                <Setter Property="BackgroundColor" Value="#1f6feb"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <!-- Column 3 is the * spacer -->
                    <Button Grid.Column="4"
                            x:Name="ImportButton"
                            Text="Import"
                            ToolTipProperties.Text="Import from clio.ini"
                            IsVisible="False"
                            BackgroundColor="#2d333b" TextColor="#888888"
                            FontSize="12" WidthRequest="72" HeightRequest="30"
                            CornerRadius="4" Padding="0"/>
                </Grid>

                <!-- F-key list -->
                <ScrollView Grid.Row="2">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentPageItems}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:FkeyEditorItem">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Grid.Column="0"
                                           Text="{Binding Label}"
                                           TextColor="#888888"
                                           FontSize="12"
                                           VerticalOptions="Center"
                                           WidthRequest="36"/>
                                    <Entry Grid.Column="1"
                                           Text="{Binding Command, Mode=TwoWay}"
                                           TextColor="White"
                                           BackgroundColor="#161b22"
                                           Placeholder="Enter command"
                                           PlaceholderColor="#444444"
                                           ClearButtonVisibility="WhileEditing"
                                           Keyboard="Plain"
                                           IsSpellCheckEnabled="False"
                                           IsTextPredictionEnabled="False"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <!-- ── SOUNDS TAB ────────────────────────────────────────── -->
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" IsVisible="{Binding IsSoundsTabActive}">

                <!-- Master row: on/off checkbox, volume slider, reset -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding SoundsEnabled, Mode=TwoWay}"
                              Color="#1f6feb"
                              VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="All sounds" TextColor="White"
                           FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label Grid.Column="2" Text="{Binding VolumeDisplay}" TextColor="White"
                           FontSize="13" WidthRequest="28" HorizontalTextAlignment="End"
                           VerticalOptions="Center"/>
                    <Slider Grid.Column="3" Minimum="0" Maximum="100" WidthRequest="160"
                            Value="{Binding Volume, Mode=TwoWay}" VerticalOptions="Center"/>
                    <!-- Column 4 is the * spacer -->
                    <Button Grid.Column="5"
                            Text="Reset to Default"
                            Command="{Binding ResetSoundsCommand}"
                            BackgroundColor="#2d333b" TextColor="#cccccc"
                            FontSize="12" HeightRequest="30"
                            CornerRadius="4" Padding="10,0"/>
                </Grid>

                <Label Grid.Row="1"
                       Text="Tap a heading to expand its group; ♪ previews a sound. A group's Default plays when the game triggers a sound in that group that has no sound file of its own."
                       TextColor="#888888" FontSize="12"/>

                <!-- The tree: collapsible groups of individual sounds.
                     Right padding keeps the controls clear of the overlay scrollbar. -->
                <ScrollView Grid.Row="2">
                    <VerticalStackLayout Spacing="4" Padding="0,0,18,0"
                                         IsEnabled="{Binding SoundsEnabled}"
                                         BindableLayout.ItemsSource="{Binding SoundGroups}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SoundGroupEditorItem">
                                <VerticalStackLayout Spacing="2">

                                    <!-- Group heading row -->
                                    <Grid ColumnDefinitions="20,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                                        <Label Grid.Column="0" Text="{Binding Chevron}"
                                               TextColor="#888888" FontSize="12"
                                               VerticalOptions="Center" HorizontalTextAlignment="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleExpandCommand}"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  Color="#1f6feb"
                                                  VerticalOptions="Center"/>
                                        <Border Grid.Column="2"
                                                IsVisible="{Binding HasPreview}"
                                                BackgroundColor="#2d333b" StrokeThickness="0"
                                                Padding="9,3" VerticalOptions="Center"
                                                ToolTipProperties.Text="Preview">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding PlayCommand}"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="♪" TextColor="#1f6feb" FontSize="13"/>
                                        </Border>
                                        <Label Grid.Column="3" Text="{Binding Name}"
                                               TextColor="White" FontSize="13" FontAttributes="Bold"
                                               VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleExpandCommand}"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label Grid.Column="4" Text="{Binding VolumeDisplay}"
                                               TextColor="#888888" FontSize="11" WidthRequest="26"
                                               HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                        <Slider Grid.Column="5" Minimum="0" Maximum="100" WidthRequest="110"
                                                ToolTipProperties.Text="Group volume — follows the master slider until moved; drag back onto the master value to re-attach"
                                                Value="{Binding Volume, Mode=TwoWay}"
                                                VerticalOptions="Center"/>
                                        <Picker Grid.Column="6"
                                                IsVisible="{Binding HasDefaultPicker}"
                                                Title="Default"
                                                ToolTipProperties.Text="Played when the game triggers a sound in this group that has no sound file of its own"
                                                ItemsSource="{Binding DefaultChoices}"
                                                SelectedIndex="{Binding SelectedDefaultIndex, Mode=TwoWay}"
                                                TextColor="White" TitleColor="#888888"
                                                BackgroundColor="#161b22"
                                                FontSize="12" WidthRequest="200"/>
                                    </Grid>

                                    <!-- Child sounds, visible while expanded -->
                                    <VerticalStackLayout IsVisible="{Binding Expanded}"
                                                         Margin="46,0,0,4" Spacing="0"
                                                         BindableLayout.ItemsSource="{Binding Sounds}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SoundEditorItem">
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6"
                                                      IsEnabled="{Binding Group.Enabled}">
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              Color="#1f6feb"
                                                              VerticalOptions="Center"/>
                                                    <Border Grid.Column="1"
                                                            BackgroundColor="#2d333b" StrokeThickness="0"
                                                            Padding="9,3" VerticalOptions="Center"
                                                            ToolTipProperties.Text="Preview">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding PlayCommand}"/>
                                                        </Border.GestureRecognizers>
                                                        <Label Text="♪" TextColor="#1f6feb" FontSize="13"/>
                                                    </Border>
                                                    <Label Grid.Column="2" Text="{Binding Name}"
                                                           TextColor="#cccccc" FontSize="12"
                                                           VerticalOptions="Center"/>
                                                    <Label Grid.Column="3" Text="{Binding VolumeDisplay}"
                                                           TextColor="#888888" FontSize="11" WidthRequest="26"
                                                           HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                                    <Slider Grid.Column="4" Minimum="0" Maximum="100" WidthRequest="110"
                                                            ToolTipProperties.Text="Sound volume — follows the group slider until moved; drag back onto the group value to re-attach"
                                                            Value="{Binding Volume, Mode=TwoWay}"
                                                            VerticalOptions="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <!-- ── FRIENDS TAB ───────────────────────────────────────── -->
            <Label Text="Soon!"
                   IsVisible="{Binding IsFriendsTabActive}"
                   TextColor="#555555"
                   FontSize="24"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>

            <!-- ── DISPLAY TAB ───────────────────────────────────────── -->
            <ScrollView IsVisible="{Binding IsDisplayTabActive}">
                <VerticalStackLayout Spacing="20" Padding="0,0,0,12">

                    <Label Text="These settings apply globally to all profiles."
                           TextColor="#555555" FontSize="11" FontAttributes="Italic"/>

                    <!-- ── General ─────────────────────────────────────── -->
                    <Label Text="General" TextColor="#58a6ff" FontSize="13" FontAttributes="Bold"/>

                    <!-- Default Font Size -->
                    <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Default Font Size" TextColor="#888888" FontSize="13" VerticalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Button Text="&#x2212;" Command="{Binding DecrDisplayFontSizeCommand}"
                                    BackgroundColor="#2d333b" TextColor="#cccccc"
                                    FontSize="15" WidthRequest="34" HeightRequest="30"
                                    CornerRadius="4" Padding="0"/>
                            <Label Text="{Binding DisplayFontSizeDisplay}" TextColor="White" FontSize="13"
                                   WidthRequest="28" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Button Text="+" Command="{Binding IncrDisplayFontSizeCommand}"
                                    BackgroundColor="#2d333b" TextColor="#cccccc"
                                    FontSize="15" WidthRequest="34" HeightRequest="30"
                                    CornerRadius="4" Padding="0"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Default Column Width -->
                    <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Default Column Width" TextColor="#888888" FontSize="13" VerticalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Button Text="&#x2212;" Command="{Binding DecrDisplayColumnsCommand}"
                                    BackgroundColor="#2d333b" TextColor="#cccccc"
                                    FontSize="15" WidthRequest="34" HeightRequest="30"
                                    CornerRadius="4" Padding="0"/>
                            <Label Text="{Binding DisplayColumnsDisplay}" TextColor="White" FontSize="13"
                                   WidthRequest="36" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Button Text="+" Command="{Binding IncrDisplayColumnsCommand}"
                                    BackgroundColor="#2d333b" TextColor="#cccccc"
                                    FontSize="15" WidthRequest="34" HeightRequest="30"
                                    CornerRadius="4" Padding="0"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Dreamword pill size offset -->
                    <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Dreamword Pill Size" TextColor="#888888" FontSize="13" VerticalOptions="Center"
                               ToolTipProperties.Text="Adjusts the dreamword chip font size relative to the base. Range: -2 to +4"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Button Text="&#x2212;" Command="{Binding DecrDisplayDreamwordOffsetCommand}"
                                    BackgroundColor="#2d333b" TextColor="#cccccc"
                                    FontSize="15" WidthRequest="34" HeightRequest="30"
                                    CornerRadius="4" Padding="0"/>
                            <Label Text="{Binding DisplayDreamwordOffsetDisplay}" TextColor="White" FontSize="13"
                                   WidthRequest="28" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Button Text="+" Command="{Binding IncrDisplayDreamwordOffsetCommand}"
                                    BackgroundColor="#2d333b" TextColor="#cccccc"
                                    FontSize="15" WidthRequest="34" HeightRequest="30"
                                    CornerRadius="4" Padding="0"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Separator -->
                    <BoxView Color="#2d333b" HeightRequest="1"/>

                    <!-- ── Side Panel ───────────────────────────────────── -->
                    <Label Text="Side Panel" TextColor="#58a6ff" FontSize="13" FontAttributes="Bold"/>

                    <!-- Show online -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" IsChecked="{Binding ShowOnline, Mode=TwoWay}"
                                  Color="#1f6feb" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Show online"
                               TextColor="#888888" FontSize="13" VerticalOptions="Center"
                               ToolTipProperties.Text="Show the Online section (FEW). When disabled, the online list is not requested from the server."/>
                    </Grid>

                    <!-- Sub-settings for Show Online (indent 28dp to align with label) -->
                    <VerticalStackLayout Margin="28,0,0,0" Spacing="8" IsEnabled="{Binding ShowOnline}">

                        <!-- Max Online -->
                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="Max online" TextColor="#888888" FontSize="13" VerticalOptions="Center"
                                   ToolTipProperties.Text="Maximum number of players shown in the list. 0 = unlimited."/>
                            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Button Text="&#x2212;" Command="{Binding DecrMaxOnlineCommand}"
                                        BackgroundColor="#2d333b" TextColor="#cccccc"
                                        FontSize="15" WidthRequest="34" HeightRequest="30"
                                        CornerRadius="4" Padding="0"/>
                                <Label Text="{Binding MaxOnlineDisplayText}" TextColor="White" FontSize="13"
                                       MinimumWidthRequest="60" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                <Button Text="+" Command="{Binding IncrMaxOnlineCommand}"
                                        BackgroundColor="#2d333b" TextColor="#cccccc"
                                        FontSize="15" WidthRequest="34" HeightRequest="30"
                                        CornerRadius="4" Padding="0"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Forget window: minutes a departed player lingers in the Recent list -->
                        <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="Forget window" TextColor="#888888" FontSize="13" VerticalOptions="Center"
                                   ToolTipProperties.Text="How long a player who drops off the Online list lingers in a quiet 'Recent' list below it before being forgotten. 0 = off (forget immediately). Max 10 min."/>
                            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Button Text="&#x2212;" Command="{Binding DecrForgetWindowCommand}"
                                        BackgroundColor="#2d333b" TextColor="#cccccc"
                                        FontSize="15" WidthRequest="34" HeightRequest="30"
                                        CornerRadius="4" Padding="0"/>
                                <Label Text="{Binding OnlineForgetWindowText}" TextColor="White" FontSize="13"
                                       MinimumWidthRequest="60" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                <Button Text="+" Command="{Binding IncrForgetWindowCommand}"
                                        BackgroundColor="#2d333b" TextColor="#cccccc"
                                        FontSize="15" WidthRequest="34" HeightRequest="30"
                                        CornerRadius="4" Padding="0"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Float -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding FloatOnline, Mode=TwoWay}"
                                      Color="#1f6feb" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Float"
                                   TextColor="#888888" FontSize="13" VerticalOptions="Center"
                                   ToolTipProperties.Text="Default the Online list to a floating panel instead of docked in the side panel. Changing this also moves the panel now if it still matches the saved default; if you've manually floated/docked it since, the live panel is left as-is."/>
                        </Grid>

                        <!-- Names only -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding OnlineNamesOnly, Mode=TwoWay}"
                                      Color="#1f6feb" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Names only"
                                   TextColor="#888888" FontSize="13" VerticalOptions="Center"
                                   ToolTipProperties.Text="Show only the persona name without the title or level description."/>
                        </Grid>

                    </VerticalStackLayout>

                    <!-- Inventory -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" IsChecked="{Binding ShowInventory, Mode=TwoWay}"
                                  Color="#1f6feb" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Inventory"
                               TextColor="#888888" FontSize="13" VerticalOptions="Center"
                               ToolTipProperties.Text="Show the Carrying section (FEI inventory half)."/>
                    </Grid>

                    <!-- Items here -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" IsChecked="{Binding ShowItemsHere, Mode=TwoWay}"
                                  Color="#1f6feb" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Items here"
                               TextColor="#888888" FontSize="13" VerticalOptions="Center"
                               ToolTipProperties.Text="Show the Here section (FEI room-items half). When both Inventory and Items here are disabled, FEI is not requested from the server."/>
                    </Grid>

                    <!-- Map/Compass -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" IsChecked="{Binding ShowMapCompass, Mode=TwoWay}"
                                  Color="#1f6feb" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Map / Compass"
                               TextColor="#888888" FontSize="13" VerticalOptions="Center"
                               ToolTipProperties.Text="Show the Map/Compass section."/>
                    </Grid>

                    <!-- Sub-settings for Map/Compass (indent 28dp to align with label) -->
                    <VerticalStackLayout Margin="28,0,0,0" Spacing="8" IsEnabled="{Binding ShowMapCompass}">

                        <!-- Float -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding FloatCompass, Mode=TwoWay}"
                                      Color="#1f6feb" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Float"
                                   TextColor="#888888" FontSize="13" VerticalOptions="Center"
                                   ToolTipProperties.Text="Default the compass to a floating panel instead of docked in the side panel. Changing this also moves the panel now if it still matches the saved default; if you've manually floated/docked it since, the live panel is left as-is."/>
                        </Grid>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

        <!-- ── Action bar ────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                BackgroundColor="#161b22"
                StrokeThickness="0"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">

                <!-- Spacer: Grid.Column="0" -->

                <Button Grid.Column="1"
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="#2d333b" TextColor="#cccccc"
                        FontSize="13" WidthRequest="80" HeightRequest="34"
                        CornerRadius="4" Padding="0"/>

                <Button Grid.Column="2"
                        Text="Apply"
                        Command="{Binding ApplyCommand}"
                        BackgroundColor="#2d333b" TextColor="#cccccc"
                        FontSize="13" WidthRequest="80" HeightRequest="34"
                        CornerRadius="4" Padding="0"/>

                <Button Grid.Column="3"
                        Text="Save"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"
                        BackgroundColor="#1f6feb" TextColor="White"
                        FontSize="13" WidthRequest="80" HeightRequest="34"
                        CornerRadius="4" Padding="0"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
