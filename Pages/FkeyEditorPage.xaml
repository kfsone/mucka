<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mucka.ViewModels"
             xmlns:pages="clr-namespace:Mucka.Pages"
             xmlns:core="clr-namespace:Mucka.Core"
             x:Class="Mucka.Pages.FkeyEditorPage"
             x:DataType="vm:FkeyEditorViewModel"
             Title="Config"
             BackgroundColor="#0C0C0C"
             SafeAreaEdges="All">

    <ContentPage.Resources>
        <!-- One chat example line (ChatExampleLabel): the pane's font, the speaker's and the quoted
             words' own or other faces. Used beside each wide chat colour row and in the block below.
             Not scaled by the system text size, which the pane does not follow either; the page's
             wide/narrow test sizes the line from ChatExampleFontSize. -->
        <DataTemplate x:Key="ChatExampleLineTemplate" x:DataType="vm:ChatExampleLine">
            <pages:ChatExampleLabel/>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- - Tab bar - -->
        <Border Grid.Row="0"
                BackgroundColor="#161b22"
                StrokeThickness="0"
                Padding="12,6">
            <HorizontalStackLayout Spacing="4">

                <Border Stroke="Transparent" StrokeThickness="0" Padding="14,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTabCommand}" CommandParameter="0"/>
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSettingsTabActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1f6feb"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSettingsTabActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="#2d333b"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Settings" FontSize="{core:ScaledFont 13}" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSettingsTabActive}" Value="True">
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSettingsTabActive}" Value="False">
                                <Setter Property="TextColor" Value="#888888"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <Border Stroke="Transparent" StrokeThickness="0" Padding="14,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTabCommand}" CommandParameter="1"/>
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsDisplayTabActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1f6feb"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsDisplayTabActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="#2d333b"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Display" FontSize="{core:ScaledFont 13}" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsDisplayTabActive}" Value="True">
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsDisplayTabActive}" Value="False">
                                <Setter Property="TextColor" Value="#888888"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <Border Stroke="Transparent" StrokeThickness="0" Padding="14,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTabCommand}" CommandParameter="3"/>
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSoundsTabActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1f6feb"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSoundsTabActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="#2d333b"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Sounds" FontSize="{core:ScaledFont 13}" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSoundsTabActive}" Value="True">
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSoundsTabActive}" Value="False">
                                <Setter Property="TextColor" Value="#888888"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <Border x:Name="FunctionKeysTab" Stroke="Transparent" StrokeThickness="0" Padding="14,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTabCommand}" CommandParameter="2"/>
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsHotkeysTabActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1f6feb"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsHotkeysTabActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="#2d333b"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Function Keys" FontSize="{core:ScaledFont 13}" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsHotkeysTabActive}" Value="True">
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsHotkeysTabActive}" Value="False">
                                <Setter Property="TextColor" Value="#888888"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <Border x:Name="NavKeysTab" Stroke="Transparent" StrokeThickness="0" Padding="14,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTabCommand}" CommandParameter="4"/>
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsNavkeysTabActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1f6feb"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsNavkeysTabActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="#2d333b"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Nav Keys" FontSize="{core:ScaledFont 13}" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsNavkeysTabActive}" Value="True">
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsNavkeysTabActive}" Value="False">
                                <Setter Property="TextColor" Value="#888888"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <Border x:Name="DataTab" Stroke="Transparent" StrokeThickness="0" Padding="14,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTabCommand}" CommandParameter="5"/>
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsDataTabActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1f6feb"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsDataTabActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="#2d333b"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Data" FontSize="{core:ScaledFont 13}" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsDataTabActive}" Value="True">
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsDataTabActive}" Value="False">
                                <Setter Property="TextColor" Value="#888888"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <!-- Narrow: Function Keys, Nav Keys and Data leave the bar for this button's menu
                     (OnOverflowTabTapped); it lights while one of them is the tab shown. -->
                <Border x:Name="OverflowTab" IsVisible="False" Stroke="Transparent" StrokeThickness="0" Padding="14,5"
                        SemanticProperties.Description="More tabs: Function Keys, Nav Keys, Data">
                    <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOverflowTabTapped"/>
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsOverflowTabActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1f6feb"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsOverflowTabActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="#2d333b"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="&#x22EF;" FontSize="{core:ScaledFont 13}" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsOverflowTabActive}" Value="True">
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsOverflowTabActive}" Value="False">
                                <Setter Property="TextColor" Value="#888888"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

            </HorizontalStackLayout>
        </Border>

        <!-- - Content - -->
        <Grid Grid.Row="1" Padding="12,10,12,0">

            <!-- - SETTINGS TAB - -->
            <ScrollView IsVisible="{Binding IsSettingsTabActive}">
                <VerticalStackLayout Spacing="20" Padding="0,0,0,12">

                    <pages:FieldRow LabelWidth="140" Stacked="{Binding StackedFields}">
                        <Label Text="Volume" TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"/>
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label Text="{Binding VolumeDisplay}" TextColor="White" FontSize="{core:ScaledFont 13}"
                                   WidthRequest="28" VerticalOptions="Center"/>
                            <Slider Minimum="0" Maximum="100" WidthRequest="160"
                                    Value="{Binding Volume, Mode=TwoWay}"/>
                        </HorizontalStackLayout>
                    </pages:FieldRow>

                    <pages:FieldRow LabelWidth="140" Stacked="{Binding StackedFields}">
                        <Label Text="Stat Update (FES)" TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"/>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Button Text="&#x2212;" Command="{Binding DecrStatFreqCommand}"
                                    BackgroundColor="#2d333b" TextColor="#cccccc"
                                    FontSize="{core:ScaledFont 15}" WidthRequest="34" HeightRequest="30"
                                    CornerRadius="4" Padding="0"/>
                            <Label Text="{Binding StatUpdateFrequencyDisplay}" TextColor="White" FontSize="{core:ScaledFont 13}"
                                   WidthRequest="44" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Button Text="+" Command="{Binding IncrStatFreqCommand}"
                                    BackgroundColor="#2d333b" TextColor="#cccccc"
                                    FontSize="{core:ScaledFont 15}" WidthRequest="34" HeightRequest="30"
                                    CornerRadius="4" Padding="0"/>
                        </HorizontalStackLayout>
                    </pages:FieldRow>

                    <!-- Beep mute -->
                    <VerticalStackLayout Spacing="6">

                        <!-- Session mute: not persisted -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding MuteBeepSession, Mode=TwoWay}"
                                      Color="#1f6feb"
                                      VerticalOptions="Start"/>
                            <Label Grid.Column="1"
                                   Text="Hey, that gong-like 'beep' sound was funny at first but it gets annoying, how about you just not?"
                                   TextColor="#888888" FontSize="{core:ScaledFont 12}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- Permanent mute: persisted; only shown when session mute is on -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                              Margin="28,0,0,0"
                              IsVisible="{Binding MuteBeepSession}">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding MuteBeepPermanently, Mode=TwoWay}"
                                      Color="#1f6feb"
                                      VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="Like, ever?"
                                   TextColor="#888888" FontSize="{core:ScaledFont 12}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- "Hear it" link: always visible -->
                        <Label Margin="28,0,0,0" FontSize="{core:ScaledFont 12}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Wait, what beep-gong sound? I want to " TextColor="#888888"/>
                                    <Span Text="hear" TextColor="#1f6feb" TextDecorations="Underline">
                                        <Span.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding PlayBeepCommand}"/>
                                        </Span.GestureRecognizers>
                                    </Span>
                                    <Span Text=" it!" TextColor="#888888"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>


                        <!-- Advanced (Debug builds only): reset-timer diagnostics into the recording -->
                        <pages:LazyView IsVisible="{Binding IsTtrDiagAvailable}">
                            <pages:LazyView.Template><DataTemplate x:DataType="vm:FkeyEditorViewModel">
                                <VerticalStackLayout Spacing="4" Margin="0,12,0,0">
                                    <Label Text="Advanced" TextColor="#c9d1d9" FontSize="{core:ScaledFont 14}" FontAttributes="Bold"/>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding LogResetDiagnostics, Mode=TwoWay}"
                                                  Color="#1f6feb"
                                                  VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                               Text="Log reset-timer (TTR) diagnostics - requires session recording"
                                               TextColor="#888888" FontSize="{core:ScaledFont 12}"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate></pages:LazyView.Template>
                        </pages:LazyView>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- The tabs below the first are LazyViews: each builds its content, the DataTemplate that
                 wraps it, when first shown, so the page opens with one tab's views, not six. -->

            <!-- - HOTKEYS TAB - -->
            <pages:LazyView IsVisible="{Binding IsHotkeysTabActive}"><pages:LazyView.Template><DataTemplate x:DataType="vm:FkeyEditorViewModel">
            <Grid RowDefinitions="Auto,Auto,*">

                <!-- Save scope: unchecked = global [fkeys]; checked = this profile's section -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,6">
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding FkeysToProfileOnly, Mode=TwoWay}"
                              Color="#1f6feb"
                              VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="Save to profile only (otherwise these hotkeys are shared by all profiles)"
                           TextColor="#888888" FontSize="{core:ScaledFont 12}"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Modifier selector - pills on the left, Import on the right -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="6" Margin="0,0,0,10">
                    <Button Grid.Column="0"
                            Text="None"
                            Command="{Binding SetModifierCommand}"
                            CommandParameter="0"
                            BackgroundColor="#2d333b" TextColor="#cccccc"
                            FontSize="{core:ScaledFont 12}" WidthRequest="72" HeightRequest="30"
                            CornerRadius="4" Padding="0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveModifier}" Value="0">
                                <Setter Property="BackgroundColor" Value="#1f6feb"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1"
                            Text="Shift"
                            Command="{Binding SetModifierCommand}"
                            CommandParameter="1"
                            BackgroundColor="#2d333b" TextColor="#cccccc"
                            FontSize="{core:ScaledFont 12}" WidthRequest="72" HeightRequest="30"
                            CornerRadius="4" Padding="0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveModifier}" Value="1">
                                <Setter Property="BackgroundColor" Value="#1f6feb"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2"
                            Text="Ctrl"
                            Command="{Binding SetModifierCommand}"
                            CommandParameter="2"
                            BackgroundColor="#2d333b" TextColor="#cccccc"
                            FontSize="{core:ScaledFont 12}" WidthRequest="72" HeightRequest="30"
                            CornerRadius="4" Padding="0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveModifier}" Value="2">
                                <Setter Property="BackgroundColor" Value="#1f6feb"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <!-- Column 3 is the * spacer -->
                    <pages:LazyView Grid.Column="4" IsVisible="{x:Static pages:FkeyEditorPage.CanImport}">
                        <pages:LazyView.Template><DataTemplate x:DataType="vm:FkeyEditorViewModel">
                            <Button Text="Import"
                                    ToolTipProperties.Text="Import from clio.ini"
                                    Clicked="OnImportClicked"
                                    BackgroundColor="#2d333b" TextColor="#888888"
                                    FontSize="{core:ScaledFont 12}" WidthRequest="72" HeightRequest="30"
                                    CornerRadius="4" Padding="0"/>
                        </DataTemplate></pages:LazyView.Template>
                    </pages:LazyView>
                </Grid>

                <!-- F-key list -->
                <ScrollView Grid.Row="2">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentPageItems}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:FkeyEditorItem">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Grid.Column="0"
                                           Text="{Binding Label}"
                                           TextColor="#888888"
                                           FontSize="{core:ScaledFont 12}"
                                           VerticalOptions="Center"
                                           WidthRequest="36"/>
                                    <Entry Grid.Column="1"
                                           Text="{Binding Command, Mode=TwoWay}"
                                           TextColor="White"
                                           BackgroundColor="#161b22"
                                           Placeholder="Enter command"
                                           PlaceholderColor="#444444"
                                           ClearButtonVisibility="WhileEditing"
                                           Keyboard="Plain"
                                           IsSpellCheckEnabled="False"
                                           IsTextPredictionEnabled="False"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            </DataTemplate></pages:LazyView.Template></pages:LazyView>

            <!-- - NAVKEYS TAB - -->
            <pages:LazyView IsVisible="{Binding IsNavkeysTabActive}"><pages:LazyView.Template><DataTemplate x:DataType="vm:FkeyEditorViewModel">
            <ScrollView>
                <VerticalStackLayout Spacing="12" Padding="0,0,0,12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding NavKeysEnabled, Mode=TwoWay}"
                                  Color="#1f6feb"
                                  VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="Use these keys to move"
                               TextColor="#888888" FontSize="{core:ScaledFont 12}"
                               VerticalOptions="Center"/>
                    </Grid>

                    <VerticalStackLayout Spacing="4" IsEnabled="{Binding NavKeysEnabled}"
                                         BindableLayout.ItemsSource="{Binding NavKeyRows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavKeyEditorItem">
                                <Grid ColumnDefinitions="110,200" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="{Binding Label}"
                                           TextColor="#c9d1d9" FontSize="{core:ScaledFont 13}"
                                           VerticalOptions="Center"/>
                                    <Picker Grid.Column="1"
                                            ItemsSource="{x:Static vm:NavKeyEditorItem.KeyDisplays}"
                                            SelectedIndex="{Binding KeyIndex, Mode=TwoWay}"
                                            TextColor="White"
                                            BackgroundColor="#161b22"
                                            FontSize="{core:ScaledFont 13}"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Text="Reset to Default"
                            Command="{Binding ResetNavKeysCommand}"
                            BackgroundColor="#2d333b" TextColor="#cccccc"
                            FontSize="{core:ScaledFont 12}" HeightRequest="30"
                            CornerRadius="4" Padding="10,0" HorizontalOptions="Start"/>

                    <Label Text="Pick the key for each option. Scan sends a quick scan, at most once a second unless you have moved since the last one. Letters, digits, Enter, Backspace, Shift and Ctrl cannot be used, nor an F-key that has a macro; on Windows the number pad needs Num Lock on. While a pad key does something here, it no longer types its digit."
                           TextColor="#888888" FontSize="{core:ScaledFont 12}"/>
                </VerticalStackLayout>
            </ScrollView>

            </DataTemplate></pages:LazyView.Template></pages:LazyView>

            <!-- - SOUNDS TAB - -->
            <pages:LazyView IsVisible="{Binding IsSoundsTabActive}"><pages:LazyView.Template><DataTemplate x:DataType="vm:FkeyEditorViewModel">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">

                <!-- Master row: on/off checkbox, volume slider, reset -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding SoundsEnabled, Mode=TwoWay}"
                              Color="#1f6feb"
                              VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="All sounds" TextColor="White"
                           FontSize="{core:ScaledFont 13}" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label Grid.Column="2" Text="{Binding VolumeDisplay}" TextColor="White"
                           FontSize="{core:ScaledFont 13}" WidthRequest="28" HorizontalTextAlignment="End"
                           VerticalOptions="Center"/>
                    <Slider Grid.Column="3" Minimum="0" Maximum="100" WidthRequest="160"
                            Value="{Binding Volume, Mode=TwoWay}" VerticalOptions="Center"/>
                    <!-- Column 4 is the * spacer -->
                    <Button Grid.Column="5"
                            Text="Reset to Default"
                            Command="{Binding ResetSoundsCommand}"
                            BackgroundColor="#2d333b" TextColor="#cccccc"
                            FontSize="{core:ScaledFont 12}" HeightRequest="30"
                            CornerRadius="4" Padding="10,0"/>
                </Grid>

                <Label Grid.Row="1"
                       Text="Tap a heading to expand its group; &#x266A; previews a sound. A group's Default plays when the game triggers a sound in that group that has no sound file of its own."
                       TextColor="#888888" FontSize="{core:ScaledFont 12}"/>

                <!-- The tree: collapsible groups of individual sounds.
                     Right padding keeps the controls clear of the overlay scrollbar. -->
                <ScrollView Grid.Row="2">
                    <VerticalStackLayout Spacing="4" Padding="0,0,18,0"
                                         IsEnabled="{Binding SoundsEnabled}"
                                         BindableLayout.ItemsSource="{Binding SoundGroupsForView}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SoundGroupEditorItem">
                                <VerticalStackLayout Spacing="2">

                                    <!-- Group heading row -->
                                    <Grid ColumnDefinitions="20,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                                        <Label Grid.Column="0" Text="{Binding Chevron}"
                                               TextColor="#888888" FontSize="{core:ScaledFont 12}"
                                               VerticalOptions="Center" HorizontalTextAlignment="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleExpandCommand}"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  Color="#1f6feb"
                                                  VerticalOptions="Center"/>
                                        <Border Grid.Column="2"
                                                IsVisible="{Binding HasPreview}"
                                                BackgroundColor="#2d333b" StrokeThickness="0"
                                                Padding="9,3" VerticalOptions="Center"
                                                ToolTipProperties.Text="Preview">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding PlayCommand}"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="&#x266A;" TextColor="#1f6feb" FontSize="{core:ScaledFont 13}"/>
                                        </Border>
                                        <Label Grid.Column="3" Text="{Binding Name}"
                                               TextColor="White" FontSize="{core:ScaledFont 13}" FontAttributes="Bold"
                                               VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleExpandCommand}"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label Grid.Column="4" Text="{Binding VolumeDisplay}"
                                               TextColor="#888888" FontSize="{core:ScaledFont 11}" WidthRequest="26"
                                               HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                        <Slider Grid.Column="5" Minimum="0" Maximum="100" WidthRequest="110"
                                                ToolTipProperties.Text="Group volume - follows the master slider until moved; drag back onto the master value to re-attach"
                                                Value="{Binding Volume, Mode=TwoWay}"
                                                VerticalOptions="Center"/>
                                        <Picker Grid.Column="6"
                                                IsVisible="{Binding HasDefaultPicker}"
                                                Title="Default"
                                                ToolTipProperties.Text="Played when the game triggers a sound in this group that has no sound file of its own"
                                                ItemsSource="{Binding DefaultChoices}"
                                                SelectedIndex="{Binding SelectedDefaultIndex, Mode=TwoWay}"
                                                TextColor="White" TitleColor="#888888"
                                                BackgroundColor="#161b22"
                                                FontSize="{core:ScaledFont 12}" WidthRequest="200"/>
                                    </Grid>

                                    <!-- Child sounds, visible while expanded -->
                                    <VerticalStackLayout IsVisible="{Binding Expanded}"
                                                         Margin="46,0,0,4" Spacing="0"
                                                         BindableLayout.ItemsSource="{Binding VisibleSounds}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SoundEditorItem">
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6"
                                                      IsEnabled="{Binding Group.Enabled}">
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              Color="#1f6feb"
                                                              VerticalOptions="Center"/>
                                                    <Border Grid.Column="1"
                                                            BackgroundColor="#2d333b" StrokeThickness="0"
                                                            Padding="9,3" VerticalOptions="Center"
                                                            ToolTipProperties.Text="Preview">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding PlayCommand}"/>
                                                        </Border.GestureRecognizers>
                                                        <Label Text="&#x266A;" TextColor="#1f6feb" FontSize="{core:ScaledFont 13}"/>
                                                    </Border>
                                                    <Label Grid.Column="2" Text="{Binding Name}"
                                                           TextColor="#cccccc" FontSize="{core:ScaledFont 12}"
                                                           VerticalOptions="Center"/>
                                                    <Label Grid.Column="3" Text="{Binding VolumeDisplay}"
                                                           TextColor="#888888" FontSize="{core:ScaledFont 11}" WidthRequest="26"
                                                           HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                                    <Slider Grid.Column="4" Minimum="0" Maximum="100" WidthRequest="110"
                                                            ToolTipProperties.Text="Sound volume - follows the group slider until moved; drag back onto the group value to re-attach"
                                                            Value="{Binding Volume, Mode=TwoWay}"
                                                            VerticalOptions="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            

            </DataTemplate></pages:LazyView.Template></pages:LazyView>

            <!-- - DISPLAY TAB - -->
            <pages:LazyView IsVisible="{Binding IsDisplayTabActive}" Built="OnDisplayTabBuilt"><pages:LazyView.Template><DataTemplate x:DataType="vm:FkeyEditorViewModel">
            <ScrollView>
                <VerticalStackLayout Spacing="20" Padding="0,0,0,12">

                    <Label Text="These settings apply globally to all profiles."
                           TextColor="#555555" FontSize="{core:ScaledFont 11}" FontAttributes="Italic"/>

                    <!-- - General - -->
                    <Label Text="General" TextColor="#58a6ff" FontSize="{core:ScaledFont 13}" FontAttributes="Bold"/>

                    <!-- The Text Wizard (Pages/FontSetupPage), for the two sizes and the chat colours
                         together, with examples. -->
                    <pages:LazyView IsVisible="{OnPlatform Default=True, Android=False, iOS=False}" HorizontalOptions="Start">
                        <pages:LazyView.Template><DataTemplate x:DataType="vm:FkeyEditorViewModel">
                            <Button Text="Mucka Text Wizard" Clicked="OnFontSetupClicked"
                                    HorizontalOptions="Start"
                                    BackgroundColor="#2d333b" TextColor="#58a6ff"
                                    FontSize="{core:ScaledFont 13}" MinimumHeightRequest="30"
                                    CornerRadius="4" Padding="12,0"
                                    ToolTipProperties.Text="Choose the Mucka and game text sizes and the chat colours, with examples. Takes effect on Apply or Save."/>
                        </DataTemplate></pages:LazyView.Template>
                    </pages:LazyView>

                    <!-- The same two sliders as the Text Wizard, Tiny to Large. Beside its label the slider
                         is a fixed width; stacked it takes the width of the row. -->
                    <pages:FieldRow Stacked="{Binding StackedFields}">
                        <Label Text="Mucka Text Size" TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"
                               ToolTipProperties.Text="Buttons, menus, the status bar and who is online. Takes effect on Apply or Save."/>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center"
                              HorizontalOptions="{Binding SliderFieldAlignment}">
                            <Label Grid.Column="0" Text="Tiny" TextColor="#cccccc" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"/>
                            <Slider Grid.Column="1" Maximum="{Binding UiFontStepMaximum}" Minimum="{Binding UiFontStepMinimum}"
                                    Value="{Binding UiFontStepValue, Mode=TwoWay}"
                                    WidthRequest="{Binding SliderFieldWidth}" VerticalOptions="Center"
                                    MinimumTrackColor="#58a6ff" MaximumTrackColor="#2d333b" ThumbColor="White"
                                    SemanticProperties.Description="Mucka text size"/>
                            <Label Grid.Column="2" Text="Large" TextColor="#cccccc" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"/>
                            <Label Grid.Column="3" Text="{Binding UiFontStepName, StringFormat='Size: {0}'}" TextColor="White" FontSize="{core:ScaledFont 13}"
                                   MinimumWidthRequest="110" VerticalOptions="Center"/>
                        </Grid>
                    </pages:FieldRow>

                    <pages:FieldRow Stacked="{Binding StackedFields}">
                        <Label Text="Game Text Size" TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"
                               ToolTipProperties.Text="Everything the game says to you: rooms, chat and the rest."/>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center"
                              HorizontalOptions="{Binding SliderFieldAlignment}">
                            <Label Grid.Column="0" Text="Tiny" TextColor="#cccccc" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"/>
                            <Slider Grid.Column="1" Maximum="{Binding FontSizeMaximum}" Minimum="{Binding FontSizeMinimum}"
                                    Value="{Binding FontSizeValue, Mode=TwoWay}"
                                    WidthRequest="{Binding SliderFieldWidth}" VerticalOptions="Center"
                                    MinimumTrackColor="#58a6ff" MaximumTrackColor="#2d333b" ThumbColor="White"
                                    SemanticProperties.Description="Game text size"/>
                            <Label Grid.Column="2" Text="Large" TextColor="#cccccc" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"/>
                            <Label Grid.Column="3" Text="{Binding FontSizeName, StringFormat='Size: {0}'}" TextColor="White" FontSize="{core:ScaledFont 13}"
                                   MinimumWidthRequest="110" VerticalOptions="Center"/>
                        </Grid>
                    </pages:FieldRow>

                    <!-- Mac only: where saved passwords live -->
                    <pages:LazyView IsVisible="{Binding IsPasswordStoreAvailable}">
                        <pages:LazyView.Template><DataTemplate x:DataType="vm:FkeyEditorViewModel">
                            <pages:FieldRow Stacked="{Binding StackedFields}">
                                <Label Text="Store Passwords Securely" TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"
                                       ToolTipProperties.Text="On: saved passwords go in your macOS keychain. Off: they are kept as plain text in ~/.mucka/mucka.ini."/>
                                <Switch IsToggled="{Binding StorePasswordsSecurely, Mode=TwoWay}"
                                        HorizontalOptions="Start" VerticalOptions="Center"
                                        SemanticProperties.Description="Store passwords securely in the macOS keychain"/>
                            </pages:FieldRow>
                        </DataTemplate></pages:LazyView.Template>
                    </pages:LazyView>

                    <!-- Dreamword pill size offset -->
                    <pages:FieldRow Stacked="{Binding StackedFields}">
                        <Label Text="Dreamword Pill Size" TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"
                               ToolTipProperties.Text="Adjusts the dreamword chip font size relative to the base. Range: -2 to +4"/>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Button Text="&#x2212;" Command="{Binding DecrDisplayDreamwordOffsetCommand}"
                                    BackgroundColor="#2d333b" TextColor="#cccccc"
                                    FontSize="{core:ScaledFont 15}" WidthRequest="34" HeightRequest="30"
                                    CornerRadius="4" Padding="0"/>
                            <Label Text="{Binding DisplayDreamwordOffsetDisplay}" TextColor="White" FontSize="{core:ScaledFont 13}"
                                   WidthRequest="28" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Button Text="+" Command="{Binding IncrDisplayDreamwordOffsetCommand}"
                                    BackgroundColor="#2d333b" TextColor="#cccccc"
                                    FontSize="{core:ScaledFont 15}" WidthRequest="34" HeightRequest="30"
                                    CornerRadius="4" Padding="0"/>
                        </HorizontalStackLayout>
                    </pages:FieldRow>

                    <BoxView Color="#2d333b" HeightRequest="1"/>

                    <!-- - Chat colours - -->
                    <Label Text="Chat colours" TextColor="#58a6ff" FontSize="{core:ScaledFont 13}" FontAttributes="Bold"/>
                    <Label Text="For everyone's lines. Emotes is who did it, and acts and emotes; the others are the quoted words. A shout or a tell is its own colour from end to end. The ... button opens a row's sliders, its italic, bold and dim for your own messages and other people's, and its examples."
                           TextColor="#555555" FontSize="{core:ScaledFont 11}" FontAttributes="Italic"/>

                    <!-- The theme, then the four colours close together under it: label, hex, swatch, and the
                         button that opens the colour's own page (ChatColorPage). One Grid so the labels
                         share a column and the boxes line up. -->
                    <Grid ColumnDefinitions="2,Auto,Auto,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="8" RowSpacing="2">
                        <Label Grid.Row="0" Grid.Column="1" Text="Theme:" TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"/>
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" Spacing="12" Margin="0,0,0,4">
                            <Picker ItemsSource="{Binding ChatThemeNames}"
                                    SelectedIndex="{Binding SelectedChatThemeIndex, Mode=TwoWay}"
                                    SemanticProperties.Description="Chat colour theme"
                                    TextColor="White" TitleColor="#888888"
                                    BackgroundColor="#161b22"
                                    FontSize="{core:ScaledFont 13}" WidthRequest="160"/>
                            <Button Text="{Binding ChatResetText}"
                                    Command="{Binding ResetChatColorsCommand}"
                                    ToolTipProperties.Text="Reset colors to the theme defaults"
                                    SemanticProperties.Description="Reset colors to the theme defaults"
                                    BackgroundColor="#2d333b" TextColor="#cccccc"
                                    FontSize="{core:ScaledFont 14}" MinimumWidthRequest="34" HeightRequest="30"
                                    CornerRadius="4" Padding="8,0" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <BoxView Grid.Row="1" Grid.RowSpan="4" Grid.Column="0" Color="#2d333b"/>

                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding EmoteColor.Label, StringFormat='{0}:'}"
                               TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"/>
                        <Entry Grid.Row="1" Grid.Column="2" Text="{Binding EmoteColor.Hex, Mode=TwoWay}" MaxLength="7"
                               BackgroundColor="#161b22" TextColor="#cccccc" FontSize="{core:ScaledFont 13}"
                               WidthRequest="90" HeightRequest="38" MinimumHeightRequest="38"/>
                        <BoxView Grid.Row="1" Grid.Column="3" Color="{Binding EmoteColor.Preview}"
                                 WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                        <Button Grid.Row="1" Grid.Column="4" Text="{x:Static core:Glyph.More}" Clicked="OnColorMoreClicked"
                                CommandParameter="{Binding EmoteColor}"
                                SemanticProperties.Description="More: the Emotes colour's sliders, faces and examples"
                                BackgroundColor="#2d333b" TextColor="#cccccc" FontSize="{core:ScaledFont 16}"
                                WidthRequest="44" HeightRequest="38" MinimumHeightRequest="38" CornerRadius="4" Padding="0"
                                HorizontalOptions="Start"/>

                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding SayColor.Label, StringFormat='{0}:'}"
                               TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"/>
                        <Entry Grid.Row="2" Grid.Column="2" Text="{Binding SayColor.Hex, Mode=TwoWay}" MaxLength="7"
                               BackgroundColor="#161b22" TextColor="#cccccc" FontSize="{core:ScaledFont 13}"
                               WidthRequest="90" HeightRequest="38" MinimumHeightRequest="38"/>
                        <BoxView Grid.Row="2" Grid.Column="3" Color="{Binding SayColor.Preview}"
                                 WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                        <Button Grid.Row="2" Grid.Column="4" Text="{x:Static core:Glyph.More}" Clicked="OnColorMoreClicked"
                                CommandParameter="{Binding SayColor}"
                                SemanticProperties.Description="More: the Say colour's sliders, faces and examples"
                                BackgroundColor="#2d333b" TextColor="#cccccc" FontSize="{core:ScaledFont 16}"
                                WidthRequest="44" HeightRequest="38" MinimumHeightRequest="38" CornerRadius="4" Padding="0"
                                HorizontalOptions="Start"/>

                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding ShoutColor.Label, StringFormat='{0}:'}"
                               TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"/>
                        <Entry Grid.Row="3" Grid.Column="2" Text="{Binding ShoutColor.Hex, Mode=TwoWay}" MaxLength="7"
                               BackgroundColor="#161b22" TextColor="#cccccc" FontSize="{core:ScaledFont 13}"
                               WidthRequest="90" HeightRequest="38" MinimumHeightRequest="38"/>
                        <BoxView Grid.Row="3" Grid.Column="3" Color="{Binding ShoutColor.Preview}"
                                 WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                        <Button Grid.Row="3" Grid.Column="4" Text="{x:Static core:Glyph.More}" Clicked="OnColorMoreClicked"
                                CommandParameter="{Binding ShoutColor}"
                                SemanticProperties.Description="More: the Shout colour's sliders, faces and examples"
                                BackgroundColor="#2d333b" TextColor="#cccccc" FontSize="{core:ScaledFont 16}"
                                WidthRequest="44" HeightRequest="38" MinimumHeightRequest="38" CornerRadius="4" Padding="0"
                                HorizontalOptions="Start"/>

                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding TellColor.Label, StringFormat='{0}:'}"
                               TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"/>
                        <Entry Grid.Row="4" Grid.Column="2" Text="{Binding TellColor.Hex, Mode=TwoWay}" MaxLength="7"
                               BackgroundColor="#161b22" TextColor="#cccccc" FontSize="{core:ScaledFont 13}"
                               WidthRequest="90" HeightRequest="38" MinimumHeightRequest="38"/>
                        <BoxView Grid.Row="4" Grid.Column="3" Color="{Binding TellColor.Preview}"
                                 WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                        <Button Grid.Row="4" Grid.Column="4" Text="{x:Static core:Glyph.More}" Clicked="OnColorMoreClicked"
                                CommandParameter="{Binding TellColor}"
                                SemanticProperties.Description="More: the Tell colour's sliders, faces and examples"
                                BackgroundColor="#2d333b" TextColor="#cccccc" FontSize="{core:ScaledFont 16}"
                                WidthRequest="44" HeightRequest="38" MinimumHeightRequest="38" CornerRadius="4" Padding="0"
                                HorizontalOptions="Start"/>
                    </Grid>

                    <!-- Every example in one block, built a frame after the rows. -->
                    <Border IsVisible="{Binding ChatExamplesShown}" HorizontalOptions="Start"
                            BackgroundColor="{x:Static vm:FkeyEditorViewModel.PaneBackground}" StrokeThickness="0"
                            Padding="{x:Static pages:FkeyEditorPage.ChatExamplePadding}">
                        <VerticalStackLayout Spacing="2"
                                             BindableLayout.ItemsSource="{Binding ShownExamples}"
                                             BindableLayout.ItemTemplate="{StaticResource ChatExampleLineTemplate}"/>
                    </Border>


                    <BoxView Color="#2d333b" HeightRequest="1"/>

                    <!-- - Side Panel - -->
                    <Label Text="Side Panel" TextColor="#58a6ff" FontSize="{core:ScaledFont 13}" FontAttributes="Bold"/>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" IsChecked="{Binding ShowOnline, Mode=TwoWay}"
                                  Color="#1f6feb" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Show online"
                               TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"
                               ToolTipProperties.Text="Show the Online section (FEW). When disabled, the online list is not requested from the server."/>
                    </Grid>

                    <!-- Sub-settings for Show Online (indent 28dp to align with label) -->
                    <VerticalStackLayout Margin="28,0,0,0" Spacing="8" IsEnabled="{Binding ShowOnline}">

                        <pages:FieldRow Stacked="{Binding StackedFields}">
                            <Label Text="Max online" TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"
                                   ToolTipProperties.Text="Maximum number of players shown in the list. 0 = unlimited."/>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Button Text="&#x2212;" Command="{Binding DecrMaxOnlineCommand}"
                                        BackgroundColor="#2d333b" TextColor="#cccccc"
                                        FontSize="{core:ScaledFont 15}" WidthRequest="34" HeightRequest="30"
                                        CornerRadius="4" Padding="0"/>
                                <Label Text="{Binding MaxOnlineDisplayText}" TextColor="White" FontSize="{core:ScaledFont 13}"
                                       MinimumWidthRequest="60" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                <Button Text="+" Command="{Binding IncrMaxOnlineCommand}"
                                        BackgroundColor="#2d333b" TextColor="#cccccc"
                                        FontSize="{core:ScaledFont 15}" WidthRequest="34" HeightRequest="30"
                                        CornerRadius="4" Padding="0"/>
                            </HorizontalStackLayout>
                        </pages:FieldRow>

                        <!-- Forget window: minutes a departed player lingers in the Recent list -->
                        <pages:FieldRow Stacked="{Binding StackedFields}">
                            <Label Text="Offline window" TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"
                                   ToolTipProperties.Text="How long a player who drops off the Online list lingers in a quiet 'Recent' list below it before being forgotten. 0 = off (forget immediately). Max 10 min."/>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Button Text="&#x2212;" Command="{Binding DecrForgetWindowCommand}"
                                        BackgroundColor="#2d333b" TextColor="#cccccc"
                                        FontSize="{core:ScaledFont 15}" WidthRequest="34" HeightRequest="30"
                                        CornerRadius="4" Padding="0"/>
                                <Label Text="{Binding OnlineForgetWindowText}" TextColor="White" FontSize="{core:ScaledFont 13}"
                                       MinimumWidthRequest="60" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                <Button Text="+" Command="{Binding IncrForgetWindowCommand}"
                                        BackgroundColor="#2d333b" TextColor="#cccccc"
                                        FontSize="{core:ScaledFont 15}" WidthRequest="34" HeightRequest="30"
                                        CornerRadius="4" Padding="0"/>
                            </HorizontalStackLayout>
                        </pages:FieldRow>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding FloatOnline, Mode=TwoWay}"
                                      Color="#1f6feb" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Float"
                                   TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"
                                   ToolTipProperties.Text="Default the Online list to a floating panel instead of docked in the side panel. Changing this also moves the panel now if it still matches the saved default; if you've manually floated/docked it since, the live panel is left as-is."/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding OnlineNamesOnly, Mode=TwoWay}"
                                      Color="#1f6feb" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Names only"
                                   TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"
                                   ToolTipProperties.Text="Show only the persona name without the title or level description."/>
                        </Grid>

                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" IsChecked="{Binding ShowInventory, Mode=TwoWay}"
                                  Color="#1f6feb" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Inventory"
                               TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"
                               ToolTipProperties.Text="Show the Carrying section (FEI inventory half)."/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" IsChecked="{Binding ShowItemsHere, Mode=TwoWay}"
                                  Color="#1f6feb" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Items here"
                               TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"
                               ToolTipProperties.Text="Show the Here section (FEI room-items half). When both Inventory and Items here are disabled, FEI is not requested from the server."/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" IsChecked="{Binding ShowMapCompass, Mode=TwoWay}"
                                  Color="#1f6feb" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Map / Compass"
                               TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"
                               ToolTipProperties.Text="Show the Map/Compass section."/>
                    </Grid>

                    <!-- Sub-settings for Map/Compass (indent 28dp to align with label) -->
                    <VerticalStackLayout Margin="28,0,0,0" Spacing="8" IsEnabled="{Binding ShowMapCompass}">

                        <!-- Float -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding FloatCompass, Mode=TwoWay}"
                                      Color="#1f6feb" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Float"
                                   TextColor="#888888" FontSize="{core:ScaledFont 13}" VerticalOptions="Center"
                                   ToolTipProperties.Text="Default the compass to a floating panel instead of docked in the side panel. Changing this also moves the panel now if it still matches the saved default; if you've manually floated/docked it since, the live panel is left as-is."/>
                        </Grid>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            </DataTemplate></pages:LazyView.Template></pages:LazyView>

            <!-- - DATA TAB - -->
            <pages:LazyView IsVisible="{Binding IsDataTabActive}"><pages:LazyView.Template><DataTemplate x:DataType="vm:FkeyEditorViewModel">
            <ScrollView>
                <VerticalStackLayout Spacing="14" Padding="0,0,0,12">

                    <Label Text="Applies to all profiles, straight away."
                           TextColor="#555555" FontSize="{core:ScaledFont 11}" FontAttributes="Italic"/>

                    <Label Text="Local Data backups" TextColor="#58a6ff" FontSize="{core:ScaledFont 13}" FontAttributes="Bold"/>

                    <Label TextColor="#cccccc" FontSize="{core:ScaledFont 13}"
                           Text="Mucka keeps a history of your game sessions and sometimes has to reorganize it. When a change is risky, it can back up your history first. How eager should it be?"/>

                    <VerticalStackLayout Spacing="0">
                        <RadioButton GroupName="backups" Content="Startup" TextColor="White" FontSize="{core:ScaledFont 13}"
                                     IsChecked="{Binding BackupStartup, Mode=TwoWay}"/>
                        <Label Margin="32,0,0,10" TextColor="#888888" FontSize="{core:ScaledFont 12}"
                               Text="Back up before every risky change."/>

                        <RadioButton GroupName="backups" Content="Hourly" TextColor="White" FontSize="{core:ScaledFont 13}"
                                     IsChecked="{Binding BackupHourly, Mode=TwoWay}"/>
                        <Label Margin="32,0,0,10" TextColor="#888888" FontSize="{core:ScaledFont 12}"
                               Text="Skip it if the last backup is under an hour old."/>

                        <RadioButton GroupName="backups" Content="Daily" TextColor="White" FontSize="{core:ScaledFont 13}"
                                     IsChecked="{Binding BackupDaily, Mode=TwoWay}"/>
                        <Label Margin="32,0,0,10" TextColor="#888888" FontSize="{core:ScaledFont 12}"
                               Text="Skip it if the last backup is under a day old."/>

                        <RadioButton GroupName="backups" Content="Weekly" TextColor="White" FontSize="{core:ScaledFont 13}"
                                     IsChecked="{Binding BackupWeekly, Mode=TwoWay}"/>
                        <Label Margin="32,0,0,10" TextColor="#888888" FontSize="{core:ScaledFont 12}"
                               Text="Skip it if the last backup is under a week old."/>

                        <RadioButton GroupName="backups" Content="LEEEEEEROOOOY! (never)" TextColor="White" FontSize="{core:ScaledFont 13}"
                                     IsChecked="{Binding BackupNever, Mode=TwoWay}"/>
                        <Label Margin="32,0,0,10" TextColor="#888888" FontSize="{core:ScaledFont 12}"
                               Text="No backups. You just want to play MUD."/>
                    </VerticalStackLayout>

                    <Label TextColor="#555555" FontSize="{core:ScaledFont 11}" FontAttributes="Italic"
                           Text="Backups only happen before a risky change, never on a timer."/>

                </VerticalStackLayout>
            </ScrollView>
            </DataTemplate></pages:LazyView.Template></pages:LazyView>

        </Grid>

        <!-- - Action bar - -->
        <Border Grid.Row="2"
                BackgroundColor="#161b22"
                StrokeThickness="0"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">

                <!-- Spacer: Grid.Column="0" -->

                <Button Grid.Column="1"
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="#2d333b" TextColor="#cccccc"
                        FontSize="{core:ScaledFont 13}" WidthRequest="80" HeightRequest="34"
                        CornerRadius="4" Padding="0"/>

                <Button Grid.Column="2"
                        Text="Apply"
                        Command="{Binding ApplyCommand}"
                        BackgroundColor="#2d333b" TextColor="#cccccc"
                        FontSize="{core:ScaledFont 13}" WidthRequest="80" HeightRequest="34"
                        CornerRadius="4" Padding="0"/>

                <Button Grid.Column="3"
                        Text="Save"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"
                        BackgroundColor="#1f6feb" TextColor="White"
                        FontSize="{core:ScaledFont 13}" WidthRequest="80" HeightRequest="34"
                        CornerRadius="4" Padding="0"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
