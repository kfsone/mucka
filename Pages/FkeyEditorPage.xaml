<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mucka.ViewModels"
             x:Class="Mucka.Pages.FkeyEditorPage"
             x:DataType="vm:FkeyEditorViewModel"
             Title="Config"
             BackgroundColor="#0C0C0C">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Tab bar ──────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                BackgroundColor="#161b22"
                StrokeThickness="0"
                Padding="12,6">
            <HorizontalStackLayout Spacing="4">

                <!-- Settings tab -->
                <Border Stroke="Transparent" StrokeThickness="0" Padding="14,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTabCommand}" CommandParameter="0"/>
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSettingsTabActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1f6feb"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSettingsTabActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="#2d333b"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Settings" FontSize="13" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSettingsTabActive}" Value="True">
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSettingsTabActive}" Value="False">
                                <Setter Property="TextColor" Value="#888888"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <!-- Hotkeys tab -->
                <Border Stroke="Transparent" StrokeThickness="0" Padding="14,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTabCommand}" CommandParameter="1"/>
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsHotkeysTabActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1f6feb"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsHotkeysTabActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="#2d333b"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Hotkeys" FontSize="13" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsHotkeysTabActive}" Value="True">
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsHotkeysTabActive}" Value="False">
                                <Setter Property="TextColor" Value="#888888"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <!-- Friends tab -->
                <Border Stroke="Transparent" StrokeThickness="0" Padding="14,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTabCommand}" CommandParameter="2"/>
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsFriendsTabActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1f6feb"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsFriendsTabActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="#2d333b"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Friends" FontSize="13" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsFriendsTabActive}" Value="True">
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsFriendsTabActive}" Value="False">
                                <Setter Property="TextColor" Value="#888888"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

            </HorizontalStackLayout>
        </Border>

        <!-- ── Content ──────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Padding="12,10,12,0">

            <!-- ── SETTINGS TAB ──────────────────────────────────────── -->
            <ScrollView IsVisible="{Binding IsSettingsTabActive}">
                <VerticalStackLayout Spacing="20" Padding="0,0,0,12">

                    <!-- Save scope: unchecked = global [settings]; checked = this profile's section -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding SettingsToProfileOnly, Mode=TwoWay}"
                                  Color="#1f6feb"
                                  VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="Save to profile only (otherwise these settings are shared by all profiles)"
                               TextColor="#888888" FontSize="12"
                               VerticalOptions="Center"/>
                    </Grid>

                    <!-- Font Size -->
                    <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Font Size" TextColor="#888888" FontSize="13" VerticalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                            <Label Text="{Binding FontSizeDisplay}" TextColor="White" FontSize="13"
                                   WidthRequest="28" VerticalOptions="Center"/>
                            <Stepper Minimum="9" Maximum="24" Increment="1"
                                     Value="{Binding FontSize, Mode=TwoWay}"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Columns -->
                    <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Columns" TextColor="#888888" FontSize="13" VerticalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                            <Label Text="{Binding ColumnsDisplay}" TextColor="White" FontSize="13"
                                   WidthRequest="28" VerticalOptions="Center"/>
                            <Stepper Minimum="40" Maximum="160" Increment="1"
                                     Value="{Binding Columns, Mode=TwoWay}"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Volume -->
                    <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Volume" TextColor="#888888" FontSize="13" VerticalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                            <Label Text="{Binding VolumeDisplay}" TextColor="White" FontSize="13"
                                   WidthRequest="28" VerticalOptions="Center"/>
                            <Slider Minimum="0" Maximum="100" WidthRequest="160"
                                    Value="{Binding Volume, Mode=TwoWay}"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Stat Update (FES) frequency -->
                    <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Stat Update (FES)" TextColor="#888888" FontSize="13" VerticalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                            <Label Text="{Binding StatUpdateFrequencyDisplay}" TextColor="White" FontSize="13"
                                   WidthRequest="28" VerticalOptions="Center"/>
                            <Stepper Minimum="0" Maximum="30" Increment="5"
                                     Value="{Binding StatUpdateFrequency, Mode=TwoWay}"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Beep mute -->
                    <VerticalStackLayout Spacing="6">

                        <!-- Session mute: not persisted -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding MuteBeepSession, Mode=TwoWay}"
                                      Color="#1f6feb"
                                      VerticalOptions="Start"/>
                            <Label Grid.Column="1"
                                   Text="Hey, that gong-like 'beep' sound was funny at first but it gets annoying, how about you just not?"
                                   TextColor="#888888" FontSize="12"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- Permanent mute: persisted; only shown when session mute is on -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                              Margin="28,0,0,0"
                              IsVisible="{Binding MuteBeepSession}">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding MuteBeepPermanently, Mode=TwoWay}"
                                      Color="#1f6feb"
                                      VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="Like, ever?"
                                   TextColor="#888888" FontSize="12"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- "Hear it" link: always visible -->
                        <Label Margin="28,0,0,0" FontSize="12">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Wait, what beep-gong sound? I want to " TextColor="#888888"/>
                                    <Span Text="hear" TextColor="#1f6feb" TextDecorations="Underline">
                                        <Span.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding PlayBeepCommand}"/>
                                        </Span.GestureRecognizers>
                                    </Span>
                                    <Span Text=" it!" TextColor="#888888"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ── HOTKEYS TAB ───────────────────────────────────────── -->
            <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsHotkeysTabActive}">

                <!-- Save scope: unchecked = global [fkeys]; checked = this profile's section -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,6">
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding FkeysToProfileOnly, Mode=TwoWay}"
                              Color="#1f6feb"
                              VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="Save to profile only (otherwise these hotkeys are shared by all profiles)"
                           TextColor="#888888" FontSize="12"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Modifier selector — pills on the left, Import on the right -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="6" Margin="0,0,0,10">
                    <Button Grid.Column="0"
                            Text="None"
                            Command="{Binding SetModifierCommand}"
                            CommandParameter="0"
                            BackgroundColor="#2d333b" TextColor="#cccccc"
                            FontSize="12" WidthRequest="72" HeightRequest="30"
                            CornerRadius="4" Padding="0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveModifier}" Value="0">
                                <Setter Property="BackgroundColor" Value="#1f6feb"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1"
                            Text="Shift"
                            Command="{Binding SetModifierCommand}"
                            CommandParameter="1"
                            BackgroundColor="#2d333b" TextColor="#cccccc"
                            FontSize="12" WidthRequest="72" HeightRequest="30"
                            CornerRadius="4" Padding="0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveModifier}" Value="1">
                                <Setter Property="BackgroundColor" Value="#1f6feb"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2"
                            Text="Ctrl"
                            Command="{Binding SetModifierCommand}"
                            CommandParameter="2"
                            BackgroundColor="#2d333b" TextColor="#cccccc"
                            FontSize="12" WidthRequest="72" HeightRequest="30"
                            CornerRadius="4" Padding="0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveModifier}" Value="2">
                                <Setter Property="BackgroundColor" Value="#1f6feb"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <!-- Column 3 is the * spacer -->
                    <Button Grid.Column="4"
                            x:Name="ImportButton"
                            Text="Import"
                            ToolTipProperties.Text="Import from clio.ini"
                            IsVisible="False"
                            BackgroundColor="#2d333b" TextColor="#888888"
                            FontSize="12" WidthRequest="72" HeightRequest="30"
                            CornerRadius="4" Padding="0"/>
                </Grid>

                <!-- F-key list -->
                <ScrollView Grid.Row="2">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentPageItems}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:FkeyEditorItem">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Grid.Column="0"
                                           Text="{Binding Label}"
                                           TextColor="#888888"
                                           FontSize="12"
                                           VerticalOptions="Center"
                                           WidthRequest="36"/>
                                    <Entry Grid.Column="1"
                                           Text="{Binding Command, Mode=TwoWay}"
                                           TextColor="White"
                                           BackgroundColor="#161b22"
                                           Placeholder="Enter command"
                                           PlaceholderColor="#444444"
                                           ClearButtonVisibility="WhileEditing"
                                           Keyboard="Plain"
                                           IsSpellCheckEnabled="False"
                                           IsTextPredictionEnabled="False"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <!-- ── FRIENDS TAB ───────────────────────────────────────── -->
            <Label Text="Soon!"
                   IsVisible="{Binding IsFriendsTabActive}"
                   TextColor="#555555"
                   FontSize="24"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>

        </Grid>

        <!-- ── Action bar ────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                BackgroundColor="#161b22"
                StrokeThickness="0"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">

                <!-- Spacer: Grid.Column="0" -->

                <Button Grid.Column="1"
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="#2d333b" TextColor="#cccccc"
                        FontSize="13" WidthRequest="80" HeightRequest="34"
                        CornerRadius="4" Padding="0"/>

                <Button Grid.Column="2"
                        Text="Apply"
                        Command="{Binding ApplyCommand}"
                        BackgroundColor="#2d333b" TextColor="#cccccc"
                        FontSize="13" WidthRequest="80" HeightRequest="34"
                        CornerRadius="4" Padding="0"/>

                <Button Grid.Column="3"
                        Text="Save"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"
                        BackgroundColor="#1f6feb" TextColor="White"
                        FontSize="13" WidthRequest="80" HeightRequest="34"
                        CornerRadius="4" Padding="0"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
