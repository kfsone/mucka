<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mucka.ViewModels"
             x:Class="Mucka.Pages.FkeyEditorPage"
             x:DataType="vm:FkeyEditorViewModel"
             Title="Function Keys"
             BackgroundColor="#0C0C0C">
    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button Grid.Column="0"
                    Text="None"
                    Command="{Binding SetModifierCommand}"
                    CommandParameter="0"
                    BackgroundColor="#2d333b"
                    TextColor="#cccccc"
                    CornerRadius="4"
                    HeightRequest="40">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ActiveModifier}" Value="0">
                        <Setter Property="BackgroundColor" Value="#1f6feb" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1"
                    Text="Shift"
                    Command="{Binding SetModifierCommand}"
                    CommandParameter="1"
                    BackgroundColor="#2d333b"
                    TextColor="#cccccc"
                    CornerRadius="4"
                    HeightRequest="40">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ActiveModifier}" Value="1">
                        <Setter Property="BackgroundColor" Value="#1f6feb" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="2"
                    Text="Ctrl"
                    Command="{Binding SetModifierCommand}"
                    CommandParameter="2"
                    BackgroundColor="#2d333b"
                    TextColor="#cccccc"
                    CornerRadius="4"
                    HeightRequest="40">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ActiveModifier}" Value="2">
                        <Setter Property="BackgroundColor" Value="#1f6feb" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentPageItems}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:FkeyEditorItem">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Text="{Binding Label}"
                                   TextColor="#cccccc"
                                   VerticalOptions="Center"
                                   WidthRequest="40" />
                            <Entry Grid.Column="1"
                                   Text="{Binding Command, Mode=TwoWay}"
                                   TextColor="White"
                                   BackgroundColor="#161b22"
                                   Placeholder="Enter command"
                                   PlaceholderColor="#666666"
                                   ClearButtonVisibility="WhileEditing"
                                   Keyboard="Plain"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Import button: shown on Windows only; wired in code-behind via #if WINDOWS -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
            <Button Grid.Column="0"
                    x:Name="ImportButton"
                    Text="Import"
                    ToolTipProperties.Text="Import from clio.ini"
                    IsVisible="False"
                    BackgroundColor="#2d333b"
                    TextColor="#cccccc"
                    CornerRadius="4"
                    HeightRequest="44" />
            <Button Grid.Column="1"
                    Text="Save"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanSave}"
                    BackgroundColor="#1f6feb"
                    TextColor="White"
                    CornerRadius="4"
                    HeightRequest="44" />
            <Button Grid.Column="2"
                    Text="Apply"
                    Command="{Binding ApplyCommand}"
                    BackgroundColor="#2d333b"
                    TextColor="#cccccc"
                    CornerRadius="4"
                    HeightRequest="44" />
            <Button Grid.Column="3"
                    Text="Cancel"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="#2d333b"
                    TextColor="#cccccc"
                    CornerRadius="4"
                    HeightRequest="44" />
        </Grid>
    </Grid>
</ContentPage>
