<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mucka.ViewModels"
             xmlns:render="clr-namespace:Mucka.Rendering"
             x:Class="Mucka.Pages.GamePage"
             x:DataType="vm:GameViewModel"
             Title="mucka"
             BackgroundColor="#0C0C0C"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <Style x:Key="StatLabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="{OnPlatform WinUI=14, Default=13}"/>
            <Setter Property="VerticalOptions" Value="Center"/>
            <Setter Property="FontFamily" Value="{OnPlatform Android='monospace', WinUI='Cascadia Mono', MacCatalyst='Menlo-Regular'}"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

        <!-- ── Status bar ───────────────────────────────────────────── -->
        <Border Grid.Row="0"
                x:Name="StatusBar"
                BackgroundColor="#161b22"
                Padding="6,4" StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Top-left icons: about dialog + settings -->
                <HorizontalStackLayout Grid.Column="0" Spacing="2" Margin="0,0,6,0">
                    <Border VerticalOptions="Center"
                            BackgroundColor="Transparent"
                            Stroke="Transparent" StrokeThickness="0"
                            Padding="2,0"
                            SemanticProperties.Description="About mucka">
                        <ToolTipProperties.Text>About mucka</ToolTipProperties.Text>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SidePanel.ShowAboutCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="&#x24D8;"
                               TextColor="#888888" FontSize="12" VerticalOptions="Center"/>
                    </Border>
                    <Border VerticalOptions="Center"
                            BackgroundColor="Transparent"
                            Stroke="Transparent" StrokeThickness="0"
                            Padding="2,0"
                            SemanticProperties.Description="Settings">
                        <ToolTipProperties.Text>Settings</ToolTipProperties.Text>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ConfigCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="&#x2699;&#xFE0E;"
                               TextColor="#888888" FontSize="12" VerticalOptions="Center"/>
                    </Border>
                </HorizontalStackLayout>

                <!-- Normal stats bar: visible when effcols >= 76 -->
                <Grid Grid.Column="1"
                      ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto"
                      IsVisible="{Binding IsNotCompactStats}">

                    <!-- Left: stats -->
                    <Label Grid.Column="0" Style="{StaticResource StatLabelStyle}" Margin="0,0,8,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Sta: " TextColor="#58a6ff"/>
                                <Span Text="{Binding StaValue}" TextColor="{Binding StaColor}" FontAttributes="Bold"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="1" Style="{StaticResource StatLabelStyle}" Margin="0,0,8,0"
                           IsVisible="{Binding MagVisible}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Mag: " TextColor="#58a6ff"/>
                                <Span Text="{Binding MagValue}" TextColor="{Binding MagColor}" FontAttributes="Bold"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="2" Style="{StaticResource StatLabelStyle}" Margin="0,0,8,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Str: " TextColor="#58a6ff"/>
                                <Span Text="{Binding StrValue}" TextColor="{Binding StrColor}" FontAttributes="Bold"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="3" Style="{StaticResource StatLabelStyle}" Margin="0,0,8,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Dex: " TextColor="#58a6ff"/>
                                <Span Text="{Binding DexValue}" TextColor="{Binding DexColor}" FontAttributes="Bold"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Column="4" Text="|"
                           Style="{StaticResource StatLabelStyle}" TextColor="#444444" Margin="0,0,8,0"/>

                    <Label Grid.Column="5" Style="{StaticResource StatLabelStyle}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Score: " TextColor="#58a6ff"/>
                                <Span Text="{Binding ScoreValue}" TextColor="{Binding ScoreColor}" FontAttributes="Bold"/>
                                <Span Text="{Binding ScoreDeltaValue}" TextColor="{Binding ScoreColor}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!-- Spacer -->
                    <BoxView Grid.Column="6" Color="Transparent"/>

                    <!-- Rec capture indicator — Border+tap avoids WinUI's minimum button height.
                         Hollow chip when idle; red dot + lit text while capturing. -->
                    <Border Grid.Column="7"
                            IsVisible="{Binding IsRecordingButtonVisible}"
                            BackgroundColor="Transparent"
                            Stroke="#2d333b" StrokeThickness="1"
                            Padding="5,1" Margin="0,0,4,0"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Toggle capture"
                            SemanticProperties.Hint="Starts or stops capture">
                        <ToolTipProperties.Text>Toggle capture</ToolTipProperties.Text>
                        <Border.StrokeShape><RoundRectangle CornerRadius="3"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleCaptureCommand}"/>
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsCapturing}" Value="True">
                                <Setter Property="Stroke" Value="#c02020"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="3">
                            <Label Text="&#x25CF;" FontSize="9" TextColor="#E74856"
                                   IsVisible="{Binding IsCapturing}"
                                   VerticalOptions="Center"/>
                            <Label Text="rec" FontSize="10" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsCapturing}" Value="True">
                                        <Setter Property="TextColor" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsCapturing}" Value="False">
                                        <Setter Property="TextColor" Value="#666666"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Dreamword chip — tap to speak; Ctrl+D from keyboard.
                         Muted (dim white on dark blue) while showing the ..zzZZZzz.. placeholder;
                         bright + bold when a dreamword is held. -->
                    <Border Grid.Column="8"
                            BackgroundColor="#1f6feb"
                            Stroke="Transparent" StrokeThickness="0"
                            Padding="6,1" VerticalOptions="Center">
                        <ToolTipProperties.Text>Speak dreamword (Ctrl+D)</ToolTipProperties.Text>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SpeakDreamwordCommand}"/>
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding DreamwordIsPlaceholder}" Value="True">
                                <Setter Property="BackgroundColor" Value="#14304f"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding DreamwordDisplay}"
                               TextColor="White" FontAttributes="Bold"
                               FontSize="12" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding DreamwordIsPlaceholder}" Value="True">
                                    <Setter Property="TextColor" Value="#cccccc"/>
                                    <Setter Property="FontAttributes" Value="None"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <!-- Separator before weather/TTR group -->
                    <Label Grid.Column="9" Text="|"
                           Style="{StaticResource StatLabelStyle}" TextColor="#444444"
                           IsVisible="{Binding AnyRightStatVisible}"
                           Margin="6,0"/>

                    <!-- Weather: glyph + text (or glyph-only when effcols < 80) -->
                    <Label Grid.Column="10" Text="{Binding WeatherDisplayText}"
                           TextColor="{Binding WeatherColor}"
                           Style="{StaticResource StatLabelStyle}"
                           IsVisible="{Binding WeatherVisible}"
                           ToolTipProperties.Text="{Binding WeatherTooltip}"
                           Margin="0,0,6,0"/>

                    <!-- Separator before TTR -->
                    <Label Grid.Column="11" Text="|"
                           Style="{StaticResource StatLabelStyle}" TextColor="#444444"
                           IsVisible="{Binding TtrVisible}"
                           Margin="0,0,6,0"/>

                    <!-- Time until the next game reset -->
                    <Label Grid.Column="12" Text="{Binding TtrText}"
                           Style="{StaticResource StatLabelStyle}"
                           IsVisible="{Binding TtrVisible}"
                           ToolTipProperties.Text="Time until reset"/>

                </Grid>

                <!-- Compact stats bar: two rows when effcols < 76 -->
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto"
                      ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto"
                      IsVisible="{Binding IsCompactStats}">

                    <!-- ── Labels row (2pt smaller font) ── -->
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Sta" TextColor="#58a6ff" FontSize="11"
                           VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,4,0"/>
                    <Label Grid.Row="0" Grid.Column="1"
                           Text="Mag" TextColor="#58a6ff" FontSize="11"
                           IsVisible="{Binding MagVisible}"
                           VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,4,0"/>
                    <Label Grid.Row="0" Grid.Column="2"
                           Text="Str" TextColor="#58a6ff" FontSize="11"
                           VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,4,0"/>
                    <Label Grid.Row="0" Grid.Column="3"
                           Text="Dex" TextColor="#58a6ff" FontSize="11"
                           VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,4,0"/>
                    <!-- col 4: | separator — label row spacer -->
                    <Label Grid.Row="0" Grid.Column="5"
                           Text="Score" TextColor="#58a6ff" FontSize="11"
                           VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,4,0"/>
                    <!-- col 6: * spacer -->
                    <Label Grid.Row="0" Grid.Column="7"
                           Text="Dream" TextColor="#58a6ff" FontSize="11"
                           VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,4,0"/>
                    <Label Grid.Row="0" Grid.Column="9"
                           Text="Weath" TextColor="#58a6ff" FontSize="11"
                           IsVisible="{Binding WeatherVisible}"
                           VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,4,0"/>
                    <Label Grid.Row="0" Grid.Column="11"
                           Text="Rst" TextColor="#58a6ff" FontSize="11"
                           IsVisible="{Binding TtrVisible}"
                           VerticalOptions="End" HorizontalOptions="Center"/>

                    <!-- ── Values row ── -->
                    <Label Grid.Row="1" Grid.Column="0"
                           Text="{Binding StaValue}" TextColor="{Binding StaColor}"
                           Style="{StaticResource StatLabelStyle}"
                           FontSize="{Binding StatsValueFontSize}" FontAttributes="Bold"
                           HorizontalOptions="Center" Margin="0,0,4,0"/>
                    <Label Grid.Row="1" Grid.Column="1"
                           Text="{Binding MagValue}" TextColor="{Binding MagColor}"
                           Style="{StaticResource StatLabelStyle}"
                           FontSize="{Binding StatsValueFontSize}" FontAttributes="Bold"
                           IsVisible="{Binding MagVisible}"
                           HorizontalOptions="Center" Margin="0,0,4,0"/>
                    <Label Grid.Row="1" Grid.Column="2"
                           Text="{Binding StrValue}" TextColor="{Binding StrColor}"
                           Style="{StaticResource StatLabelStyle}"
                           FontSize="{Binding StatsValueFontSize}" FontAttributes="Bold"
                           HorizontalOptions="Center" Margin="0,0,4,0"/>
                    <Label Grid.Row="1" Grid.Column="3"
                           Text="{Binding DexValue}" TextColor="{Binding DexColor}"
                           Style="{StaticResource StatLabelStyle}"
                           FontSize="{Binding StatsValueFontSize}" FontAttributes="Bold"
                           HorizontalOptions="Center" Margin="0,0,4,0"/>

                    <Label Grid.Row="1" Grid.Column="4" Text="|"
                           Style="{StaticResource StatLabelStyle}" TextColor="#444444"
                           Margin="0,0,4,0"/>

                    <Label Grid.Row="1" Grid.Column="5"
                           Text="{Binding ScoreDisplayValue}" TextColor="{Binding ScoreColor}"
                           Style="{StaticResource StatLabelStyle}"
                           FontSize="{Binding StatsValueFontSize}" FontAttributes="Bold"
                           MaxLines="1" LineBreakMode="TailTruncation"
                           HorizontalOptions="Center" Margin="0,0,4,0"/>

                    <!-- * spacer col 6 -->
                    <BoxView Grid.Row="1" Grid.Column="6" Color="Transparent"/>

                    <!-- Dreamword: tappable label — dimmed while showing the placeholder -->
                    <Label Grid.Row="1" Grid.Column="7"
                           Text="{Binding DreamwordDisplay}"
                           TextColor="#7db9f5" FontAttributes="Bold"
                           Style="{StaticResource StatLabelStyle}"
                           MaxLines="1" LineBreakMode="TailTruncation"
                           HorizontalOptions="Center" Margin="0,0,4,0">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding DreamwordIsPlaceholder}" Value="True">
                                <Setter Property="TextColor" Value="#5a7a9c"/>
                                <Setter Property="FontAttributes" Value="None"/>
                            </DataTrigger>
                        </Label.Triggers>
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SpeakDreamwordCommand}"/>
                        </Label.GestureRecognizers>
                        <ToolTipProperties.Text>Speak dreamword (Ctrl+D)</ToolTipProperties.Text>
                    </Label>

                    <Label Grid.Row="1" Grid.Column="8" Text="|"
                           Style="{StaticResource StatLabelStyle}" TextColor="#444444"
                           IsVisible="{Binding AnyRightStatVisible}"
                           Margin="0,0,4,0"/>

                    <Label Grid.Row="1" Grid.Column="9"
                           Text="{Binding WeatherGlyph}" TextColor="{Binding WeatherColor}"
                           Style="{StaticResource StatLabelStyle}"
                           IsVisible="{Binding WeatherVisible}"
                           ToolTipProperties.Text="{Binding WeatherTooltip}"
                           HorizontalOptions="Center" Margin="0,0,4,0"/>

                    <Label Grid.Row="1" Grid.Column="10" Text="|"
                           Style="{StaticResource StatLabelStyle}" TextColor="#444444"
                           IsVisible="{Binding TtrVisible}"
                           Margin="0,0,4,0"/>

                    <Label Grid.Row="1" Grid.Column="11"
                           Text="{Binding TtrText}"
                           Style="{StaticResource StatLabelStyle}"
                           IsVisible="{Binding TtrVisible}"
                           ToolTipProperties.Text="Time until reset"
                           HorizontalOptions="Center"/>

                </Grid>

                <!-- Panel toggle button -->
                <Border Grid.Column="2"
                        VerticalOptions="Center"
                        BackgroundColor="Transparent"
                        Stroke="Transparent" StrokeThickness="0"
                        Padding="6,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SidePanel.TogglePanelCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="{Binding SidePanel.PanelToggleGlyph}"
                           TextColor="#888888" FontSize="11" VerticalOptions="Center"
                           FontFamily="{OnPlatform Android='monospace', WinUI='Cascadia Mono', MacCatalyst='Menlo-Regular'}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ── White separator ──────────────────────────────────────── -->
        <BoxView Grid.Row="1" Color="White" HeightRequest="1" HorizontalOptions="Fill"/>

        <!-- ── Scrollback + side panel ────────────────────────────────── -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <render:TerminalView Grid.Column="0"
                                 x:Name="Terminal"
                                 BackgroundColor="#0C0C0C"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Fill"/>

            <!-- Transient confirmation toast (copies, settings saves), overlaid top-right of the terminal view. -->
            <Border Grid.Column="0"
                    x:Name="CopiedToast"
                    IsVisible="False"
                    BackgroundColor="#161b22"
                    Stroke="#3B78FF" StrokeThickness="1"
                    Padding="8,4"
                    HorizontalOptions="End" VerticalOptions="Start"
                    Margin="0,8,12,0"
                    InputTransparent="True">
                <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                <Label x:Name="ToastLabel"
                       Text="* Copied to clipboard"
                       TextColor="#3B78FF" FontSize="12"
                       FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
            </Border>

            <!-- ── Side panel — to the right of the scrollback ─────────── -->
            <Border Grid.Column="1"
                    x:Name="SidePanelBorder"
                    IsVisible="{Binding SidePanel.IsPanelExpanded}"
                    WidthRequest="260"
                    BackgroundColor="#161b22"
                    Stroke="#2d333b" StrokeThickness="1"
                    Padding="0">
                <!-- ── Panel content: scrollable info + bottom-pinned online list ── -->
                <Grid RowDefinitions="*,Auto">

                            <!-- Top: scrollable character / room / item info -->
                            <ScrollView Grid.Row="0" Padding="8,6,8,4">
                                <VerticalStackLayout Spacing="4">

                                    <!-- Character name -->
                                    <Label Text="{Binding SidePanel.CharacterName}"
                                           IsVisible="{Binding SidePanel.HasCharacterName}"
                                           TextColor="#e3b341" FontSize="13" FontAttributes="Bold"
                                           FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>

                                    <!-- Room breadcrumb: oldest → previous → current, top to bottom.
                                         A hairline separates the trail from the (larger) current room. -->
                                    <VerticalStackLayout Spacing="1" Margin="0,4,0,0">
                                        <Label Text="{Binding SidePanel.OldestRoom}"
                                               TextColor="#00a000" FontSize="10" FontAttributes="Bold"
                                               FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                        <Label Text="{Binding SidePanel.PreviousRoom}"
                                               TextColor="#00c000" FontSize="11" FontAttributes="Bold"
                                               FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                        <BoxView Color="#2d333b" HeightRequest="1" Margin="0,2"
                                                 IsVisible="{Binding SidePanel.HasCurrentRoom}"/>
                                        <Label Text="{Binding SidePanel.CurrentRoom}"
                                               IsVisible="{Binding SidePanel.HasCurrentRoom}"
                                               TextColor="#00ff00" FontSize="13" FontAttributes="Bold"
                                               FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                        <Label Text="—" IsVisible="{Binding SidePanel.NoCurrentRoom}"
                                               TextColor="#555555" FontSize="11" FontAttributes="Italic"/>
                                    </VerticalStackLayout>

                                    <!-- Exits grid (FEX) ─────────────────────────────────── -->
                                    <!--
                                         nw  n   ne   <(in)   ↑(up)
                                         w   .    e           ≈(swampward)
                                         sw  s   se   >(out)  ↓(down)
                                    -->
                                    <Grid Margin="0,6,0,0" HorizontalOptions="Start"
                                          ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="4"
                                          RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                                        <!-- Row 0: nw, n, ne, <(in), ↑ -->
                                        <Label Grid.Row="0" Grid.Column="0" Text="nw"
                                               TextColor="{Binding SidePanel.ExitNorthWest.Color}"
                                               FontAttributes="{Binding SidePanel.ExitNorthWest.FontAttributes}"
                                               FontSize="11" FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Grid.Row="0" Grid.Column="1" Text="n"
                                               TextColor="{Binding SidePanel.ExitNorth.Color}"
                                               FontAttributes="{Binding SidePanel.ExitNorth.FontAttributes}"
                                               FontSize="11" FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Grid.Row="0" Grid.Column="2" Text="ne"
                                               TextColor="{Binding SidePanel.ExitNorthEast.Color}"
                                               FontAttributes="{Binding SidePanel.ExitNorthEast.FontAttributes}"
                                               FontSize="11" FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Grid.Row="0" Grid.Column="3" Text="⇥"
                                               TextColor="{Binding SidePanel.ExitIn.Color}"
                                               FontAttributes="{Binding SidePanel.ExitIn.FontAttributes}"
                                               FontSize="11" FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Grid.Row="0" Grid.Column="4" Text="↑"
                                               TextColor="{Binding SidePanel.ExitUp.Color}"
                                               FontAttributes="{Binding SidePanel.ExitUp.FontAttributes}"
                                               FontSize="11" FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"
                                               HorizontalTextAlignment="Center"/>
                                        <!-- Row 1: w,  , e, ≈(swampward) -->
                                        <Label Grid.Row="1" Grid.Column="0" Text="w"
                                               TextColor="{Binding SidePanel.ExitWest.Color}"
                                               FontAttributes="{Binding SidePanel.ExitWest.FontAttributes}"
                                               FontSize="11" FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Grid.Row="1" Grid.Column="2" Text="e"
                                               TextColor="{Binding SidePanel.ExitEast.Color}"
                                               FontAttributes="{Binding SidePanel.ExitEast.FontAttributes}"
                                               FontSize="11" FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Grid.Row="1" Grid.Column="4" Text="≈"
                                               TextColor="{Binding SidePanel.ExitSwampward.Color}"
                                               FontAttributes="{Binding SidePanel.ExitSwampward.FontAttributes}"
                                               FontSize="11" FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"
                                               HorizontalTextAlignment="Center"/>
                                        <!-- Row 2: sw, s, se, <(out), ↓ -->
                                        <Label Grid.Row="2" Grid.Column="0" Text="sw"
                                               TextColor="{Binding SidePanel.ExitSouthWest.Color}"
                                               FontAttributes="{Binding SidePanel.ExitSouthWest.FontAttributes}"
                                               FontSize="11" FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Grid.Row="2" Grid.Column="1" Text="s"
                                               TextColor="{Binding SidePanel.ExitSouth.Color}"
                                               FontAttributes="{Binding SidePanel.ExitSouth.FontAttributes}"
                                               FontSize="11" FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Grid.Row="2" Grid.Column="2" Text="se"
                                               TextColor="{Binding SidePanel.ExitSouthEast.Color}"
                                               FontAttributes="{Binding SidePanel.ExitSouthEast.FontAttributes}"
                                               FontSize="11" FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Grid.Row="2" Grid.Column="3" Text="⇤"
                                               TextColor="{Binding SidePanel.ExitOut.Color}"
                                               FontAttributes="{Binding SidePanel.ExitOut.FontAttributes}"
                                               FontSize="11" FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Grid.Row="2" Grid.Column="4" Text="↓"
                                               TextColor="{Binding SidePanel.ExitDown.Color}"
                                               FontAttributes="{Binding SidePanel.ExitDown.FontAttributes}"
                                               FontSize="11" FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"
                                               HorizontalTextAlignment="Center"/>
                                    </Grid>

                                    <!-- Items here + Carrying (FEI) — fades when stale (>15 s without refresh) -->
                                    <VerticalStackLayout Spacing="4" Opacity="{Binding SidePanel.FeiSectionOpacity}">

                                        <!-- Items here -->
                                        <Label Text="Here" TextColor="#58a6ff" FontSize="11" Margin="0,6,0,0"/>
                                        <Label Text="—" IsVisible="{Binding SidePanel.NoRoomItems}"
                                               TextColor="#555555" FontSize="11" FontAttributes="Italic"/>
                                        <VerticalStackLayout Spacing="1" IsVisible="{Binding SidePanel.HasRoomItems}"
                                                             BindableLayout.ItemsSource="{Binding SidePanel.RoomItemsList}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Label Text="{Binding .}" TextColor="#cccccc" FontSize="11"
                                                           FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <!-- Carrying -->
                                        <Label Text="Carrying" TextColor="#58a6ff" FontSize="11" Margin="0,6,0,0"/>
                                        <Label Text="—" IsVisible="{Binding SidePanel.NoInventory}"
                                               TextColor="#555555" FontSize="11" FontAttributes="Italic"/>
                                        <VerticalStackLayout Spacing="1" IsVisible="{Binding SidePanel.HasInventory}"
                                                             BindableLayout.ItemsSource="{Binding SidePanel.InventoryList}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Label Text="{Binding .}" TextColor="#cccccc" FontSize="11"
                                                           FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </ScrollView>

                            <!-- Bottom: online players, pinned, grows upward -->
                            <VerticalStackLayout Grid.Row="1" Padding="8,4,8,6" Spacing="2"
                                                 Opacity="{Binding SidePanel.FewSectionOpacity}">
                                <BoxView Color="#2d333b" HeightRequest="1" Margin="0,0,0,4"/>
                                <Label Text="Online" TextColor="#58a6ff" FontSize="11"/>
                                <ScrollView MaximumHeightRequest="180">
                                    <VerticalStackLayout Spacing="1"
                                                         BindableLayout.ItemsSource="{Binding SidePanel.WhosList}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WhoEntry">
                                                <Label Text="{Binding Name}"
                                                       TextColor="{Binding DisplayColor}"
                                                       Opacity="{Binding Opacity}"
                                                       FontSize="11"
                                                       FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </ScrollView>
                            </VerticalStackLayout>

                </Grid>
            </Border>
        </Grid>

        <!-- ── Toolbar (collapsible, wraps to fit width) ──────────── -->
        <Grid Grid.Row="3"
              x:Name="FkeyBar"
              BackgroundColor="#161b22"
              Padding="{Binding FkeyBarPadding}"
              IsVisible="{Binding FkeysVisible}">
            <HorizontalStackLayout
                        x:Name="FkeyFlexLayout"
                        BindableLayout.ItemsSource="{Binding FkeyItems}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:FkeyItem">
                        <Button Text="{Binding Label}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                  Path=BindingContext.FkeyCommand}"
                                CommandParameter="{Binding Index, StringFormat='{0}'}"
                                FontSize="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                   Path=BindingContext.FkeyFontSize}"
                                WidthRequest="{Binding Width}"
                                HeightRequest="22"
                                Padding="0"
                                BackgroundColor="#2d333b" TextColor="#cccccc"
                                CornerRadius="3"
                                Margin="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                 Path=BindingContext.FkeyButtonMargin}"/>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </Grid>

        <!-- ── Input row — flush left so the entry can carry a prompt later ── -->
        <Grid Grid.Row="5"
              ColumnDefinitions="*,Auto,Auto"
              BackgroundColor="#161b22"
              Padding="4,2">

            <Entry Grid.Column="0"
                   x:Name="InputEntry"
                   Text="{Binding InputText, Mode=TwoWay}"
                   TextColor="#CCCCCC"
                   BackgroundColor="#0C0C0C"
                   PlaceholderColor="#444444"
                   Placeholder="enter command&#x2026;"
                   ReturnCommand="{Binding SendCommand}"
                   ReturnType="Send"
                   ClearButtonVisibility="WhileEditing"
                   Keyboard="Plain"
                   IsSpellCheckEnabled="False"
                   IsTextPredictionEnabled="False">
                <Entry.FontFamily>
                    <OnPlatform x:TypeArguments="x:String">
                        <On Platform="Android"      Value="monospace"/>
                        <On Platform="MacCatalyst"  Value="Menlo-Regular"/>
                        <On Platform="WinUI"        Value="Cascadia Mono"/>
                    </OnPlatform>
                </Entry.FontFamily>
            </Entry>

            <!-- Fn: toggles the fkey toolbar; lit while the bar is shown.
                 Right-click (hooked natively on Windows) opens the settings page. -->
            <Button Grid.Column="1"
                    x:Name="FnButton"
                    Text="Fn"
                    Command="{Binding ToggleFkeysCommand}"
                    ToolTipProperties.Text="Toggle toolbar (right-click: settings)"
                    BackgroundColor="#2d333b" TextColor="#888888"
                    FontSize="10" CornerRadius="3"
                    WidthRequest="30" HeightRequest="26" Padding="0"
                    VerticalOptions="Center" Margin="4,0,0,0">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding FkeysVisible}" Value="True">
                        <Setter Property="TextColor" Value="White"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Grid.Column="2"
                    x:Name="SendButton"
                    Text="&#x25B6;"
                    Command="{Binding SendCommand}"
                    BackgroundColor="#1f6feb" TextColor="White"
                    FontSize="10" CornerRadius="3"
                    WidthRequest="30" HeightRequest="26" Padding="0"
                    VerticalOptions="Center" Margin="4,0,0,0"/>

            <!-- Scrollback-mode indicator: opaque overlay ON TOP of the input controls (which stay
                 in place) so toggling it causes no layout shift in the text view above. -->
            <Border Grid.Column="0" Grid.ColumnSpan="3"
                    x:Name="ScrollbackBar"
                    IsVisible="False"
                    BackgroundColor="#161b22"
                    Stroke="#F9F1A5" StrokeThickness="2"
                    Padding="8,0"
                    HorizontalOptions="Fill" VerticalOptions="Fill">
                <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnScrollbackBarTapped"/>
                </Border.GestureRecognizers>
                <Label Text="SCROLLBACK &#x2014; Esc or click to return to live"
                       TextColor="#F9F1A5" FontSize="12"
                       HorizontalOptions="Center" VerticalOptions="Center"
                       FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
            </Border>

        </Grid>

        <!-- ── About dialog — overlays the whole page; ⓘ in the status bar opens it ── -->
        <Grid Grid.Row="0" Grid.RowSpan="6"
              IsVisible="{Binding SidePanel.IsAboutVisible}">

            <!-- Scrim: dims the page; tap outside the dialog to dismiss -->
            <BoxView Color="Black" Opacity="0.55">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SidePanel.CloseAboutCommand}"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border BackgroundColor="#161b22"
                    Stroke="#2d333b" StrokeThickness="1"
                    Padding="16,12"
                    WidthRequest="280"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="4">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Mucka" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                        <Label Grid.Column="1" Text="&#x2715;" TextColor="#888888" FontSize="12"
                               Padding="8,0,0,0" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SidePanel.CloseAboutCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Label Text="a muddy client" TextColor="#888888" FontSize="11" FontAttributes="Italic"/>

                    <Label FontSize="11" Margin="0,6,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Version " TextColor="#888888"/>
                                <Span Text="{Binding SidePanel.AppVersion}" TextColor="White"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label FontSize="11" Margin="0,2,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="© " TextColor="#888888"/>
                                <Span Text="Oliver 'kfsone' Smith" TextColor="#58a6ff" TextDecorations="Underline"/>
                            </FormattedString>
                        </Label.FormattedText>
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SidePanel.OpenLinkCommand}" CommandParameter="mailto:oliver@kfs.org"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="github.com/kfsone/mucka" TextColor="#58a6ff" FontSize="11"
                           TextDecorations="Underline" Margin="0,2,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SidePanel.OpenLinkCommand}" CommandParameter="https://github.com/kfsone/mucka"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="Releases" TextColor="#58a6ff" FontSize="11"
                           TextDecorations="Underline" Margin="0,2,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SidePanel.OpenLinkCommand}" CommandParameter="https://github.com/kfsone/mucka/releases"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <BoxView Color="#2d333b" HeightRequest="1" Margin="0,8"/>

                    <Label FontSize="11">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Heavily inspired by " TextColor="#888888"/>
                                <Span Text="Clio" TextColor="#58a6ff" TextDecorations="Underline"/>
                            </FormattedString>
                        </Label.FormattedText>
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SidePanel.OpenLinkCommand}" CommandParameter="https://sourceforge.net/projects/clio-mud2/"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="Clio © Ian Peattie" TextColor="#888888" FontSize="11"/>

                    <BoxView Color="#2d333b" HeightRequest="1" Margin="0,8"/>

                    <Label Text="WORK IN PROGRESS" TextColor="#e3b341" FontSize="11" FontAttributes="Bold"/>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
