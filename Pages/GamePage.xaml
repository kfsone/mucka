<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mucka.ViewModels"
             xmlns:render="clr-namespace:Mucka.Rendering"
             xmlns:beh="clr-namespace:Mucka.Behaviors"
             xmlns:converters="clr-namespace:Mucka.Converters"
             x:Class="Mucka.Pages.GamePage"
             x:DataType="vm:GameViewModel"
             Title="mucka"
             BackgroundColor="#0C0C0C"
             NavigationPage.HasNavigationBar="False"
             SafeAreaEdges="All">

    <ContentPage.Resources>
        <Style x:Key="StatLabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="{OnPlatform WinUI=14, Default=13}"/>
            <Setter Property="VerticalOptions" Value="Center"/>
            <Setter Property="FontFamily" Value="{OnPlatform Android='monospace', WinUI='Cascadia Mono', MacCatalyst='Menlo-Regular'}"/>
        </Style>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ── Status bar ───────────────────────────────────────────── -->
        <Border Grid.Row="0"
                x:Name="StatusBar"
                BackgroundColor="#101618"
                Padding="6,4" StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,*">

                <!-- Top-left icons: a single "☰" overflow menu at every width. The old 3-up inline
                     icon strip (wide) / hamburger (narrow) split meant landscape lost the menu — and
                     with it the only way back to the Orientation switch. One menu, always present.
                     The | separator is always present, outside the toggle so layout is stable. -->
                <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto" VerticalOptions="Center">

                    <!-- Overflow menu — shown at all widths -->
                    <Border x:Name="OverflowMenuButton"
                            Grid.Column="0"
                            VerticalOptions="Center" HorizontalOptions="Start"
                            BackgroundColor="#2d333b"
                            Stroke="Transparent" StrokeThickness="0"
                            Padding="{OnPlatform Android='10,6', Default='6,2'}"
                            SemanticProperties.Description="Menu">
                        <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                        <FlyoutBase.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Side Panel" Clicked="OnOverflowTogglePanel"/>
                                <MenuFlyoutItem Text="Onlines" Clicked="OnOverflowOnlines"/>
                                <MenuFlyoutItem Text="Compass" Clicked="OnOverflowCompass"/>
                                <MenuFlyoutItem Text="Settings" Clicked="OnOverflowSettings"/>
                                <MenuFlyoutItem Text="About" Clicked="OnOverflowAbout"/>
                            </MenuFlyout>
                        </FlyoutBase.ContextFlyout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOverflowMenuTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="&#x2630;" TextColor="#aaaaaa" FontSize="13"
                               VerticalOptions="Center"/>
                    </Border>

                    <!-- Separator always present between the icon area and the stats -->
                    <Label Grid.Column="1" Text="|"
                           Style="{StaticResource StatLabelStyle}" TextColor="#444444"
                           Margin="4,0,0,0"/>
                </Grid>

                <!-- Normal stats bar: visible when effcols >= 76 -->
                <Grid Grid.Column="1"
                      ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto"
                      IsVisible="{Binding IsNotCompactStats}">

                    <!-- Left: stats -->
                    <Label Grid.Column="0" Style="{StaticResource StatLabelStyle}" Margin="0,0,8,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Sta: " TextColor="#58a6ff"/>
                                <Span Text="{Binding StaCurValue}" TextColor="{Binding StaColor}" FontAttributes="Bold"/>
                                <Span Text="{Binding StaMaxValue}" TextColor="#808080" FontSize="{OnPlatform WinUI=13, Default=12}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="1" Style="{StaticResource StatLabelStyle}" Margin="0,0,8,0"
                           IsVisible="{Binding MagVisible}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Mag: " TextColor="#58a6ff"/>
                                <Span Text="{Binding MagCurValue}" TextColor="{Binding MagColor}" FontAttributes="Bold"/>
                                <Span Text="{Binding MagMaxValue}" TextColor="#808080" FontSize="{OnPlatform WinUI=13, Default=12}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="2" Style="{StaticResource StatLabelStyle}" Margin="0,0,8,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Str: " TextColor="#58a6ff"/>
                                <Span Text="{Binding StrCurValue}" TextColor="{Binding StrColor}" FontAttributes="Bold"/>
                                <Span Text="{Binding StrMaxValue}" TextColor="#808080" FontSize="{OnPlatform WinUI=13, Default=12}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="3" Style="{StaticResource StatLabelStyle}" Margin="0,0,8,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Dex: " TextColor="#58a6ff"/>
                                <Span Text="{Binding DexCurValue}" TextColor="{Binding DexColor}" FontAttributes="Bold"/>
                                <Span Text="{Binding DexMaxValue}" TextColor="#808080" FontSize="{OnPlatform WinUI=13, Default=12}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Column="4" Text="|"
                           Style="{StaticResource StatLabelStyle}" TextColor="#444444" Margin="0,0,8,0"/>

                    <Label Grid.Column="5" Style="{StaticResource StatLabelStyle}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Score: " TextColor="#58a6ff"/>
                                <Span Text="{Binding ScoreValue}" TextColor="{Binding ScoreColor}" FontAttributes="Bold"/>
                                <Span Text="{Binding ScoreDeltaValue}" TextColor="{Binding ScoreColor}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!-- Separator after score -->
                    <Label Grid.Column="6" Text="|"
                           Style="{StaticResource StatLabelStyle}" TextColor="#444444" Margin="8,0"/>

                    <!-- Status-effect cluster: | sta str dex | glow | ailments |  (Grid.Column 7)
                         All icons render at 26px. Glow's art was normalized to a full opaque disc
                         (bloom now fades to a dark-amber rim, not transparent) so it reads as the
                         same solid circle as the stat/ailment discs — no per-icon size trim needed.
                         ABSOLUTE-width columns for sta/str/dex (36) and glow (30):
                         a fixed-width Grid column does NOT collapse when its icon is hidden, so the
                         dividers and the left stats never shift as effects come and go (a WidthRequest-
                         in-a-stacklayout collapsed, which caused the squish). HeightRequest reserves the
                         row so it can't jump vertically either. Per stat the buff sits behind the debuff
                         (bruised _neg icon, in front), offset +5px horizontally so ~5px of the buff peeks
                         and the negative reads first, with a ±1px vertical split applied only when both
                         signs are present (lone icons stay centred). Ailments live in fixed 30px
                         columns too (matching glow's slot), so EVERY column in this grid is a fixed
                         reserved slot: the whole cluster is constant-width and nothing — dividers,
                         ailments, or the stats/weather to either side — moves as effects toggle. The
                         icons behave like indicator lights lit in place, not an icon queue that packs.
                         Tooltips = the detected line (hardcoded fallback). -->
                    <Grid Grid.Column="7" VerticalOptions="Center" HeightRequest="28"
                          ColumnDefinitions="36,36,36,Auto,30,30,Auto,30,30,30,30">
                        <!-- Stamina: buff behind (offset), debuff in front -->
                        <Image Grid.Column="0" Source="stamina.png"      Margin="5,0,0,0" TranslationY="{Binding SidePanel.StaminaBuffDy}"   IsVisible="{Binding SidePanel.StaminaBuff}"   ToolTipProperties.Text="{Binding SidePanel.StaminaBuffTip}"   WidthRequest="26" HeightRequest="26" VerticalOptions="Center" HorizontalOptions="Start"/>
                        <Image Grid.Column="0" Source="stamina_neg.png"                   TranslationY="{Binding SidePanel.StaminaDebuffDy}" IsVisible="{Binding SidePanel.StaminaDebuff}" ToolTipProperties.Text="{Binding SidePanel.StaminaDebuffTip}" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" HorizontalOptions="Start"/>
                        <!-- Strength -->
                        <Image Grid.Column="1" Source="strength.png"     Margin="5,0,0,0" TranslationY="{Binding SidePanel.StrengthBuffDy}"   IsVisible="{Binding SidePanel.StrengthBuff}"   ToolTipProperties.Text="{Binding SidePanel.StrengthBuffTip}"   WidthRequest="26" HeightRequest="26" VerticalOptions="Center" HorizontalOptions="Start"/>
                        <Image Grid.Column="1" Source="strength_neg.png"                  TranslationY="{Binding SidePanel.StrengthDebuffDy}" IsVisible="{Binding SidePanel.StrengthDebuff}" ToolTipProperties.Text="{Binding SidePanel.StrengthDebuffTip}" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" HorizontalOptions="Start"/>
                        <!-- Dexterity -->
                        <Image Grid.Column="2" Source="dexterity.png"    Margin="5,0,0,0" TranslationY="{Binding SidePanel.DexterityBuffDy}"   IsVisible="{Binding SidePanel.DexterityBuff}"   ToolTipProperties.Text="{Binding SidePanel.DexterityBuffTip}"   WidthRequest="26" HeightRequest="26" VerticalOptions="Center" HorizontalOptions="Start"/>
                        <Image Grid.Column="2" Source="dexterity_neg.png"                 TranslationY="{Binding SidePanel.DexterityDebuffDy}" IsVisible="{Binding SidePanel.DexterityDebuff}" ToolTipProperties.Text="{Binding SidePanel.DexterityDebuffTip}" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" HorizontalOptions="Start"/>

                        <!-- | separator before glow -->
                        <BoxView Grid.Column="3" WidthRequest="1" HeightRequest="12" Color="#3a3f45" VerticalOptions="Center" Margin="4,0"/>
                        <!-- Glow -->
                        <Image Grid.Column="4" Source="glow.png" IsVisible="{Binding SidePanel.Glow}" ToolTipProperties.Text="{Binding SidePanel.GlowTip}" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <!-- Combat / clogging indicator (crossed swords) — lit while CombatTracker
                             believes we're in a fight; tooltip distinguishes "recording" vs not. -->
                        <Image Grid.Column="5" Source="combat.png" IsVisible="{Binding SidePanel.InCombat}" Opacity="{Binding SidePanel.CombatIconOpacity}" ToolTipProperties.Text="{Binding SidePanel.CombatTip}" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <!-- | separator before ailments -->
                        <BoxView Grid.Column="6" WidthRequest="1" HeightRequest="12" Color="#3a3f45" VerticalOptions="Center" Margin="4,0"/>
                        <!-- Ailments — full-colour emoji-style icons (26px) centred in fixed 30px slots. -->
                        <Image Grid.Column="7" Source="deaf.png"     IsVisible="{Binding Deaf}"     ToolTipProperties.Text="{Binding SidePanel.DeafTip}"     WidthRequest="26" HeightRequest="26" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <Image Grid.Column="8" Source="blind.png"    IsVisible="{Binding Blind}"    ToolTipProperties.Text="{Binding SidePanel.BlindTip}"    WidthRequest="26" HeightRequest="26" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <Image Grid.Column="9" Source="dumb.png"     IsVisible="{Binding Dumb}"     ToolTipProperties.Text="{Binding SidePanel.DumbTip}"     WidthRequest="26" HeightRequest="26" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <Image Grid.Column="10" Source="crippled.png" IsVisible="{Binding Crippled}" ToolTipProperties.Text="{Binding SidePanel.CrippledTip}" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" HorizontalOptions="Center"/>
                    </Grid>

                    <!-- Spacer -->
                    <BoxView Grid.Column="11" Color="Transparent"/>

                    <!-- Rec capture indicator — Border+tap avoids WinUI's minimum button height.
                         Hollow chip when idle; red dot + lit text while capturing. -->
                    <Border Grid.Column="12"
                            x:Name="RecChip"
                            IsVisible="{Binding IsRecordingButtonVisible}"
                            BackgroundColor="Transparent"
                            Stroke="#2d333b" StrokeThickness="1"
                            Padding="5,1" Margin="0,0,4,0"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Toggle capture"
                            SemanticProperties.Hint="Starts or stops capture">
                        <ToolTipProperties.Text>Toggle capture</ToolTipProperties.Text>
                        <Border.StrokeShape><RoundRectangle CornerRadius="3"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleCaptureCommand}"/>
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsCapturing}" Value="True">
                                <Setter Property="Stroke" Value="#c02020"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="3">
                            <Label Text="&#x25CF;" FontSize="9" TextColor="#E74856"
                                   IsVisible="{Binding IsCapturing}"
                                   VerticalOptions="Center"/>
                            <Label Text="rec" FontSize="10" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsCapturing}" Value="True">
                                        <Setter Property="TextColor" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsCapturing}" Value="False">
                                        <Setter Property="TextColor" Value="#666666"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Separator before weather/TTR group -->
                    <Label Grid.Column="14" Text="|"
                           Style="{StaticResource StatLabelStyle}" TextColor="#444444"
                           IsVisible="{Binding AnyRightStatVisible}"
                           Margin="6,0"/>

                    <!-- Weather: glyph + text (or glyph-only when effcols < 80) -->
                    <Label Grid.Column="15" Text="{Binding WeatherDisplayText}"
                           TextColor="{Binding WeatherColor}"
                           Style="{StaticResource StatLabelStyle}"
                           IsVisible="{Binding WeatherVisible}"
                           ToolTipProperties.Text="{Binding WeatherTooltip}"
                           Margin="0,0,6,0"/>

                    <!-- Separator before TTR -->
                    <Label Grid.Column="16" Text="|"
                           Style="{StaticResource StatLabelStyle}" TextColor="#444444"
                           IsVisible="{Binding TtrVisible}"
                           Margin="0,0,6,0"/>

                    <!-- Time until the next game reset -->
                    <Label Grid.Column="17" Text="{Binding TtrText}"
                           Style="{StaticResource StatLabelStyle}"
                           IsVisible="{Binding TtrVisible}"
                           ToolTipProperties.Text="{Binding TtrTooltip}"/>

                </Grid>

                <!-- Compact stats bar: two rows when effcols < 76
                     cols 0-7: stats | score | effects  col 8: * spacer
                     cols 9-10: weather  cols 11-12: TTR (rightmost, same order as wide bar) -->
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto"
                      ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto"
                      IsVisible="{Binding IsCompactStats}">

                    <!-- ── Labels row (2pt smaller font) ── -->
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Sta" TextColor="#58a6ff" FontSize="11"
                           VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,4,0"/>
                    <Label Grid.Row="0" Grid.Column="1"
                           Text="Mag" TextColor="#58a6ff" FontSize="11"
                           IsVisible="{Binding MagVisible}"
                           VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,4,0"/>
                    <Label Grid.Row="0" Grid.Column="2"
                           Text="Str" TextColor="#58a6ff" FontSize="11"
                           VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,4,0"/>
                    <Label Grid.Row="0" Grid.Column="3"
                           Text="Dex" TextColor="#58a6ff" FontSize="11"
                           VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,4,0"/>
                    <!-- col 4: | separator — label row spacer -->
                    <Label Grid.Row="0" Grid.Column="5"
                           Text="Score" TextColor="#58a6ff" FontSize="11"
                           VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,4,0"/>
                    <!-- col 6: | separator, col 7: status effects, col 8: * spacer -->
                    <Label Grid.Row="0" Grid.Column="10"
                           Text="Wth" TextColor="#58a6ff" FontSize="11"
                           IsVisible="{Binding WeatherVisible}"
                           VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,4,0"/>
                    <Label Grid.Row="0" Grid.Column="12"
                           Text="Rst" TextColor="#58a6ff" FontSize="11"
                           IsVisible="{Binding TtrVisible}"
                           VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,4,0"/>

                    <!-- ── Values row ── -->
                    <Label Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource StatLabelStyle}"
                           HorizontalOptions="Center" Margin="0,0,4,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding StaCurValue}" TextColor="{Binding StaColor}" FontAttributes="Bold" FontSize="{Binding StatsValueFontSize}"/>
                                <Span Text="{Binding StaMaxValue}" TextColor="#808080" FontSize="{Binding StatsMaxValueFontSize}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource StatLabelStyle}"
                           IsVisible="{Binding MagVisible}"
                           HorizontalOptions="Center" Margin="0,0,4,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding MagCurValue}" TextColor="{Binding MagColor}" FontAttributes="Bold" FontSize="{Binding StatsValueFontSize}"/>
                                <Span Text="{Binding MagMaxValue}" TextColor="#808080" FontSize="{Binding StatsMaxValueFontSize}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="1" Grid.Column="2"
                           Style="{StaticResource StatLabelStyle}"
                           HorizontalOptions="Center" Margin="0,0,4,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding StrCurValue}" TextColor="{Binding StrColor}" FontAttributes="Bold" FontSize="{Binding StatsValueFontSize}"/>
                                <Span Text="{Binding StrMaxValue}" TextColor="#808080" FontSize="{Binding StatsMaxValueFontSize}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="1" Grid.Column="3"
                           Style="{StaticResource StatLabelStyle}"
                           HorizontalOptions="Center" Margin="0,0,4,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding DexCurValue}" TextColor="{Binding DexColor}" FontAttributes="Bold" FontSize="{Binding StatsValueFontSize}"/>
                                <Span Text="{Binding DexMaxValue}" TextColor="#808080" FontSize="{Binding StatsMaxValueFontSize}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="1" Grid.Column="4" Text="|"
                           Style="{StaticResource StatLabelStyle}" TextColor="#444444"
                           Margin="0,0,4,0"/>

                    <Label Grid.Row="1" Grid.Column="5"
                           Text="{Binding ScoreDisplayValue}" TextColor="{Binding ScoreColor}"
                           Style="{StaticResource StatLabelStyle}"
                           FontSize="{Binding ScoreCompactFontSize}" FontAttributes="Bold"
                           MaxLines="1" LineBreakMode="TailTruncation"
                           HorizontalOptions="Center" Margin="0,0,4,0"/>

                    <!-- Separator + status effects (glyph-only), shown only while afflicted -->
                    <Label Grid.Row="1" Grid.Column="6" Text="|"
                           Style="{StaticResource StatLabelStyle}" TextColor="#444444"
                           IsVisible="{Binding AnyEffectVisible}"
                           Margin="0,0,4,0"/>
                    <Label Grid.Row="1" Grid.Column="7"
                           Text="{Binding EffectsGlyphs}"
                           Style="{StaticResource StatLabelStyle}"
                           FontSize="{Binding StatsValueFontSize}"
                           IsVisible="{Binding AnyEffectVisible}"
                           HorizontalOptions="Center" Margin="0,0,4,0"/>

                    <!-- col 8: * spacer -->

                    <Label Grid.Row="1" Grid.Column="9" Text="|"
                           Style="{StaticResource StatLabelStyle}" TextColor="#444444"
                           IsVisible="{Binding WeatherVisible}"
                           Margin="0,0,4,0"/>
                    <Label Grid.Row="1" Grid.Column="10"
                           Text="{Binding WeatherGlyph}" TextColor="{Binding WeatherColor}"
                           Style="{StaticResource StatLabelStyle}"
                           IsVisible="{Binding WeatherVisible}"
                           ToolTipProperties.Text="{Binding WeatherTooltip}"
                           HorizontalOptions="Center" Margin="0,0,4,0"/>

                    <Label Grid.Row="1" Grid.Column="11" Text="|"
                           Style="{StaticResource StatLabelStyle}" TextColor="#444444"
                           IsVisible="{Binding TtrVisible}"
                           Margin="0,0,4,0"/>
                    <Label Grid.Row="1" Grid.Column="12"
                           Text="{Binding TtrText}"
                           Style="{StaticResource StatLabelStyle}"
                           IsVisible="{Binding TtrVisible}"
                           ToolTipProperties.Text="{Binding TtrTooltip}"
                           HorizontalOptions="Center" Margin="0,0,4,0"/>

                </Grid>

            </Grid>
        </Border>

        <!-- ── White separator ──────────────────────────────────────── -->
        <BoxView Grid.Row="1" Color="White" HeightRequest="1" HorizontalOptions="Fill"/>

        <!-- ── Body: side panel on the left; scrollback, toolbar and input stacked
             on the right so the panel indents all three ── -->
        <!-- Third column (Auto) added for the new Combat Rail panel on the right edge - see the
             Border named CombatPanelBorder below. DESIGN_FINAL.md D3/2.2 (corrected): additive,
             separate from the left SidePanelBorder, shown/hidden via IsCombatPanelVisible only. -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">

        <!-- Right-hand stack -->
        <Grid Grid.Column="1" RowDefinitions="*,Auto,Auto">

        <!-- ── Scrollback ───────────────────────────────────────────── -->
        <Grid Grid.Row="0">
            <render:TerminalView Grid.Column="0"
                                 x:Name="Terminal"
                                 BackgroundColor="#0C0C0C"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Fill"/>

            <!-- Transient confirmation toast (copies, settings saves), overlaid top-right of the terminal view. -->
            <Border Grid.Column="0"
                    x:Name="CopiedToast"
                    IsVisible="False"
                    BackgroundColor="#161b22"
                    Stroke="#3B78FF" StrokeThickness="1"
                    Padding="8,4"
                    HorizontalOptions="End" VerticalOptions="Start"
                    Margin="0,8,12,0"
                    InputTransparent="True">
                <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                <Label x:Name="ToastLabel"
                       Text="* Copied to clipboard"
                       TextColor="#3B78FF" FontSize="12"
                       FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
            </Border>

            <!-- Floating dreamword chip: shown top-right when a dreamword is active.
                 Tapping speaks the dreamword (same as Ctrl+D). -->
            <Border Grid.Column="0"
                    IsVisible="{Binding DreamwordActive}"
                    BackgroundColor="#182a3e" Opacity="0.9"
                    Stroke="#FFD700" StrokeThickness="2"
                    Padding="10,4"
                    HorizontalOptions="End" VerticalOptions="Start"
                    Margin="0,6,8,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SpeakDreamwordCommand}"/>
                </Border.GestureRecognizers>
                <Label HorizontalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="&quot;" TextColor="#00E5FF" FontSize="{Binding DreamwordFontSize}"/>
                            <Span Text="{Binding Dreamword}" TextColor="#00E5FF" FontSize="{Binding DreamwordFontSize}" FontAttributes="Bold"/>
                            <Span Text="&quot;" TextColor="#00E5FF" FontSize="{Binding DreamwordFontSize}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Border>

            <!-- ── Floating online panel ─────────────────────────────────── -->
            <!-- Visible when online is unpinned. Draggable. No title bar — looks
                 like the side-panel section. -->
            <Border x:Name="FloatingOnlinePanel"
                    IsVisible="{Binding SidePanel.IsFloatingOnlineVisible}"
                    BackgroundColor="#101618"
                    Stroke="#3d4f5c" StrokeThickness="1"
                    WidthRequest="{Binding SidePanel.FloatingOnlineWidth}"
                    MinimumWidthRequest="150"
                    MaximumWidthRequest="240"
                    HorizontalOptions="Center" VerticalOptions="Start"
                    Margin="0,6,0,0"
                    ZIndex="10"
                    SizeChanged="OnFloatingOnlineSizeChanged">
                <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnFloatingPanelPanUpdated"/>
                    <!-- Hover only brightens the corner lock; no layout change. -->
                    <PointerGestureRecognizer PointerEntered="OnFloatingOnlinePointerEntered"
                                              PointerExited="OnFloatingOnlinePointerExited"/>
                </Border.GestureRecognizers>
                <!-- Grid so the corner lock icon can overlay the content without pushing it down. -->
                <Grid>
                <VerticalStackLayout Padding="8,6,8,6" Spacing="2">

                    <!-- Heading row: title · resize − / + · dock · fold. Shown only while unlocked;
                         its controls also live in the side rail, so a locked windlet is content-only.
                         Right margin clears the corner lock overlay. -->
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="0,0,20,0"
                          IsVisible="{Binding SidePanel.IsFloatingOnlineUnlocked}">
                        <Label Grid.Column="0" VerticalOptions="Center"
                               HorizontalOptions="Fill" HorizontalTextAlignment="Start">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Online" TextColor="#58a6ff" FontSize="11"
                                          FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                    <Span Text="{Binding SidePanel.OnlineCountText}" TextColor="White" FontSize="11"
                                          FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <!-- Hamburger: opens settings > Display -->
                        <Label Grid.Column="1" Text="&#x2630;" TextColor="#888888" FontSize="12"
                               VerticalOptions="Center" Padding="4,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SidePanel.OpenFloatingDisplaySettingsCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <!-- Resize: − shrinks, + grows. Bumped a point and spaced out to match the
                             compass windlet — the glyphs were near-invisible and too tight to hit. -->
                        <Label Grid.Column="2" Text="&#x2212;" TextColor="#888888" FontSize="14"
                               VerticalOptions="Center" Padding="7,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SidePanel.DecreaseOnlineSizeCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Grid.Column="3" Text="+" TextColor="#888888" FontSize="14"
                               VerticalOptions="Center" Padding="7,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SidePanel.IncreaseOnlineSizeCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <!-- Dock toggle: hollow □ = float me, filled ■ = dock me -->
                        <Label Grid.Column="4"
                               Text="{Binding SidePanel.PinGlyph}"
                               TextColor="{Binding SidePanel.PinColor}"
                               FontSize="14" VerticalOptions="Center"
                               Padding="7,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SidePanel.ToggleOnlinePinnedCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <!-- Fold toggle -->
                        <Label Grid.Column="5" Text="{Binding SidePanel.FloatingFoldGlyph}"
                               TextColor="#444444" FontSize="9" VerticalOptions="Center"
                               Padding="4,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SidePanel.ToggleFloatingFoldCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Who-list body — hidden when folded -->
                    <ScrollView MaximumHeightRequest="180"
                                IsVisible="{Binding SidePanel.IsFloatingOnlineFolded, Converter={StaticResource InvertBoolConverter}}">
                        <VerticalStackLayout Spacing="1"
                                             BindableLayout.ItemsSource="{Binding SidePanel.WhosList}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:WhoEntry">
                                    <Label FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding DisplayPrefix}"
                                                      TextColor="{Binding DisplayColor}"
                                                      FontSize="9"
                                                      FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                                <Span Text="{Binding DisplayName}"
                                                      TextColor="{Binding DisplayColor}"
                                                      FontSize="11"
                                                      FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                                <Span Text="{Binding DisplaySuffix}"
                                                      TextColor="{Binding DisplayColor}"
                                                      FontSize="9"
                                                      FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                        <Label.Behaviors>
                                            <beh:WhoEntryFadeBehavior/>
                                        </Label.Behaviors>
                                    </Label>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>

                </VerticalStackLayout>
                <!-- Corner lock: unlock to drag + reveal the title strip; re-lock for a clean,
                     content-only windlet. Overlaid, so it never shifts the list down. -->
                <Label x:Name="OnlineLockIcon" Text="{Binding SidePanel.FloatingOnlineLockGlyph}"
                       FontSize="11" Opacity="0.5"
                       HorizontalOptions="End" VerticalOptions="Start" Padding="6,3,4,3">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SidePanel.ToggleFloatingOnlineLockCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
                </Grid>
            </Border>

            <!-- ── Floating compass panel ────────────────────────────────── -->
            <!-- Visible when the compass is undocked. Draggable. Carries only the radar
                 (and its swamp seam) — never the room trail. -->
            <Border x:Name="FloatingMapPanel"
                    IsVisible="{Binding SidePanel.IsFloatingMapVisible}"
                    BackgroundColor="#101618"
                    Stroke="#3d4f5c" StrokeThickness="1"
                    HorizontalOptions="Center" VerticalOptions="Start"
                    WidthRequest="{Binding SidePanel.FloatingMapPanelWidth}"
                    Margin="0,6,0,0"
                    ZIndex="10"
                    SizeChanged="OnFloatingMapSizeChanged">
                <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnFloatingMapPanUpdated"/>
                    <!-- Hover only brightens the corner lock; no layout change. -->
                    <PointerGestureRecognizer PointerEntered="OnFloatingMapPointerEntered"
                                              PointerExited="OnFloatingMapPointerExited"/>
                </Border.GestureRecognizers>
                <!-- Grid so the corner lock icon can overlay the content without pushing it down. -->
                <Grid>
                <VerticalStackLayout Padding="8,6,8,6" Spacing="2">

                    <!-- Heading row: resize − / + · dock · fold. Shown only while unlocked; its
                         controls also live in the side rail, so a locked windlet is just the dial.
                         No "Compass" label — it's obviously the compass. Right margin clears the lock. -->
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,20,0"
                          IsVisible="{Binding SidePanel.IsFloatingMapUnlocked}">
                        <!-- Resize: − shrinks, + grows. Bumped a point and spaced out: the glyphs
                             were near-invisible and too tight to hit reliably on a phone. -->
                        <Label Grid.Column="1" Text="&#x2212;" TextColor="#888888" FontSize="14"
                               VerticalOptions="Center" Padding="7,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SidePanel.DecreaseMapSizeCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Grid.Column="2" Text="+" TextColor="#888888" FontSize="14"
                               VerticalOptions="Center" Padding="7,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SidePanel.IncreaseMapSizeCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <!-- Dock toggle: hollow □ = float me, filled ■ = dock me -->
                        <Label Grid.Column="3" Text="{Binding SidePanel.MapPinGlyph}"
                               TextColor="{Binding SidePanel.MapPinColor}"
                               FontSize="14" VerticalOptions="Center" Padding="7,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SidePanel.ToggleMapPinnedCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <!-- Fold toggle -->
                        <Label Grid.Column="4" Text="{Binding SidePanel.FloatingMapFoldGlyph}"
                               TextColor="#444444" FontSize="9" VerticalOptions="Center" Padding="4,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SidePanel.ToggleFloatingMapFoldCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Body — hidden when folded -->
                    <VerticalStackLayout Spacing="2"
                                         IsVisible="{Binding SidePanel.IsFloatingMapFolded, Converter={StaticResource InvertBoolConverter}}">
                        <render:RadarCompassView SidePanel="{Binding SidePanel}"
                                                 MoveCommand="{Binding MoveCommand}"
                                                 WidthRequest="{Binding SidePanel.FloatingMapWidth}"
                                                 HeightRequest="{Binding SidePanel.FloatingMapHeight}"
                                                 HorizontalOptions="Center"/>
                        <render:SwampSeamView IsLit="{Binding SidePanel.ExitSwampward.Present}"
                                              HeightRequest="14" HorizontalOptions="Fill" Margin="0,0,0,0">
                            <render:SwampSeamView.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding MoveCommand}" CommandParameter="swampward"/>
                            </render:SwampSeamView.GestureRecognizers>
                        </render:SwampSeamView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
                <!-- Corner lock: unlock to drag + reveal the title strip; re-lock for a clean,
                     dial-only windlet. Overlaid, so it never shifts the dial down. -->
                <Label x:Name="MapLockIcon" Text="{Binding SidePanel.FloatingMapLockGlyph}"
                       FontSize="11" Opacity="0.5"
                       HorizontalOptions="End" VerticalOptions="Start" Padding="6,3,4,3">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SidePanel.ToggleFloatingMapLockCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
                </Grid>
            </Border>

        </Grid>

        <!-- ── Toolbar (collapsible, wraps to fit width) ──────────── -->
        <Grid Grid.Row="1"
              x:Name="FkeyBar"
              BackgroundColor="#161b22"
              Padding="{Binding FkeyBarPadding}"
              IsVisible="{Binding FkeysVisible}">
            <HorizontalStackLayout
                        x:Name="FkeyFlexLayout"
                        BindableLayout.ItemsSource="{Binding FkeyItems}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:FkeyItem">
                        <Button Text="{Binding Label}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                  Path=BindingContext.FkeyCommand}"
                                CommandParameter="{Binding Index, StringFormat='{0}'}"
                                FontSize="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                   Path=BindingContext.FkeyFontSize}"
                                WidthRequest="{Binding Width}"
                                HeightRequest="22"
                                Padding="0"
                                BackgroundColor="#2d333b" TextColor="#cccccc"
                                CornerRadius="3"
                                Margin="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                 Path=BindingContext.FkeyButtonMargin}"/>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </Grid>

        <!-- ── Input row — indented by the side panel on its left ── -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto,Auto,Auto"
              BackgroundColor="#161b22"
              Padding="4,2">

            <!-- Input frame — the yellow stroke lights up in chat mode as a mode cue (Invariant #0:
                 the box itself still owns the keyboard and still sends normal commands). -->
            <Border Grid.Column="0"
                    x:Name="InputFrame"
                    Stroke="Transparent" StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 3"
                    BackgroundColor="#0C0C0C" Padding="0">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding ChatMode}" Value="True">
                        <Setter Property="Stroke" Value="#F9F1A5"/>
                    </DataTrigger>
                </Border.Triggers>
                <Entry x:Name="InputEntry"
                       Text="{Binding InputText, Mode=TwoWay}"
                       TextColor="#CCCCCC"
                       BackgroundColor="Transparent"
                       PlaceholderColor="#444444"
                       Placeholder="{Binding InputPlaceholder}"
                       ReturnCommand="{Binding SendCommand}"
                       ReturnType="Send"
                       ClearButtonVisibility="{OnPlatform WinUI=Never, Default=WhileEditing}"
                       Keyboard="Plain"
                       IsSpellCheckEnabled="False"
                       IsTextPredictionEnabled="False">
                    <Entry.Triggers>
                        <DataTrigger TargetType="Entry" Binding="{Binding ChatMode}" Value="True">
                            <Setter Property="PlaceholderColor" Value="#C19C00"/>
                        </DataTrigger>
                    </Entry.Triggers>
                    <Entry.FontFamily>
                        <OnPlatform x:TypeArguments="x:String">
                            <On Platform="Android"      Value="monospace"/>
                            <On Platform="MacCatalyst"  Value="Menlo-Regular"/>
                            <On Platform="WinUI"        Value="Cascadia Mono"/>
                        </OnPlatform>
                    </Entry.FontFamily>
                </Entry>
            </Border>

            <!-- Chat: latching toggle of the chat-view filter. Lit bold-yellow (chat colour) while
                 active; flashes amber when non-chat output arrives while filtered. -->
            <Button Grid.Column="1"
                    x:Name="ChatButton"
                    Text="Chat"
                    Command="{Binding ToggleChatModeCommand}"
                    ToolTipProperties.Text="Show chat messages only"
                    BackgroundColor="#2d333b" TextColor="#888888"
                    FontSize="10" CornerRadius="3"
                    WidthRequest="44" HeightRequest="26" Padding="0"
                    VerticalOptions="Center" Margin="4,0,0,0">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ChatMode}" Value="True">
                        <Setter Property="TextColor" Value="#F9F1A5"/>
                        <Setter Property="FontAttributes" Value="Bold"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <!-- Fn: toggles the fkey toolbar; lit while the bar is shown.
                 Right-click (hooked natively on Windows) opens the settings page. -->
            <Button Grid.Column="2"
                    x:Name="FnButton"
                    Text="Fn"
                    Command="{Binding ToggleFkeysCommand}"
                    ToolTipProperties.Text="Toggle toolbar (right-click: settings)"
                    BackgroundColor="#2d333b" TextColor="#888888"
                    FontSize="10" CornerRadius="3"
                    WidthRequest="30" HeightRequest="26" Padding="0"
                    VerticalOptions="Center" Margin="4,0,0,0">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding FkeysVisible}" Value="True">
                        <Setter Property="TextColor" Value="White"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Grid.Column="3"
                    x:Name="SendButton"
                    Text="&#x25B6;"
                    Command="{Binding SendCommand}"
                    BackgroundColor="#1f6feb" TextColor="White"
                    FontSize="10" CornerRadius="3"
                    WidthRequest="30" HeightRequest="26" Padding="0"
                    VerticalOptions="Center" Margin="4,0,0,0"/>

            <!-- Scrollback-mode indicator: opaque overlay ON TOP of the input controls (which stay
                 in place) so toggling it causes no layout shift in the text view above. -->
            <Border Grid.Column="0" Grid.ColumnSpan="4"
                    x:Name="ScrollbackBar"
                    IsVisible="False"
                    BackgroundColor="#161b22"
                    Stroke="#F9F1A5" StrokeThickness="2"
                    Padding="8,0"
                    HorizontalOptions="Fill" VerticalOptions="Fill">
                <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnScrollbackBarTapped"/>
                </Border.GestureRecognizers>
                <Label Text="SCROLLBACK &#x2014; Esc or click to return to live"
                       TextColor="#F9F1A5" FontSize="12"
                       HorizontalOptions="Center" VerticalOptions="Center"
                       FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
            </Border>

        </Grid>

        </Grid>

        <!-- ── Side panel — left edge, runs scrollback through input row ── -->
        <Border Grid.Column="0"
                x:Name="SidePanelBorder"
                IsVisible="{Binding SidePanel.IsPanelExpanded}"
                WidthRequest="228"
                BackgroundColor="#101618"
                Stroke="#2d333b" StrokeThickness="1"
                Padding="0">
                <!-- ── Panel content: top-anchored online list, scrollable items,
                     bottom-pinned room block sitting in the corner above the input ── -->
                <Grid RowDefinitions="Auto,*,Auto">

                            <!-- Row 0: the Online section plus the Recent tail beneath it. The Online
                                 section hides when floated (the floating pill takes over); the Recent
                                 tail stays docked in the side panel regardless of float, and hides only
                                 when Online is disabled/folded. -->
                            <VerticalStackLayout Grid.Row="0" Spacing="0">

                            <!-- Top: online players, anchored, grows downward.
                                 Compositor (off-UI-thread) stale-dim when an FEW update is late.
                                 Hidden when online is unpinned (floating pill takes over). -->
                            <VerticalStackLayout Padding="8,6,8,4" Spacing="2"
                                                 IsVisible="{Binding SidePanel.IsOnlineSectionVisible}">
                                <VerticalStackLayout.Behaviors>
                                    <beh:StaleDimBehavior Source="Few"/>
                                </VerticalStackLayout.Behaviors>
                                <!-- Heading row: label + count + pin + fold toggle -->
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <Label Grid.Column="0" VerticalOptions="Center"
                                           HorizontalOptions="Fill" HorizontalTextAlignment="Start">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Online" TextColor="#58a6ff" FontSize="11"
                                                      FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                                <Span Text="{Binding SidePanel.OnlineCountText}" TextColor="White" FontSize="11"
                                                      FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <!-- Dock icon: gold ■ = docked, grey □ = floated free -->
                                    <Label Grid.Column="1"
                                           Text="{Binding SidePanel.PinGlyph}"
                                           TextColor="{Binding SidePanel.PinColor}"
                                           FontSize="13" VerticalOptions="Center"
                                           Padding="4,0,0,0">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SidePanel.ToggleOnlinePinnedCommand}"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <!-- Fold toggle -->
                                    <Label Grid.Column="2" Text="{Binding SidePanel.OnlineFoldGlyph}"
                                           TextColor="#444444" FontSize="9" VerticalOptions="Center"
                                           Padding="4,0,0,0">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SidePanel.ToggleOnlineCommand}"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                                <ScrollView MaximumHeightRequest="180"
                                            IsVisible="{Binding SidePanel.IsOnlineExpanded}">
                                    <VerticalStackLayout Spacing="1"
                                                         BindableLayout.ItemsSource="{Binding SidePanel.WhosList}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WhoEntry">
                                                <!-- Persona name at full size; title/level suffix 2pt smaller. -->
                                                <Label FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding DisplayPrefix}"
                                                                  TextColor="{Binding DisplayColor}"
                                                                  FontSize="9"
                                                                  FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                                            <Span Text="{Binding DisplayName}"
                                                                  TextColor="{Binding DisplayColor}"
                                                                  FontSize="11"
                                                                  FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                                            <Span Text="{Binding DisplaySuffix}"
                                                                  TextColor="{Binding DisplayColor}"
                                                                  FontSize="9"
                                                                  FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                    <!-- Compositor (off-UI-thread) fade in/out on join/leave. -->
                                                    <Label.Behaviors>
                                                        <beh:WhoEntryFadeBehavior/>
                                                    </Label.Behaviors>
                                                </Label>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </ScrollView>
                            </VerticalStackLayout>

                            <!-- Recent tail: players who faded off Online, kept for the Forget window.
                                 Stays in the side panel whether Online is docked or floated; hides only
                                 when Online is disabled/folded (IsOnlineExpanded) or empty (HasRecent).
                                 Each minutes-since-seen bucket is introduced by a hairline separator with
                                 the age at its right end. Tapping a name fires a one-shot "sniff" probe. -->
                            <VerticalStackLayout IsVisible="{Binding SidePanel.IsOnlineExpanded}">
                            <VerticalStackLayout Padding="8,0,8,4" Spacing="1"
                                                 IsVisible="{Binding SidePanel.HasRecent}">
                                <ScrollView MaximumHeightRequest="140">
                                    <VerticalStackLayout Spacing="1"
                                                         BindableLayout.ItemsSource="{Binding SidePanel.RecentGroups}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RecentGroup">
                                                <VerticalStackLayout Spacing="1">
                                                    <!-- Separator: hairline rule with the age at the right end ("──── ~1 min"). -->
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,3,0,1">
                                                        <BoxView Grid.Column="0" Color="#2d333b" HeightRequest="1" VerticalOptions="Center"/>
                                                        <Label Grid.Column="1" Text="{Binding Header}" TextColor="#6e7681" FontSize="8"
                                                               FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                                    </Grid>
                                                    <VerticalStackLayout Spacing="1"
                                                                         BindableLayout.ItemsSource="{Binding Members}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:WhoEntry">
                                                                <!-- Right-aligned, only lightly dimmed so it reads as "known, idle". -->
                                                                <Label Opacity="0.8"
                                                                       HorizontalOptions="End" HorizontalTextAlignment="End"
                                                                       FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Text="{Binding DisplayPrefix}"
                                                                                  TextColor="{Binding DisplayColor}" FontSize="9"
                                                                                  FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                                                            <Span Text="{Binding DisplayName}"
                                                                                  TextColor="{Binding DisplayColor}" FontSize="11"
                                                                                  FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                                                            <Span Text="{Binding DisplaySuffix}"
                                                                                  TextColor="{Binding DisplayColor}" FontSize="9"
                                                                                  FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GameViewModel}}, Path=SidePanel.ProbeRecentCommand}"
                                                                            CommandParameter="{Binding .}"/>
                                                                    </Label.GestureRecognizers>
                                                                    <!-- Keep the keyboard on the command box (Invariant #0): the tap fires
                                                                         the probe command but must not focus this row. -->
                                                                    <Label.Behaviors>
                                                                        <beh:NoFocusStealBehavior/>
                                                                    </Label.Behaviors>
                                                                </Label>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </ScrollView>
                            </VerticalStackLayout>
                            </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- Middle: Carrying then Here (FEI), scrollable — fades when stale (>15 s without refresh).
                                 Docked to the bottom of the free space, growing upward toward the online list. -->
                            <ScrollView Grid.Row="1" Padding="8,4" VerticalOptions="End">
                                <VerticalStackLayout Spacing="4">

                                    <VerticalStackLayout Spacing="4">
                                        <VerticalStackLayout.Behaviors>
                                            <beh:StaleDimBehavior Source="Fei"/>
                                        </VerticalStackLayout.Behaviors>

                                        <!-- Carrying heading + fold toggle -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="Carrying" TextColor="#58a6ff" FontSize="11"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="Fill" HorizontalTextAlignment="Start"/>
                                            <Label Grid.Column="1" Text="{Binding SidePanel.InventoryFoldGlyph}"
                                                   TextColor="#444444" FontSize="9" VerticalOptions="Center"
                                                   Padding="8,0,0,0">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding SidePanel.ToggleInventoryCommand}"/>
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                        <VerticalStackLayout IsVisible="{Binding SidePanel.IsInventoryExpanded}" Spacing="1">
                                            <Label Text="&#x2014;" IsVisible="{Binding SidePanel.NoInventory}"
                                                   TextColor="#555555" FontSize="11" FontAttributes="Italic"
                                                   HorizontalOptions="Fill" HorizontalTextAlignment="End"/>
                                            <VerticalStackLayout Spacing="1" IsVisible="{Binding SidePanel.HasInventory}"
                                                                 BindableLayout.ItemsSource="{Binding SidePanel.InventoryList}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Label Text="{Binding .}" TextColor="#cccccc" FontSize="11"
                                                               HorizontalOptions="Fill" HorizontalTextAlignment="End"
                                                               FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>

                                        <BoxView Color="#2d333b" HeightRequest="1" Margin="0,6,0,0"/>

                                        <!-- Items here heading + fold toggle -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="Here" TextColor="#58a6ff" FontSize="11"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="Fill" HorizontalTextAlignment="Start"/>
                                            <Label Grid.Column="1" Text="{Binding SidePanel.ItemsHereFoldGlyph}"
                                                   TextColor="#444444" FontSize="9" VerticalOptions="Center"
                                                   Padding="8,0,0,0">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding SidePanel.ToggleItemsHereCommand}"/>
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                        <VerticalStackLayout IsVisible="{Binding SidePanel.IsItemsHereExpanded}" Spacing="1">
                                            <Label Text="&#x2014;" IsVisible="{Binding SidePanel.NoRoomItems}"
                                                   TextColor="#555555" FontSize="11" FontAttributes="Italic"
                                                   HorizontalOptions="Fill" HorizontalTextAlignment="End"/>
                                            <VerticalStackLayout Spacing="1" IsVisible="{Binding SidePanel.HasRoomItems}"
                                                                 BindableLayout.ItemsSource="{Binding SidePanel.RoomItemsList}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Label Text="{Binding .}" TextColor="#cccccc" FontSize="11"
                                                               HorizontalOptions="Fill" HorizontalTextAlignment="End"
                                                               FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </ScrollView>

                            <!-- Bottom: room block, pinned in the corner above the input row.
                                 Trail reads downward into the present: last-but-1 → previous → compass → current. -->
                            <VerticalStackLayout Grid.Row="2" Padding="8,4,8,6" Spacing="1">
                                    <BoxView Color="#2d333b" HeightRequest="1" Margin="0,0,0,4"/>

                                    <!-- Map heading: label · float toggle · fold toggle -->
                                    <Grid Margin="0,0,0,1" ColumnDefinitions="*,Auto,Auto">
                                        <Label Text="Map" TextColor="#58a6ff" FontSize="11"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Fill" HorizontalTextAlignment="Start"/>
                                        <!-- Float toggle: filled ■ = docked, hollow □ = floated free -->
                                        <Label Grid.Column="1" Text="{Binding SidePanel.MapPinGlyph}"
                                               TextColor="{Binding SidePanel.MapPinColor}"
                                               FontSize="13" VerticalOptions="Center"
                                               Padding="8,0,0,0">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SidePanel.ToggleMapPinnedCommand}"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label Grid.Column="2" Text="{Binding SidePanel.MapFoldGlyph}"
                                               TextColor="#444444" FontSize="9" VerticalOptions="Center"
                                               Padding="8,0,0,0">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SidePanel.ToggleMapCommand}"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>

                                    <!-- Compass: the radar rose. Docked here when pinned, floats otherwise.
                                         Right-aligned, sized for the side rail. -->
                                    <render:RadarCompassView SidePanel="{Binding SidePanel}"
                                                             MoveCommand="{Binding MoveCommand}"
                                                             IsVisible="{Binding SidePanel.IsDockedCompassVisible}"
                                                             WidthRequest="104" HeightRequest="104"
                                                             HorizontalOptions="End" Margin="0,1,0,0"/>

                                    <!-- Swamp seam: the marshy separator between compass and room block,
                                         lit (and labelled) when a swampward exit is open; click to go. -->
                                    <render:SwampSeamView IsLit="{Binding SidePanel.ExitSwampward.Present}"
                                                          IsVisible="{Binding SidePanel.IsDockedCompassVisible}"
                                                          HeightRequest="14" HorizontalOptions="Fill"
                                                          Margin="0,1,0,3">
                                        <render:SwampSeamView.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding MoveCommand}" CommandParameter="swampward"/>
                                        </render:SwampSeamView.GestureRecognizers>
                                    </render:SwampSeamView>

                                    <!-- Room trail: one font point smaller per step back -->
                                    <Label Text="{Binding SidePanel.OldestRoom}"
                                           TextColor="#00a000" FontSize="11" FontAttributes="Bold"
                                           HorizontalOptions="Fill" HorizontalTextAlignment="End"
                                           FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                    <Label Text="{Binding SidePanel.PreviousRoom}"
                                           TextColor="#00c000" FontSize="12"
                                           HorizontalOptions="Fill" HorizontalTextAlignment="End"
                                           FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>

                                    <!-- Current room: always reserves 2-line height so the compass
                                         doesn't shift when a long description wraps. -->
                                    <Label Text="{Binding SidePanel.CurrentRoom}"
                                           IsVisible="{Binding SidePanel.HasCurrentRoom}"
                                           TextColor="#00ff00" FontSize="13" FontAttributes="Bold"
                                           HorizontalOptions="Fill" HorizontalTextAlignment="End"
                                           MaxLines="2" LineBreakMode="TailTruncation"
                                           MinimumHeightRequest="{OnPlatform WinUI=36, Default=40}"
                                           Margin="0,4,0,0"
                                           FontFamily="{OnPlatform WinUI='Cascadia Mono', Default='monospace'}"/>
                                    <Label Text="&#x2014;" IsVisible="{Binding SidePanel.NoCurrentRoom}"
                                           TextColor="#555555" FontSize="11" FontAttributes="Italic"
                                           HorizontalOptions="Fill" HorizontalTextAlignment="End"
                                           Margin="0,4,0,0"/>
                            </VerticalStackLayout>

                </Grid>
        </Border>

        <!-- - Combat panel - NEW, additional panel on the RIGHT edge, off by default -
             DESIGN_FINAL.md D3/2.2 (corrected). This is NOT the left SidePanelBorder above widened;
             it is a wholly separate panel with its own width, shown/hidden only by "$clog on"/
             "$clog off" (GameViewModel.SetClogEnabled -> GamePage's OnOpenClogWindowRequested/
             OnCloseClogWindowRequested, which now toggle this panel and resize the window by
             CombatPanelWidthDp instead of opening a floating window). The window never resizes for
             any other reason - not combat start, not combat end. -->
        <Border Grid.Column="2"
                x:Name="CombatPanelBorder"
                IsVisible="{Binding SidePanel.IsCombatPanelVisible}"
                WidthRequest="300"
                BackgroundColor="#101618"
                Stroke="#2d333b" StrokeThickness="1"
                Padding="0">
            <Grid>
                <!-- Glow layer BEHIND the canvas (D9): opacity animated ONLY via WinUI Composition
                     (PulseLayer, GamePage.xaml.cs), never via a UI-thread timer and never by
                     recolouring the canvas's own drawn text. Rests at Opacity 0 (invisible) whenever
                     no tier is pulsing. -->
                <BoxView x:Name="CombatPanelGlow"
                         Color="#C50F1F"
                         Opacity="0"
                         InputTransparent="True"/>
                <!-- The tick meter's moving fill, also behind the canvas and also driven purely by
                     Composition (TickSweep, GamePage.xaml.cs) - the canvas draws the empty track and
                     the opponent count over it, but never the motion: SKXamlCanvas paints on the UI
                     thread, and a 2-second progress bar repainted there competes with typing
                     (Invariant #1). Its bounds are set in code from CombatRailView.TickTrackDp so
                     the fill and the track it sits in can never drift apart. Rests scaled to zero
                     width; only ever visible mid-fight. -->
                <BoxView x:Name="CombatTickSweep"
                         Color="#FFFFFF"
                         Opacity="0.20"
                         HorizontalOptions="Fill"
                         VerticalOptions="End"
                         InputTransparent="True"/>
                <!-- The render surface itself: a single SkiaSharp canvas, never a Label/
                     FormattedString (D8) - see CombatPanelCanvasView's own remarks. Read-only: no
                     gesture recognizers, cannot take keyboard focus (Invariant #0). -->
                <render:CombatRailView x:Name="CombatPanelCanvas"
                                       SidePanel="{Binding SidePanel}"
                                       MetronomeEnabled="{Binding SidePanel.IsCombatMetronomeEnabled}"
                                       BackgroundColor="Transparent"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill"
                                       InputTransparent="True"/>
                <!-- The metronome toggle's HIT TARGET only - the switch itself is drawn by the
                     canvas. An invisible button rather than a gesture recognizer on the canvas, so
                     the canvas stays InputTransparent with zero gestures and Invariant #0 holds by
                     construction. Its own click hands focus straight back to the command box (see
                     SidePanelViewModel.ToggleCombatMetronome), and OnCombatMetronomeHandlerChanged
                     clears IsTabStop so Tab can never land on it. Bounds are set in code from the
                     same geometry the canvas draws with. -->
                <Button x:Name="CombatMetronomeHit"
                        Command="{Binding SidePanel.ToggleCombatMetronomeCommand}"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Padding="0"
                        HorizontalOptions="End"
                        VerticalOptions="End"/>
            </Grid>
        </Border>

        </Grid>

        <!-- ── About dialog — overlays the whole page; ⓘ in the status bar opens it ── -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              IsVisible="{Binding SidePanel.IsAboutVisible}">

            <!-- Scrim: dims the page; tap outside the dialog to dismiss -->
            <BoxView Color="Black" Opacity="0.55">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SidePanel.CloseAboutCommand}"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border BackgroundColor="#161b22"
                    Stroke="#2d333b" StrokeThickness="1"
                    Padding="16,12"
                    WidthRequest="280" MaximumHeightRequest="560"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                <ScrollView>
                <VerticalStackLayout Spacing="4">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Mucka" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                        <Label Grid.Column="1" Text="&#x2715;" TextColor="#888888" FontSize="12"
                               Padding="8,0,0,0" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SidePanel.CloseAboutCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Label Text="a muddy client" TextColor="#888888" FontSize="11" FontAttributes="Italic"/>

                    <Label FontSize="11" Margin="0,6,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Version " TextColor="#888888"/>
                                <Span Text="{Binding SidePanel.AppVersion}" TextColor="White"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label FontSize="11" Margin="0,2,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="© " TextColor="#888888"/>
                                <Span Text="Oliver 'kfsone' Smith" TextColor="#58a6ff" TextDecorations="Underline"/>
                            </FormattedString>
                        </Label.FormattedText>
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SidePanel.OpenLinkCommand}" CommandParameter="mailto:oliver@kfs.org"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="github.com/kfsone/mucka" TextColor="#58a6ff" FontSize="11"
                           TextDecorations="Underline" Margin="0,2,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SidePanel.OpenLinkCommand}" CommandParameter="https://github.com/kfsone/mucka"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="Releases" TextColor="#58a6ff" FontSize="11"
                           TextDecorations="Underline" Margin="0,2,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SidePanel.OpenLinkCommand}" CommandParameter="https://github.com/kfsone/mucka/releases"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <BoxView Color="#2d333b" HeightRequest="1" Margin="0,8"/>

                    <Label FontSize="11">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Heavily inspired by " TextColor="#888888"/>
                                <Span Text="Clio" TextColor="#58a6ff" TextDecorations="Underline"/>
                            </FormattedString>
                        </Label.FormattedText>
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SidePanel.OpenLinkCommand}" CommandParameter="https://sourceforge.net/projects/clio-mud2/"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="Clio © Ian Peattie" TextColor="#888888" FontSize="11"/>

                    <BoxView Color="#2d333b" HeightRequest="1" Margin="0,8"/>

                    <Label Text="Tips" TextColor="White" FontSize="11" FontAttributes="Bold"/>

                    <Label FontSize="11" Margin="0,2,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Ctrl-D" TextColor="#58a6ff"/>
                                <Span Text="  Speak the current dreamword" TextColor="#888888"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label FontSize="11">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Ctrl-Shift-D" TextColor="#58a6ff"/>
                                <Span Text="  Speak the dreamword, then run your typed command (or sleep if the box is empty)" TextColor="#888888"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label FontSize="11">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Ctrl-F" TextColor="#58a6ff"/>
                                <Span Text="  Flee" TextColor="#888888"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label FontSize="11">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Ctrl-Shift-F" TextColor="#58a6ff"/>
                                <Span Text="  Flee in the typed direction" TextColor="#888888"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label FontSize="11">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Ctrl-L" TextColor="#58a6ff"/>
                                <Span Text="  Clear the screen" TextColor="#888888"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label FontSize="11">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Ctrl-`" TextColor="#58a6ff"/>
                                <Span Text="  Save a screenshot of the window" TextColor="#888888"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label FontSize="11">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="F1-F12" TextColor="#58a6ff"/>
                                <Span Text="  Macro slots (with Shift / Ctrl for 13-36)" TextColor="#888888"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label FontSize="11">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="PgUp / PgDn" TextColor="#58a6ff"/>
                                <Span Text="  Scroll back through history" TextColor="#888888"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label FontSize="11" IsVisible="{OnPlatform WinUI=true, Default=false}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="$help" TextColor="#58a6ff"/>
                                <Span Text="  List the client commands ($fkeys, $f&lt;n&gt;, ...)" TextColor="#888888"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label FontSize="11" IsVisible="{OnPlatform WinUI=true, Default=false}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="$name=command" TextColor="#58a6ff"/>
                                <Span Text="  Define a command until you exit the gameworld" TextColor="#888888"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label FontSize="11" IsVisible="{OnPlatform WinUI=true, Default=false}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="^1 / ^2 / ^3 / ^4 / ^5" TextColor="#58a6ff"/>
                                <Span Text="  Bind commands to Ctrl-1..Ctrl-5" TextColor="#888888"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <BoxView Color="#2d333b" HeightRequest="1" Margin="0,8"/>

                    <Label Text="WORK IN PROGRESS" TextColor="#e3b341" FontSize="11" FontAttributes="Bold"/>

                </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- ── Overflow menu overlay — dark themed dropdown, no scrim ── -->
        <!-- Spans all rows so any tap outside the popup (including near ☰) dismisses it. -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              x:Name="OverflowMenuOverlay"
              IsVisible="False"
              BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverflowMenuDismiss"/>
            </Grid.GestureRecognizers>

            <!-- Popup anchored top-left, just below the status bar (~46dp) -->
            <Border BackgroundColor="#1c2128"
                    Stroke="#444c56" StrokeThickness="1"
                    HorizontalOptions="Start" VerticalOptions="Start"
                    Margin="6,46,0,0"
                    MinimumWidthRequest="170">
                <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="0">
                    <!-- Side Panel / Onlines / Compass are live-state toggles: the ✓ tracks the
                         current visibility, and tapping flips it without touching saved settings.
                         Bound straight to the toggle commands so the overlay stays open and the ✓
                         updates in place — handy on phones where the tiny windlet buttons are fiddly. -->
                    <Border Padding="16,14" BackgroundColor="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SidePanel.TogglePanelCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="24,*">
                            <Label Grid.Column="0" Text="&#x2713;" TextColor="#3fb950" FontSize="14"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding SidePanel.IsPanelExpanded}"/>
                            <Label Grid.Column="1" Text="Side Panel" TextColor="White" FontSize="14"/>
                        </Grid>
                    </Border>
                    <BoxView Color="#2d333b" HeightRequest="1"/>
                    <Border Padding="16,14" BackgroundColor="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SidePanel.ToggleOnlinePinnedCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="24,*">
                            <Label Grid.Column="0" Text="&#x2713;" TextColor="#3fb950" FontSize="14"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding SidePanel.IsFloatingOnlineVisible}"/>
                            <Label Grid.Column="1" Text="Onlines" TextColor="White" FontSize="14"/>
                        </Grid>
                    </Border>
                    <BoxView Color="#2d333b" HeightRequest="1"/>
                    <Border Padding="16,14" BackgroundColor="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SidePanel.ToggleMapPinnedCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="24,*">
                            <Label Grid.Column="0" Text="&#x2713;" TextColor="#3fb950" FontSize="14"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding SidePanel.IsFloatingMapVisible}"/>
                            <Label Grid.Column="1" Text="Compass" TextColor="White" FontSize="14"/>
                        </Grid>
                    </Border>
                    <BoxView Color="#2d333b" HeightRequest="1"/>
                    <Border Padding="16,14" BackgroundColor="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOverflowSettings"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="24,*">
                            <Label Grid.Column="1" Text="Settings" TextColor="White" FontSize="14"/>
                        </Grid>
                    </Border>

                    <!-- Orientation sub-menu (Android only — desktop windows aren't rotated).
                         Tapping the header expands the three choices in place; a ✓ marks the active
                         one. Session-only (does not touch saved settings). -->
                    <BoxView Color="#2d333b" HeightRequest="1"
                             IsVisible="{OnPlatform Default=false, Android=true}"/>
                    <Border Padding="16,14" BackgroundColor="Transparent"
                            IsVisible="{OnPlatform Default=false, Android=true}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOverflowOrientationTapped"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="24,*,Auto">
                            <Label Grid.Column="1" Text="Orientation" TextColor="White" FontSize="14"/>
                            <Label x:Name="OrientationChevron" Grid.Column="2" Text="&#x25b8;"
                                   TextColor="#888888" FontSize="12" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                    <VerticalStackLayout x:Name="OrientationSubmenu" IsVisible="False" Spacing="0"
                                         BackgroundColor="#161c22">
                        <Border Padding="16,12,16,12" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOrientationSystem"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="34,*">
                                <Label x:Name="OrientCheckSystem" Grid.Column="0" Text="&#x2713;"
                                       TextColor="#3fb950" FontSize="13" VerticalOptions="Center"
                                       Margin="10,0,0,0" IsVisible="True"/>
                                <Label Grid.Column="1" Text="System" TextColor="#d0d0d0" FontSize="13"/>
                            </Grid>
                        </Border>
                        <BoxView Color="#2d333b" HeightRequest="1"/>
                        <Border Padding="16,12,16,12" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOrientationPortrait"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="34,*">
                                <Label x:Name="OrientCheckPortrait" Grid.Column="0" Text="&#x2713;"
                                       TextColor="#3fb950" FontSize="13" VerticalOptions="Center"
                                       Margin="10,0,0,0" IsVisible="False"/>
                                <Label Grid.Column="1" Text="Portrait" TextColor="#d0d0d0" FontSize="13"/>
                            </Grid>
                        </Border>
                        <BoxView Color="#2d333b" HeightRequest="1"/>
                        <Border Padding="16,12,16,12" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOrientationLandscape"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="34,*">
                                <Label x:Name="OrientCheckLandscape" Grid.Column="0" Text="&#x2713;"
                                       TextColor="#3fb950" FontSize="13" VerticalOptions="Center"
                                       Margin="10,0,0,0" IsVisible="False"/>
                                <Label Grid.Column="1" Text="Landscape" TextColor="#d0d0d0" FontSize="13"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                    <BoxView Color="#2d333b" HeightRequest="1"/>
                    <Border Padding="16,14" BackgroundColor="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOverflowAbout"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="24,*">
                            <Label Grid.Column="1" Text="About" TextColor="White" FontSize="14"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
