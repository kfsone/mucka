<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mucka.ViewModels"
             xmlns:render="clr-namespace:Mucka.Rendering"
             x:Class="Mucka.Pages.GuidedLoginPage"
             x:DataType="vm:GuidedLoginViewModel"
             Title="Persona Login"
             BackgroundColor="#0C0C0C"
             SafeAreaEdges="All">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="24">
        <!-- Why the player is here. Set once from the drop that opened this overlay and left alone
             for its whole life, so it is still on screen whichever way the overlay ends. -->
        <Label Grid.Row="0"
               Text="{Binding DropHeadline}"
               TextColor="{Binding DropHeadlineColor}"
               IsVisible="{Binding HasDropContext}"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,0,0,12"/>

        <!-- The server's own last words, rendered through the same TerminalView the game screen
             uses so the ANSI colours survive. Hidden for a reset, which needs no explaining. -->
        <render:TerminalView Grid.Row="1"
                             x:Name="DropTail"
                             IsVisible="{Binding HasDropTail}"
                             InputTransparent="True"
                             BackgroundColor="#0C0C0C"
                             HorizontalOptions="Fill"
                             HeightRequest="250"
                             Margin="0,0,0,12"/>

        <Grid Grid.Row="2">
            <!-- Splash/banner rendered via the same TerminalView the game screen uses (real ANSI
                 colours, same font/wrap), as a large backdrop behind the status text and any
                 persona-choice action sheet shown on top of this page. -->
            <render:TerminalView x:Name="Terminal"
                                 IsVisible="{Binding HasSplash}"
                                 InputTransparent="True"
                                 BackgroundColor="#0C0C0C"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Start"
                                 HeightRequest="340"/>

            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
                <ActivityIndicator IsRunning="True" Color="#1f6feb" HorizontalOptions="Center"/>
                <Label Text="{Binding Status}"
                       TextColor="#cccccc"
                       FontSize="16"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

        <Button Grid.Row="3"
                Text="Cancel"
                Command="{Binding CancelCommand}"
                BackgroundColor="#2d333b"
                TextColor="#cccccc"
                CornerRadius="6"
                HeightRequest="48"
                Margin="0,16,0,0"/>
    </Grid>
</ContentPage>
