<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mucka.Pages.PasswordPage"
             Title="Password Required"
             BackgroundColor="#0C0C0C">
    <Grid RowDefinitions="*,Auto" Padding="24">
        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Spacing="12">

            <Label x:Name="TitleLabel"
                   TextColor="White"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,8"/>

            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="8">

                <Label Grid.Row="0" Grid.Column="0" Text="Host......:" TextColor="#888888" VerticalOptions="Center"/>
                <Label Grid.Row="0" Grid.Column="1" x:Name="HostLabel"  TextColor="#cccccc" VerticalOptions="Center"/>

                <Label Grid.Row="1" Grid.Column="0" Text="Account...:" TextColor="#888888" VerticalOptions="Center"/>
                <Label Grid.Row="1" Grid.Column="1" x:Name="AccountLabel" TextColor="#cccccc" VerticalOptions="Center"/>

                <Label Grid.Row="2" Grid.Column="0" Text="Password..:" TextColor="#888888" VerticalOptions="Center"/>
                <Entry Grid.Row="2" Grid.Column="1"
                       x:Name="PasswordEntry"
                       IsPassword="True"
                       TextColor="White"
                       BackgroundColor="#161b22"
                       ReturnType="Done"
                       Completed="OnPasswordCompleted"/>

                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                      ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <CheckBox Grid.Column="0" x:Name="RememberCheck" Color="#1f6feb"/>
                    <Label Grid.Column="1" Text="Remember Password" TextColor="#cccccc" VerticalOptions="Center"/>
                </Grid>
            </Grid>
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">
            <Button Grid.Column="0"
                    Text="Never Mind"
                    Clicked="OnNeverMind"
                    BackgroundColor="#2d333b" TextColor="#cccccc"
                    CornerRadius="6" HeightRequest="48"/>
            <Button Grid.Column="1"
                    x:Name="ConnectBtn"
                    Text="Connect"
                    Clicked="OnConnect"
                    BackgroundColor="#1f6feb" TextColor="White"
                    CornerRadius="6" HeightRequest="48"/>
        </Grid>
    </Grid>
</ContentPage>
