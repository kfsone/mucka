<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mucka.ViewModels"
             xmlns:core="clr-namespace:Mucka.Core"
             x:Class="Mucka.Pages.ProfileEditView"
             x:DataType="vm:ConnectViewModel">

    <!-- The profile editor: one scrolling column of grouped cards. A profile holds the server and the
         login only; everything else is in Settings. Every card is always laid out,
         and a choice that does not apply dims its fields instead of hiding them, so switching
         profile (or login kind) never moves anything. Shown beside the list on a wide window and on
         its own sheet on a narrow one. WinUI values: docs/font-setup-design.md, "The profile page on
         Windows". These styles replace the app's own (Resources/Styles), so each sets its font size
         itself, or it would not follow the UI font step. -->
    <ContentView.Resources>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="BackgroundColor" Value="#0d1117" />
            <Setter Property="PlaceholderColor" Value="#444444" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="{core:ScaledFont 14}" />
            <Setter Property="HeightRequest" Value="{OnPlatform Default=44, WinUI=-1}" />
            <Setter Property="MinimumHeightRequest" Value="{OnPlatform Default=44, WinUI=32}" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#8b949e" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="{core:ScaledFont 12}" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#888888" />
            <Setter Property="FontSize" Value="{core:ScaledFont 12}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#161b22" />
            <Setter Property="Stroke" Value="#30363d" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="{OnPlatform Default=14, WinUI=10}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        </Style>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#1a1a1a" />
            <Setter Property="TextColor" Value="#58a6ff" />
            <Setter Property="BorderColor" Value="#333333" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="{core:ScaledFont 14}" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
    </ContentView.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="14" MaximumWidthRequest="560">

            <!-- Header: Cancel (sheet only), title, Save -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button x:Name="CloseButton"
                        Grid.Column="0"
                        Text="Cancel"
                        IsVisible="{Binding IsNewProfile}"
                        Style="{StaticResource Ghost}"
                        HeightRequest="{OnPlatform Default=40, WinUI=-1}"
                        MinimumHeightRequest="{OnPlatform Default=0, WinUI=32}"
                        Clicked="OnCloseClicked" />
                <Label Grid.Column="1"
                       Text="{Binding EditTitle}"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="{core:ScaledFont 18}"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       Margin="4,0" />
                <Button Grid.Column="2"
                        Text="{Binding SaveButtonText}"
                        Command="{Binding SaveProfileCommand}"
                        IsEnabled="{Binding CanConnect}"
                        BackgroundColor="#1f6feb"
                        TextColor="White"
                        CornerRadius="6"
                        HeightRequest="{OnPlatform Default=40, WinUI=-1}"
                        MinimumHeightRequest="{OnPlatform Default=44, WinUI=32}"
                        Padding="22,0" />
            </Grid>

            <!-- Profile name -->
            <Label Text="PROFILE" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <Grid HeightRequest="{OnPlatform Default=44, WinUI=-1}">
                    <Entry Text="{Binding ProfileName}"
                           IsVisible="{Binding IsNewProfile}"
                           Placeholder="profile name"
                           Keyboard="Plain"
                           IsTextPredictionEnabled="False"
                           IsSpellCheckEnabled="False"
                           SemanticProperties.Description="Profile name"
                           ReturnType="Next" />
                    <Grid IsVisible="{Binding IsExistingProfile}"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="{Binding ProfileName}"
                               TextColor="White"
                               FontSize="{core:ScaledFont 17}"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Rename"
                                Command="{Binding RenameProfileCommand}"
                                IsEnabled="{Binding CanConnect}"
                                MinimumHeightRequest="{OnPlatform Default=0, WinUI=32}"
                                Style="{StaticResource Ghost}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Server and transport -->
            <Label Text="SERVER" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <!-- The address, and how to connect: Secure (SSH), Oldschool (Telnet) or a port number -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="0" Text="Address" Style="{StaticResource FieldLabel}" />
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                            <Label Text="Connection" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                            <Label Text="&#x24D8;"
                                   TextColor="#1f6feb"
                                   FontSize="{core:ScaledFont 14}"
                                   VerticalOptions="Center"
                                   SemanticProperties.Description="About the connection">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowConnectionHelpCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                        <Entry Grid.Row="1" Grid.Column="0"
                               Text="{Binding Host}"
                               Placeholder="mudii.co.uk"
                               Keyboard="Url"
                               SemanticProperties.Description="Server address"
                               ReturnType="Next" />
                        <Button Grid.Row="1" Grid.Column="1"
                                Text="{Binding ConnectionLabel, StringFormat='{0}  &#x25BE;'}"
                                Style="{StaticResource Ghost}"
                                TextColor="White"
                                BackgroundColor="#0d1117"
                                HeightRequest="{OnPlatform Default=44, WinUI=-1}"
                                MinimumHeightRequest="{OnPlatform Default=0, WinUI=32}"
                                MinimumWidthRequest="{OnPlatform Default=112, WinUI=88}"
                                Clicked="OnConnectionClicked"
                                SemanticProperties.Description="Connection" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Login: an account id turns the automatic login on; blank, the player logs in by hand -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="LOGIN" Style="{StaticResource SectionLabel}" VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="&#x24D8;"
                       TextColor="#1f6feb"
                       FontSize="{core:ScaledFont 18}"
                       Padding="12,0"
                       SemanticProperties.Description="About logging in">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowTelnetHelpCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Mucka will log your account in automatically if you fill these in. Leave them blank if you're oldskool."
                           TextColor="#8b949e"
                           FontSize="{core:ScaledFont 12}" />
                    <Label Text="This is a guest profile: it looks around without an account."
                           IsVisible="{Binding IsGuestLogin}"
                           TextColor="#58a6ff"
                           FontSize="{core:ScaledFont 12}" />

                    <Label Text="MUD account ID" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
                    <Entry Text="{Binding AccountId}"
                           Placeholder="{Binding AccountPlaceholder}"
                           Keyboard="Plain"
                           SemanticProperties.Description="MUD account ID"
                           ReturnType="Next" />

                    <Label Text="Password (optional)" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
                    <Entry Text="{Binding Password}"
                           IsEnabled="{Binding TelnetLoginEnabled}"
                           Opacity="{Binding LoginFieldsOpacity}"
                           IsPassword="True"
                           PlaceholderColor="{Binding PasswordPlaceholderColor}"
                           Placeholder="{Binding PasswordPlaceholder}"
                           SemanticProperties.Description="Password (optional)"
                           ReturnType="Next" />

                    <Label Text="Persona (optional)" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="6"
                          Opacity="{Binding LoginFieldsOpacity}">
                        <Entry Grid.Column="0"
                               Text="{Binding GuidedLoginPersona}"
                               IsEnabled="{Binding PersonaNameEnabled}"
                               Placeholder="blank: choose when I connect"
                               Keyboard="Plain"
                               SemanticProperties.Description="Persona (optional)"
                               ReturnType="Done" />
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding PersonaManual}"
                                  IsEnabled="{Binding TelnetLoginEnabled}"
                                  Color="#1f6feb"
                                  VerticalOptions="Center"
                                  SemanticProperties.Description="Manual: choose my persona myself" />
                        <Label Grid.Column="2"
                               Text="Manual"
                               TextColor="#aaaaaa"
                               VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Advanced -->
            <Button Text="{Binding AdvancedChevron}"
                    Command="{Binding ToggleAdvancedCommand}"
                    Style="{StaticResource Ghost}"
                    TextColor="#8b949e"
                    HeightRequest="{OnPlatform Default=40, WinUI=-1}"
                    MinimumHeightRequest="{OnPlatform Default=0, WinUI=32}"
                    HorizontalOptions="Fill" />
            <Border Style="{StaticResource Card}" IsVisible="{Binding AdvancedVisible}">
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="Server login name" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                            <Label Text="&#x24D8;"
                                   TextColor="#1f6feb"
                                   FontSize="{core:ScaledFont 14}"
                                   VerticalOptions="Center"
                                   SemanticProperties.Description="About the server login name">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowLoginNameHelpCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                        <Entry Text="{Binding TelnetLoginName}"
                               Placeholder="mud"
                               Keyboard="Plain"
                               SemanticProperties.Description="Server login name"
                               ReturnType="Done" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusText}"
                   TextColor="#f85149"
                   IsVisible="{Binding HasError}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
