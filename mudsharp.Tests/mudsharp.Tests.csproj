<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Matches Mucka.csproj: the linked Core files below own the combat database. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\mudsharp\mudsharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by tools/combat/gen_npc_group_fixture.py; pins the C# NpcGroups port to the
         Python implementation the offline pipeline uses. See NpcGroupsTests. -->
    <None Include="..\tools\combat\npc_group_fixture.txt" Link="Fixtures\Data\npc_group_fixture.txt"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Core\SessionCommandAliases.cs" Link="Core\SessionCommandAliases.cs" />
    <Compile Include="..\Core\GuidedLogin\ShellText.cs" Link="Core\GuidedLogin\ShellText.cs" />
    <Compile Include="..\Core\GuidedLogin\SessionDropContext.cs" Link="Core\GuidedLogin\SessionDropContext.cs" />
    <Compile Include="..\ViewModels\CombatStatsAggregator.cs" Link="ViewModels\CombatStatsAggregator.cs" />
    <Compile Include="..\ViewModels\CombatContracts.cs" Link="ViewModels\CombatContracts.cs" />
    <Compile Include="..\ViewModels\CombatComposition.cs" Link="ViewModels\CombatComposition.cs" />
    <Compile Include="..\ViewModels\ClogRenderGate.cs" Link="ViewModels\ClogRenderGate.cs" />
    <Compile Include="..\ViewModels\CombatHistoryCache.cs" Link="ViewModels\CombatHistoryCache.cs" />
    <Compile Include="..\Core\FightHistoryStore.cs" Link="Core\FightHistoryStore.cs" />
    <Compile Include="..\Core\FightHistoryRecorder.cs" Link="Core\FightHistoryRecorder.cs" />
    <Compile Include="..\Core\SwingLedger.cs" Link="Core\SwingLedger.cs" />
    <Compile Include="..\Core\SwingRow.cs" Link="Core\SwingRow.cs" />
    <Compile Include="..\Core\CombatDb.cs" Link="Core\CombatDb.cs" />
    <Compile Include="..\Core\CombatTiming.cs" Link="Core\CombatTiming.cs" />
  </ItemGroup>

</Project>
