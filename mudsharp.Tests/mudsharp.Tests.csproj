<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\mudsharp\mudsharp.csproj" />
    <ProjectReference Include="..\Mucka.Input\Mucka.Input.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Instance-name to species-group pairs that pin NpcGroups.Normalize. See NpcGroupsTests. -->
    <None Include="Fixtures\Data\npc_group_fixture.txt" Link="Fixtures\Data\npc_group_fixture.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The poisoned-wyvern death, as six verbatim wire frames cut out of the owner's 2026-08-26
         session - see WyvernPoisonDeathReplayTests for what was kept and what was thrown away. It
         is committed and
         has no Exists() condition on purpose: this replays protocol facts that no transcript can
         carry, and the previous arrangement - gitignored file, test skipping when absent - meant a
         fresh clone ran three tests that silently proved nothing. Mucka.Util.Tests links the same
         file for WireLogTests. -->
    <None Include="Fixtures\Data\wyvern-poison-death.c1" Link="Fixtures\Data\wyvern-poison-death.c1"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\Data\invisible-player-joins.c1" Link="Fixtures\Data\invisible-player-joins.c1"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\Data\blind-vs-water-snake.c1" Link="Fixtures\Data\blind-vs-water-snake.c1"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
